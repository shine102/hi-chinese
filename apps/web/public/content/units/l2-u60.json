{"unit":{"id":"l2-u60","level":2,"order":102,"title":"Thời Gian & Tần Suất 4","wordIds":["w:早晨","w:小时候","w:周年","w:今后","w:这时","w:刻","w:半夜","w:等到","w:忽然","w:假期","w:从小","w:快要"],"grammarIds":["g:congxiao-since-childhood","g:huran-suddenly","g:kuaiyao-le-soon"],"sentenceIds":["s:l2:277","s:l2:278","s:l2:279","s:l2:280","s:l2:282","s:l2:283","s:l2:284","s:l2:289","s:l2:290","s:l2:291","s:l2:292","s:l2:fill:104","s:l2:fill:105"]},"grammar":[{"id":"g:congxiao-since-childhood","title":"Từ thuở nhỏ với 从小","pattern":"从小 + clause","explanation":"从小 (cóngxiǎo) nghĩa là \"từ nhỏ, từ khi còn bé\" — miêu tả điều gì đó đúng từ những năm đầu đời của một người.","level":2,"sentenceIds":["s:l2:281","s:l2:282","s:l2:283","s:l2:284"],"unitId":"l2-u60"},{"id":"g:huran-suddenly","title":"Sự việc bất ngờ với 忽然","pattern":"忽然 + verb phrase","explanation":"忽然 (hūrán) nghĩa là \"bỗng nhiên\" — miêu tả điều gì đó xảy ra đột ngột và bất ngờ, gần giống 突然.","level":2,"sentenceIds":["s:l2:277","s:l2:278","s:l2:279","s:l2:280"],"unitId":"l2-u60"},{"id":"g:kuaiyao-le-soon","title":"Sắp xảy ra: 快要...了","pattern":"快要 + verb + 了","explanation":"快要...了 (kuàiyào...le) nghĩa là \"sắp, gần đến lúc\" — rất giống 就要...了, thường dùng cho những thay đổi tự nhiên như thời tiết hay thời gian trôi qua.","level":2,"sentenceIds":["s:l2:289","s:l2:290","s:l2:291","s:l2:292"],"unitId":"l2-u60"}],"sentences":[{"id":"s:l2:277","zh":"他忽然站起来了。","pinyin":"Tā hūrán zhàn qǐlái le.","vi":"Anh ấy bỗng nhiên đứng dậy.","wordIds":["w:他","w:忽然","w:站","w:起来","w:了"],"unitId":"l2-u60"},{"id":"s:l2:278","zh":"忽然下雨了。","pinyin":"Hūrán xiàyǔ le.","vi":"Bỗng nhiên trời đổ mưa.","wordIds":["w:忽然","w:下雨","w:了"],"unitId":"l2-u60"},{"id":"s:l2:279","zh":"我忽然想起了那件事。","pinyin":"Wǒ hūrán xiǎngqǐ le nà jiàn shì.","vi":"Tôi bỗng nhiên nhớ ra việc đó.","wordIds":["w:我","w:忽然","w:想起","w:了","w:那","w:件","w:事"],"unitId":"l2-u60"},{"id":"s:l2:280","zh":"她忽然笑了。","pinyin":"Tā hūrán xiào le.","vi":"Cô ấy bỗng nhiên cười.","wordIds":["w:她","w:忽然","w:笑","w:了"],"unitId":"l2-u60"},{"id":"s:l2:282","zh":"他从小在北京长大。","pinyin":"Tā cóngxiǎo zài Běijīng zhǎngdà.","vi":"Anh ấy lớn lên ở Bắc Kinh từ nhỏ.","wordIds":["w:他","w:从小","w:在","w:北京","w:长大"],"unitId":"l2-u60"},{"id":"s:l2:283","zh":"她从小就很努力。","pinyin":"Tā cóngxiǎo jiù hěn nǔlì.","vi":"Cô ấy đã chăm chỉ từ nhỏ.","wordIds":["w:她","w:从小","w:就","w:很","w:努力"],"unitId":"l2-u60"},{"id":"s:l2:284","zh":"我从小就认识他。","pinyin":"Wǒ cóngxiǎo jiù rènshi tā.","vi":"Tôi quen anh ấy từ nhỏ.","wordIds":["w:我","w:从小","w:就","w:认识","w:他"],"unitId":"l2-u60"},{"id":"s:l2:289","zh":"飞机快要起飞了。","pinyin":"Fēijī kuàiyào qǐfēi le.","vi":"Máy bay sắp cất cánh rồi.","wordIds":["w:飞机","w:快要","w:起飞","w:了"],"unitId":"l2-u60"},{"id":"s:l2:290","zh":"天快要黑了。","pinyin":"Tiān kuàiyào hēi le.","vi":"Trời sắp tối rồi.","wordIds":["w:天","w:快要","w:黑","w:了"],"unitId":"l2-u60"},{"id":"s:l2:291","zh":"我们快要到了。","pinyin":"Wǒmen kuàiyào dào le.","vi":"Chúng tôi sắp đến rồi.","wordIds":["w:我们","w:快要","w:到","w:了"],"unitId":"l2-u60"},{"id":"s:l2:292","zh":"冬天快要来了。","pinyin":"Dōngtiān kuàiyào lái le.","vi":"Mùa đông sắp đến rồi.","wordIds":["w:冬天","w:快要","w:来","w:了"],"unitId":"l2-u60"},{"id":"s:l2:fill:104","zh":"小时候我住在北京。","pinyin":"Xiǎoshíhou wǒ zhù zài Běijīng.","vi":"Hồi nhỏ tôi sống ở Bắc Kinh.","wordIds":["w:小时候","w:我","w:住","w:在","w:北京"],"unitId":"l2-u60"},{"id":"s:l2:fill:105","zh":"他半夜才回家。","pinyin":"Tā bànyè cái huíjiā.","vi":"Nửa đêm anh ấy mới về nhà.","wordIds":["w:他","w:半夜","w:才","w:回家"],"unitId":"l2-u60"}]}
