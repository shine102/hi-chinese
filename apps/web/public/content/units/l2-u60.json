{"unit":{"id":"l2-u60","level":2,"order":102,"title":"Unit 60","wordIds":["w:晚报","w:难听","w:药水","w:中医","w:坏处","w:前年","w:词典","w:千克","w:问路","w:叫作","w:凉快","w:午睡"],"grammarIds":["g:jiaozuo-called","g:wenlu-ask-directions"],"sentenceIds":["s:l2:329","s:l2:330","s:l2:332","s:l2:373","s:l2:374","s:l2:375","s:l2:376"]},"grammar":[{"id":"g:jiaozuo-called","title":"Naming something with 叫作","pattern":"A + 叫作 + B","explanation":"叫作 (jiàozuò) means \"to be called, to be known as\" used to name or define something.","level":2,"sentenceIds":["s:l2:329","s:l2:330","s:l2:331","s:l2:332"],"unitId":"l2-u60"},{"id":"g:wenlu-ask-directions","title":"Asking for directions with 问路","pattern":"(主语) + 问路","explanation":"问路 (wènlù) means \"to ask for directions\" a common verb+object combination for travelers.","level":2,"sentenceIds":["s:l2:373","s:l2:374","s:l2:375","s:l2:376"],"unitId":"l2-u60"}],"sentences":[{"id":"s:l2:329","zh":"这个叫作汉字。","pinyin":"Zhège jiàozuò Hànzì.","en":"This is called a Chinese character.","wordIds":["w:这","w:个","w:叫作","w:汉字"],"unitId":"l2-u60"},{"id":"s:l2:330","zh":"这个方法叫作什么？","pinyin":"Zhège fāngfǎ jiàozuò shénme?","en":"What is this method called?","wordIds":["w:这","w:个","w:方法","w:叫作","w:什么"],"unitId":"l2-u60"},{"id":"s:l2:332","zh":"这个地方叫作北京。","pinyin":"Zhège dìfang jiàozuò Běijīng.","en":"This place is called Beijing.","wordIds":["w:这","w:个","w:地方","w:叫作","w:北京"],"unitId":"l2-u60"},{"id":"s:l2:373","zh":"我在路上问路。","pinyin":"Wǒ zài lùshang wènlù.","en":"I asked for directions on the way.","wordIds":["w:我","w:在","w:路上","w:问路"],"unitId":"l2-u60"},{"id":"s:l2:374","zh":"他向一个人问路。","pinyin":"Tā xiàng yí gè rén wènlù.","en":"He asked someone for directions.","wordIds":["w:他","w:向","w:一","w:个","w:人","w:问路"],"unitId":"l2-u60"},{"id":"s:l2:375","zh":"你可以去问路。","pinyin":"Nǐ kěyǐ qù wènlù.","en":"You can go ask for directions.","wordIds":["w:你","w:可以","w:去","w:问路"],"unitId":"l2-u60"},{"id":"s:l2:376","zh":"我们不知道路，只能问路。","pinyin":"Wǒmen bù zhīdào lù, zhǐnéng wènlù.","en":"