{"unit":{"id":"l1-u33","level":1,"order":33,"title":"Weather & Nature","wordIds":["w:天气","w:下雨","w:雨","w:风","w:山","w:树","w:地上","w:路上","w:车上","w:门票","w:地图","w:有名"],"grammarIds":["g:weather-desc"],"sentenceIds":["s:l1:new:080","s:l1:new:081","s:l1:new:082","s:l1:new:083","s:l1:new:084","s:l1:new:085"]},"grammar":[{"id":"g:weather-desc","title":"Describing weather with 天气","pattern":"天气 + adjective","explanation":"天气 (tiānqì) means 'weather'. Describe it directly: 天气好 (The weather is good), 天气冷 (The weather is cold).","level":1,"sentenceIds":["s:l1:new:080","s:l1:new:081"],"unitId":"l1-u33"}],"sentences":[{"id":"s:l1:new:080","zh":"天气好。","pinyin":"Tiānqì hǎo.","en":"The weather is good.","wordIds":["w:天气","w:好"],"unitId":"l1-u33"},{"id":"s:l1:new:081","zh":"天气冷。","pinyin":"Tiānqì lěng.","en":"The weather is cold.","wordIds":["w:天气","w:冷"],"unitId":"l1-u33"},{"id":"s:l1:new:082","zh":"下雨。","pinyin":"Xià yǔ.","en":"It's raining.","wordIds":["w:下雨"],"unitId":"l1-u33"},{"id":"s:l1:new:083","zh":"山大。","pinyin":"Shān dà.","en":"The mountain is big.","wordIds":["w:山","w:大"],"unitId":"l1-u33"},{"id":"s:l1:new:084","zh":"风大。","pinyin":"Fēng dà.","en":"The wind is strong.","wordIds":["w:风","w:大"],"unitId":"l1-u33"},{"id":"s:l1:new:085","zh":"这个地方有名。","pinyin":"Zhège dìfang yǒumíng.","en":"This place is famous.","wordIds":["w:这","w:地方","w:有名"],"unitId":"l1-u33"}]}
