{"unit":{"id":"l1-u14","level":1,"order":14,"title":"Unit 14","wordIds":["w:路","w:男人","w:正在","w:门","w:喝","w:穿","w:学校","w:花","w:坐","w:早","w:们","w:身上"],"grammarIds":["g:men-plural-suffix","g:zhengzai-progressive"],"sentenceIds":["s:l1:085","s:l1:086","s:l1:087","s:l1:088","s:l1:089","s:l1:090","s:l1:091"]},"grammar":[{"id":"g:men-plural-suffix","title":"们 as a plural suffix","pattern":"person noun + 们","explanation":"们 (men) attaches to a noun referring to people to make it plural: 孩子们 (\"children\"), 朋友们 (\"friends\"). It's already built into 我们, 你们, and 他们, but can attach to other people-nouns the same way.","level":1,"sentenceIds":["s:l1:089","s:l1:090","s:l1:091"],"unitId":"l1-u14"},{"id":"g:zhengzai-progressive","title":"正在 for actions in progress","pattern":"正在 + verb","explanation":"正在 (zhèngzài) marks an action happening right now, like English \"-ing\". Put it directly before the verb: 我正在看 (\"I'm looking right now\"). It's often shortened to just 正 or just 在 in casual speech, but 正在 is the clearest form for beginners.","level":1,"sentenceIds":["s:l1:085","s:l1:086","s:l1:087","s:l1:088"],"unitId":"l1-u14"}],"sentences":[{"id":"s:l1:085","zh":"我正在看。","pinyin":"Wǒ zhèngzài kàn.","en":"I'm looking right now.","wordIds":["w:我","w:正在","w:看"],"unitId":"l1-u14"},{"id":"s:l1:086","zh":"他正在喝水。","pinyin":"Tā zhèngzài hē shuǐ.","en":"He's drinking water.","wordIds":["w:他","w:正在","w:喝","w:水"],"unitId":"l1-u14"},{"id":"s:l1:087","zh":"你正在做什么？","pinyin":"Nǐ zhèngzài zuò shénme?","en":"What are you doing right now?","wordIds":["w:你","w:正在","w:做","w:什么"],"unitId":"l1-u14"},{"id":"s:l1:088","zh":"她正在说。","pinyin":"Tā zhèngzài shuō.","en":"She's speaking right now.","wordIds":["w:她","w:正在","w:说"],"unitId":"l1-u14"},{"id":"s:l1:089","zh":"孩子们很好。","pinyin":"Háizimen hěn hǎo.","en":"The children are doing well.","wordIds":["w:孩子","w:们","w:很","w:好"],"unitId":"l1-u14"},{"id":"s:l1:090","zh":"朋友们都来了。","pinyin":"Péngyoumen dōu lái le.","en":"The friends all came.","wordIds":["w:朋友","w:们","w:都","w:来","w:了"],"unitId":"l1-u14"},{"id":"s:l1:091","zh":"我们帮孩子们。","pinyin":"Wǒmen bāng háizimen.","en":"We help the children.","wordIds":["w:我们","w:帮","w:孩子","w:们"],"unitId":"l1-u14"}]}
