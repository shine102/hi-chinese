{"unit":{"id":"l2-u37","level":2,"order":79,"title":"Unit 37","wordIds":["w:放心","w:草","w:湖","w:正好","w:院","w:安静","w:道理","w:公里","w:好处","w:旅游","w:作业","w:家长"],"grammarIds":["g:fangxin-rest-assured"],"sentenceIds":["s:l2:221","s:l2:222","s:l2:223","s:l2:224"]},"grammar":[{"id":"g:fangxin-rest-assured","title":"Feeling at ease with 放心","pattern":"你放心, ... / 对...放心","explanation":"放心 (fàngxīn) means \"to feel at ease, to not worry\". 你放心 is a common way to reassure someone; 对...放心 means \"to feel at ease about something\".","level":2,"sentenceIds":["s:l2:221","s:l2:222","s:l2:223","s:l2:224"],"unitId":"l2-u37"}],"sentences":[{"id":"s:l2:221","zh":"你放心，没问题。","pinyin":"Nǐ fàngxīn, méi wèntí.","en":"Don't worry, no problem.","wordIds":["w:你","w:放心","w:没","w:问题"],"unitId":"l2-u37"},{"id":"s:l2:222","zh":"妈妈对我很放心。","pinyin":"Māma duì wǒ hěn fàngxīn.","en":"Mom feels at ease about me.","wordIds":["w:妈妈","w:对","w:我","w:很","w:放心"],"unitId":"l2-u37"},{"id":"s:l2:223","zh":"请大家放心。","pinyin":"Qǐng dàjiā fàngxīn.","en":"Please everyone, don't worry.","wordIds":["w:请","w:大家","w:放心"],"unitId":"l2-u37"},{"id":"s:l2:224","zh":"我不放心他一个人去。","pinyin":"Wǒ bú fàngxīn tā yí gè rén qù.","en":"I'm not at ease with him going alone.","wordIds":["w:我","w:不","w:放心","w:他","w:一","w:个","w:人","w:去"],"unitId":"l2-u37"}]}
