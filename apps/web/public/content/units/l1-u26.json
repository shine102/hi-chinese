{"unit":{"id":"l1-u26","level":1,"order":26,"title":"Phương Tiện Đi Lại","wordIds":["w:车","w:开车","w:飞","w:飞机","w:火车","w:汽车","w:打车","w:上车","w:下车","w:车站","w:车上","w:票","w:车票"],"grammarIds":["g:kaihui-vo"],"sentenceIds":["s:l1:156","s:l1:178","s:l1:226","s:l1:core:049","s:l3:241"]},"grammar":[{"id":"g:kaihui-vo","title":"开 kết hợp với các tân ngữ khác nhau","pattern":"开 + object (会/车/玩笑)","explanation":"开 (kāi) thay đổi nghĩa tùy vào từ đứng sau nó: 开会 (\"họp\"), 开车 (\"lái xe\"), 开玩笑 (\"đùa giỡn\"). Mỗi cách kết hợp nên được học như một cụm từ cố định riêng, chứ không phải ghép tự do mỗi lần.","level":1,"sentenceIds":["s:l1:225","s:l1:226","s:l1:227"],"unitId":"l1-u26"}],"sentences":[{"id":"s:l1:156","zh":"我们的车在中间。","pinyin":"Wǒmen de chē zài zhōngjiān.","vi":"Xe của chúng tôi ở giữa.","wordIds":["w:我们","w:的","w:车","w:在","w:中间"],"unitId":"l1-u26"},{"id":"s:l1:178","zh":"车站在外边。","pinyin":"Chēzhàn zài wàibian.","vi":"Bến xe ở bên ngoài.","wordIds":["w:车站","w:在","w:外边"],"unitId":"l1-u26"},{"id":"s:l1:226","zh":"我不会开车。","pinyin":"Wǒ bú huì kāichē.","vi":"Tôi không biết lái xe.","wordIds":["w:我","w:不","w:会","w:开车"],"unitId":"l1-u26"},{"id":"s:l1:core:049","zh":"他不会开车。","pinyin":"Tā bú huì kāichē.","vi":"Anh ấy không biết lái xe.","wordIds":["w:他","w:不","w:会","w:开车"],"unitId":"l1-u26"},{"id":"s:l3:241","zh":"开车的那个人是我爸爸。","pinyin":"Kāichē de nàge rén shì wǒ bàba.","vi":"Người đang lái xe kia là bố tôi.","wordIds":["w:开车","w:的","w:那","w:个","w:人","w:是","w:我","w:爸爸"],"unitId":"l1-u26"}]}
