{"unit":{"id":"l1-u23","level":1,"order":23,"title":"Up & Down","wordIds":["w:上","w:下","w:中","w:前","w:后","w:左","w:右","w:东","w:西","w:南","w:北","w:间"],"grammarIds":["g:directions-basic"],"sentenceIds":["s:l1:new:060","s:l1:new:061","s:l1:new:062","s:l1:new:064"]},"grammar":[{"id":"g:directions-basic","title":"Basic direction words","pattern":"东/西/南/北 + noun","explanation":"Direction words come before what they describe: 东 (dōng, east), 西 (xī, west), 南 (nán, south), 北 (běi, north). 上 (up) and 下 (down) also indicate direction.","level":1,"sentenceIds":["s:l1:new:060","s:l1:new:061"],"unitId":"l1-u23"}],"sentences":[{"id":"s:l1:new:060","zh":"前后左右。","pinyin":"Qián hòu zuǒ yòu.","en":"Front, back, left, right.","wordIds":["w:前","w:后","w:左","w:右"],"unitId":"l1-u23"},{"id":"s:l1:new:061","zh":"东西南北。","pinyin":"Dōng xī nán běi.","en":"East, west, south, north.","wordIds":["w:东","w:西","w:南","w:北"],"unitId":"l1-u23"},{"id":"s:l1:new:062","zh":"上下左右。","pinyin":"Shàng xià zuǒ yòu.","en":"Up, down, left, right.","wordIds":["w:上","w:下","w:左","w:右"],"unitId":"l1-u23"},{"id":"s:l1:new:064","zh":"我在中。","pinyin":"Wǒ zài zhōng.","en":"I am in the middle.","wordIds":["w:我","w:在","w:中"],"unitId":"l1-u23"}]}
