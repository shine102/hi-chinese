{"unit":{"id":"l3-u46","level":3,"order":151,"title":"Unit 46","wordIds":["w:领先","w:作者","w:上升","w:声明","w:围","w:路线","w:完整","w:谈判","w:飞行","w:较","w:纪念","w:福"],"grammarIds":["g:jiao-comparative"],"sentenceIds":["s:l3:187","s:l3:188","s:l3:189"]},"grammar":[{"id":"g:jiao-comparative","title":"Formal comparison with 较","pattern":"较 + 形容词","explanation":"较 (jiào) is a formal, written way to say \"relatively, comparatively\" — similar to 比较 but shorter and more common in reports or writing. It goes right before an adjective.","level":3,"sentenceIds":["s:l3:187","s:l3:188","s:l3:189"],"unitId":"l3-u46"}],"sentences":[{"id":"s:l3:187","zh":"这个方法较简单。","pinyin":"Zhège fāngfǎ jiào jiǎndān.","en":"This method is relatively simple.","wordIds":["w:这","w:个","w:方法","w:较","w:简单"],"unitId":"l3-u46"},{"id":"s:l3:188","zh":"今年的雨较多。","pinyin":"Jīnnián de yǔ jiào duō.","en":"This year there's relatively more rain.","wordIds":["w:今年","w:的","w:雨","w:较","w:多"],"unitId":"l3-u46"},{"id":"s:l3:189","zh":"这个地区较安全。","pinyin":"Zhège dìqū jiào ānquán.","en":"This area is relatively safe.","wordIds":["w:这","w:个","w:地区","w:较","w:安全"],"unitId":"l3-u46"}]}
