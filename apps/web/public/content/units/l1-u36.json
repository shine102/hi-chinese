{"unit":{"id":"l1-u36","level":1,"order":36,"title":"Shopping","wordIds":["w:买","w:钱","w:东西","w:贵","w:元","w:块","w:商店","w:商场","w:钱包","w:毛","w:包","w:衣服"],"grammarIds":["g:chuan-clothes"],"sentenceIds":["s:l1:067","s:l1:096","s:l1:161","s:l1:163","s:l1:164","s:l1:176","s:l1:180","s:l1:186","s:l1:new:070"]},"grammar":[{"id":"g:chuan-clothes","title":"Wearing clothes with 穿","pattern":"subject + 穿 + clothing","explanation":"穿 (chuān) means 'to wear' for clothing: 他穿新衣服 (He wears new clothes). 好看 (hǎokàn, good-looking) can describe people or things.","level":1,"sentenceIds":["s:l1:new:070","s:l1:new:071"],"unitId":"l1-u36"}],"sentences":[{"id":"s:l1:067","zh":"别买这个。","pinyin":"Bié mǎi zhège.","en":"Don't buy this one.","wordIds":["w:别","w:买","w:这","w:个"],"unitId":"l1-u36"},{"id":"s:l1:096","zh":"这个多少钱？","pinyin":"Zhège duōshao qián?","en":"How much is this?","wordIds":["w:这","w:个","w:多少","w:钱"],"unitId":"l1-u36"},{"id":"s:l1:161","zh":"这个一百块。","pinyin":"Zhège yìbǎi kuài.","en":"This one is a hundred kuai.","wordIds":["w:这","w:个","w:一","w:百","w:块"],"unitId":"l1-u36"},{"id":"s:l1:163","zh":"他要三百块。","pinyin":"Tā yào sānbǎi kuài.","en":"He wants three hundred kuai.","wordIds":["w:他","w:要","w:三","w:百","w:块"],"unitId":"l1-u36"},{"id":"s:l1:164","zh":"那本书一百块。","pinyin":"Nà běn shū yìbǎi kuài.","en":"That book is a hundred kuai.","wordIds":["w:那","w:本","w:书","w:一","w:百","w:块"],"unitId":"l1-u36"},{"id":"s:l1:176","zh":"商店在右边。","pinyin":"Shāngdiàn zài yòubian.","en":"The store is on the right.","wordIds":["w:商店","w:在","w:右边"],"unitId":"l1-u36"},{"id":"s:l1:180","zh":"商店里边有水果。","pinyin":"Shāngdiàn lǐbian yǒu shuǐguǒ.","en":"There's fruit inside the store.","wordIds":["w:商店","w:里边","w:有","w:水果"],"unitId":"l1-u36"},{"id":"s:l1:186","zh":"请问，商店在哪里？","pinyin":"Qǐngwèn, shāngdiàn zài nǎlǐ?","en":"Excuse me, where's the store?","wordIds":["w:请问","w:商店","w:在","w:哪里"],"unitId":"l1-u36"},{"id":"s:l1:new:070","zh":"她穿新衣服。","pinyin":"Tā chuān xīn yīfu.","en":"She wears new clothes.","wordIds":