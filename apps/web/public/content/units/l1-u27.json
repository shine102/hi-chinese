{"unit":{"id":"l1-u27","level":1,"order":27,"title":"Exams & Class","wordIds":["w:考","w:考试","w:班","w:知识","w:课文","w:页","w:学院","w:大学生","w:小学生","w:中学生","w:教学楼","w:听写"],"grammarIds":["g:xuexiao-sheng"],"sentenceIds":["s:l1:189","s:l1:187","s:l1:188"]},"grammar":[{"id":"g:xuexiao-sheng","title":"School levels and their students","pattern":"小学/中学/大学 (+ 生)","explanation":"小学 (\"elementary school\"), 中学 (\"middle school\"), and 大学 (\"university\") each combine with 生 to name a student at that level: 小学生, 中学生, 大学生. 学生 alone is the general word for \"student\".","level":1,"sentenceIds":["s:l1:187","s:l1:188","s:l1:189","s:l1:190"],"unitId":"l1-u27"}],"sentences":[{"id":"s:l1:189","zh":"她是大学生。","pinyin":"Tā shì dàxuéshēng.","en":"She is a university student.","wordIds":["w:她","w:是","w:大学生"],"unitId":"l1-u27"},{"id":"s:l1:187","zh":"我是小学生。","pinyin":"Wǒ shì xiǎoxuéshēng.","en":"I am a primary school student.","wordIds":["w:我","w:是","w:小学生"],"unitId":"l1-u27"},{"id":"s:l1:188","zh":"他是中学生。","pinyin":"Tā shì zhōngxuéshēng.","en":"He is a middle school student.","wordIds":["w:他","w:是","w:中学生"],"unitId":"l1-u27"}]}
