{"unit":{"id":"l1-u27","level":1,"order":27,"title":"Unit 27","wordIds":["w:一半","w:家人","w:有时","w:小姐","w:对不起","w:进去","w:哥哥","w:没什么","w:路上","w:天气","w:最好","w:南"],"grammarIds":["g:duibuqi-apology","g:zuihao-suggestion"],"sentenceIds":["s:l1:145","s:l1:146","s:l1:148","s:l1:149","s:l1:150","s:l1:151","s:l1:152","s:l3:220"]},"grammar":[{"id":"g:duibuqi-apology","title":"对不起 and 没什么","pattern":"对不起 (apology) / 没什么 (it's nothing)","explanation":"对不起 (duìbuqǐ) means \"I'm sorry\" or \"excuse me\", used to apologize or get someone's attention. 没什么 (méi shénme) is a common reply meaning \"it's nothing\" or \"no big deal\".","level":1,"sentenceIds":["s:l1:145","s:l1:146","s:l1:147","s:l1:148"],"unitId":"l1-u27"},{"id":"g:zuihao-suggestion","title":"最好 for \"had better\"","pattern":"(Subject +) 最好 + verb","explanation":"最好 (zuìhǎo) softens advice into \"had better\" or \"(it's) best to\": 你最好休息 (\"You'd better rest\"). It can also open a sentence with no subject, as general advice: 最好现在走 (\"Best to leave now\").","level":1,"sentenceIds":["s:l1:149","s:l1:150","s:l1:151","s:l1:152"],"unitId":"l1-u27"}],"sentences":[{"id":"s:l1:145","zh":"对不起。","pinyin":"Duìbuqǐ.","en":"I'm sorry.","wordIds":["w:对不起"],"unitId":"l1-u27"},{"id":"s:l1:146","zh":"对不起，我没看见。","pinyin":"Duìbuqǐ, wǒ méi kànjiàn.","en":"Sorry, I didn't see it.","wordIds":["w:对不起","w:我","w:没","w:看见"],"unitId":"l1-u27"},{"id":"s:l1:148","zh":"对不起，我来晚了。","pinyin":"Duìbuqǐ, wǒ lái wǎn le.","en":"Sorry, I'm late.","wordIds":["w:对不起","w:我","w:来","w:晚","w:了"],"unitId":"l1-u27"},{"id":"s:l1:149","zh":"你最好休息。","pinyin":"Nǐ zuìhǎo xiūxi.","en":"You'd better rest.","wordIds":["w:你","w:最好","w:休息"],"unitId":"l1-u27"},{"id":"s:l1:150","zh":"我们最好去。","pinyin":"Wǒmen zuìhǎo qù.","en":"We'd better go.","wordIds":["w:我们","w:最好","w:去"],"unitId":"l1-u27"},{"id":"s:l1:151","zh":"你最好告诉他。","pinyin":"Nǐ zuìhǎo gàosu tā.","en":"You'd better tell him.","wordIds":["w:你","w:最好","w:告诉","w:他"],"unitId":"l1-u27"},{"id":"s:l1:152","zh":"最好现在走。","pinyin":"Zuìhǎo xiànzài zǒu.","en":"It's best to leave now.","wordIds":["w:最好","w:现在","w:走"],"unitId":"l1-u27"},{"id":"s:l3:220","zh":"天气冷起来了。","pinyin":"Tiānqì lěng qǐlái le.","en":"The weather started getting cold.","wordIds":["w:天气","w:冷","w:起来","w:了"],"unitId":"l1-u27"}]}
