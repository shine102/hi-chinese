{"unit":{"id":"l2-u57","level":2,"order":99,"title":"Unit 57","wordIds":["w:句子","w:筷子","w:体育场","w:组长","w:作文","w:东南","w:个子","w:难看","w:有点儿","w:地铁站","w:快餐","w:站住"],"grammarIds":["g:youdianr-a-bit"],"sentenceIds":["s:l2:317","s:l2:318","s:l2:319","s:l2:320"]},"grammar":[{"id":"g:youdianr-a-bit","title":"A slight degree with 有点儿","pattern":"有点儿 + adjective","explanation":"有点儿 (yǒudiǎnr) means \"a bit, a little\" placed before an adjective, usually to describe something mildly negative or undesirable: 有点儿贵 (a bit expensive).","level":2,"sentenceIds":["s:l2:317","s:l2:318","s:l2:319","s:l2:320"],"unitId":"l2-u57"}],"sentences":[{"id":"s:l2:317","zh":"这个有点儿贵。","pinyin":"Zhège yǒudiǎnr guì.","en":"This is a bit expensive.","wordIds":["w:这","w:个","w:有点儿","w:贵"],"unitId":"l2-u57"},{"id":"s:l2:318","zh":"我今天有点儿累。","pinyin":"Wǒ jīntiān yǒudiǎnr lèi.","en":"I'm a bit tired today.","wordIds":["w:我","w:今天","w:有点儿","w:累"],"unitId":"l2-u57"},{"id":"s:l2:319","zh":"这个字写得有点儿难看。","pinyin":"Zhège zì xiě de yǒudiǎnr nánkàn.","en":"This character is written a bit poorly.","wordIds":["w:这","w:个","w:字","w:写","w:得","w:有点儿","w:难看"],"unitId":"l2-u57"},{"id":"s:l2:320","zh":"外边有点儿冷。","pinyin":"Wàibian yǒudiǎnr lěng.","en":"It's a bit cold outside.","wordIds":["w:外边","w:有点儿","w:冷"],"unitId":"l2-u57"}]}
