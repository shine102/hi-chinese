{"unit":{"id":"l1-u06","level":1,"order":6,"title":"Food & Drink","wordIds":["w:吃","w:喝","w:水","w:茶","w:饭","w:菜","w:肉","w:鸡蛋","w:米饭","w:面包","w:水果","w:包子"],"grammarIds":["g:want-verb"],"sentenceIds":["s:l1:new:020","s:l1:new:021","s:l1:new:022","s:l1:new:023","s:l1:new:024","s:l1:new:025"]},"grammar":[{"id":"g:want-verb","title":"Saying what you want with 要","pattern":"subject + 要 + verb + object","explanation":"要 (yào) before a verb means 'want to': 我要吃饭 (I want to eat). 要 can also mean 'need' or 'will'.","level":1,"sentenceIds":["s:l1:new:020","s:l1:new:021"],"unitId":"l1-u06"}],"sentences":[{"id":"s:l1:new:020","zh":"我要吃饭。","pinyin":"Wǒ yào chī fàn.","en":"I want to eat.","wordIds":["w:我","w:要","w:吃","w:饭"],"unitId":"l1-u06"},{"id":"s:l1:new:021","zh":"你要喝水。","pinyin":"Nǐ yào hē shuǐ.","en":"You want to drink water.","wordIds":["w:你","w:要","w:喝","w:水"],"unitId":"l1-u06"},{"id":"s:l1:new:022","zh":"我要喝茶。","pinyin":"Wǒ yào hē chá.","en":"I want to drink tea.","wordIds":["w:我","w:要","w:喝","w:茶"],"unitId":"l1-u06"},{"id":"s:l1:new:023","zh":"他要吃肉。","pinyin":"Tā yào chī ròu.","en":"He wants to eat meat.","wordIds":["w:他","w:要","w:吃","w:肉"],"unitId":"l1-u06"},{"id":"s:l1:new:024","zh":"我不要吃鸡蛋。","pinyin":"Wǒ bú yào chī jīdàn.","en":"I don't want to eat eggs.","wordIds":["w:我","w:不","w:要","w:吃","w:鸡蛋"],"unitId":"l1-u06"},{"id":"s:l1:new:025","zh":"我想吃米饭。","pinyin":"Wǒ xiǎng chī mǐfàn.","en":"I'd like to eat rice.","wordIds":["w:我","w:想","w:吃","w:米饭"],"unitId":"l1-u06"}]}
