{"unit":{"id":"l1-u06","level":1,"order":6,"title":"How Many?","wordIds":["w:几","w:个","w:多","w:少","w:多少","w:百","w:岁","w:大","w:小","w:半","w:老","w:子"],"grammarIds":["g:sui-age"],"sentenceIds":["s:l1:new:008","s:l1:073","s:l1:074","s:l1:075"]},"grammar":[{"id":"g:sui-age","title":"岁 for stating age","pattern":"Subject + number + 岁","explanation":"To state age, put the number directly before 岁 (suì, \"years old\") with no verb needed — 是 is not used. 我三岁 means \"I am three years old\". 几岁 asks a child's age.","level":1,"sentenceIds":["s:l1:073","s:l1:074","s:l1:075","s:l1:076"],"unitId":"l1-u06"}],"sentences":[{"id":"s:l1:new:008","zh":"弟弟小，妹妹小。","pinyin":"Dìdi xiǎo, mèimei xiǎo.","en":"Little brother is small, little sister is small.","wordIds":["w:弟弟","w:小","w:妹妹","w:小"],"unitId":"l1-u06"},{"id":"s:l1:073","zh":"我三岁。","pinyin":"Wǒ sān suì.","en":"I am three years old.","wordIds":["w:我","w:三","w:岁"],"unitId":"l1-u06"},{"id":"s:l1:074","zh":"他两岁。","pinyin":"Tā liǎng suì.","en":"He is two years old.","wordIds":["w:他","w:两","w:岁"],"unitId":"l1-u06"},{"id":"s:l1:075","zh":"你几岁？","pinyin":"Nǐ jǐ suì?","en":"How old are you?","wordIds":["w:你","w:几","w:岁"],"unitId":"l1-u06"}]}
