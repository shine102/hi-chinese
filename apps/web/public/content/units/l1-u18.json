{"unit":{"id":"l1-u18","level":1,"order":18,"title":"Want & Can","wordIds":["w:看","w:说","w:做","w:想","w:要","w:能","w:会","w:给","w:用","w:拿","w:找","w:等"],"grammarIds":["g:gei-recipient","g:qing-please","g:want-verb","g:gen-with","g:meiyou-negation","g:yixiar-brief-verb","g:xian-first"],"sentenceIds":["s:l1:017","s:l1:019","s:l1:069","s:l1:071","s:l1:new:020","s:l1:new:021","s:l1:new:022","s:l1:new:023","s:l1:new:024","s:l1:new:025","s:l1:112","s:l1:114","s:l1:020","s:l1:026","s:l1:028","s:l1:098","s:l1:115","s:l1:025","s:l1:099","s:l1:072","s:l1:018","s:l1:055","s:l1:022","s:l1:210","s:l1:211","s:l1:023","s:l1:077","s:l1:078","s:l1:102","s:l1:133","s:l1:198","s:l1:212","s:l1:182","s:l1:191","s:l1:192"]},"grammar":[{"id":"g:gei-recipient","title":"给 for giving to someone","pattern":"Subject + 给 + person (+ object)","explanation":"给 (gěi) means \"to give\" or introduces the person something is done \"for/to\". It comes before the recipient: 我给你 means \"I give it to you\". Like other simple verbs, it can stand alone in a short sentence.","level":1,"sentenceIds":["s:l1:017","s:l1:018","s:l1:019","s:l1:020"],"unitId":"l1-u18"},{"id":"g:qing-please","title":"请 for polite requests","pattern":"请 + (person) + verb","explanation":"请 (qǐng) makes a request polite, like English \"please\". It comes at the very front of the sentence, before the person being addressed if one is named: 请你来 (\"Please come\").","level":1,"sentenceIds":["s:l1:069","s:l1:070","s:l1:071","s:l1:072"],"unitId":"l1-u18"},{"id":"g:want-verb","title":"Saying what you want with 要","pattern":"subject + 要 + verb + object","explanation":"要 (yào) before a verb means 'want to': 我要吃饭 (I want to eat). 要 can also mean 'need' or 'will'.","level":1,"sentenceIds":["s:l1:new:020","s:l1:new:021"],"unitId":"l1-u18"},{"id":"g:gen-with","title":"跟 for \"with someone\"","pattern":"Subject + 跟 + person + verb","explanation":"跟 (gēn) introduces a companion — \"with\" someone. It comes before the verb, not after: 我跟你去 (\"I'll go with you\"), not 我去跟你.","level":1,"sentenceIds":["s:l1:053","s:l1:054","s:l1:055","s:l1:056"],"unitId":"l1-u18"},{"id":"g:meiyou-negation","title":"没 for negating past actions","pattern":"没 + verb","explanation":"没 (méi) says an action didn't happen, which is different from 不, which negates general facts or habits. 我没去 means \"I didn't go\", not \"I don't go\". 没 is a short form of 没有 in this use.","level":1,"sentenceIds":["s:l1:021","s:l1:022","s:l1:023","s:l1:024"],"unitId":"l1-u18"},{"id":"g:yixiar-brief-verb","title":"verb + 一下儿 for a quick action","pattern":"verb + 一下(儿)","explanation":"Adding 一下儿 (yíxiàr) right after a verb makes the action sound brief, casual, or low-pressure — similar to \"just a second\" in English: 看一下儿 (\"take a quick look\"), 等一下儿 (\"wait a moment\"). It softens requests, making them sound more polite.","level":1,"sentenceIds":["s:l1:210","s:l1:211","s:l1:212"],"unitId":"l1-u18"},{"id":"g:xian-first","title":"先 for \"first\" in a sequence","pattern":"先 + verb","explanation":"先 (xiān) means to do something first, before something else happens. It goes before the verb: 我先看 (\"I'll look first\"). It's often paired later with 再 (\"then\"), though each word can also stand alone.","level":1,"sentenceIds":["s:l1:077","s:l1:078","s:l1:079","s:l1:080"],"unitId":"l1-u18"}],"sentences":[{"id":"s:l1:017","zh":"我给你。","pinyin":"Wǒ gěi nǐ.","en":"I'll give it to you.","wordIds":["w:我","w:给","w:你"],"unitId":"l1-u18"},{"id":"s:l1:019","zh":"你给他。","pinyin":"Nǐ gěi tā.","en":"Give it to him.","wordIds":["w:你","w:给","w:他"],"unitId":"l1-u18"},{"id":"s:l1:069","zh":"请说。","pinyin":"Qǐng shuō.","en":"Please speak.","wordIds":["w:请","w:说"],"unitId":"l1-u18"},{"id":"s:l1:071","zh":"请给我。","pinyin":"Qǐng gěi wǒ.","en":"Please give it to me.","wordIds":["w:请","w:给","w:我"],"unitId":"l1-u18"},{"id":"s:l1:new:020","zh":"我要吃饭。","pinyin":"Wǒ yào chī fàn.","en":"I want to eat.","wordIds":["w:我","w:要","w:吃","w:饭"],"unitId":"l1-u18"},{"id":"s:l1:new:021","zh":"你要喝水。","pinyin":"Nǐ yào hē shuǐ.","en":"You want to drink water.","wordIds":["w:你","w:要","w:喝","w:水"],"unitId":"l1-u18"},{"id":"s:l1:new:022","zh":"我要喝茶。","pinyin":"Wǒ yào hē chá.","en":"I want to drink tea.","wordIds":["w:我","w:要","w:喝","w:茶"],"unitId":"l1-u18"},{"id":"s:l1:new:023","zh":"他要吃肉。","pinyin":"Tā yào chī ròu.","en":"He wants to eat meat.","wordIds":["w:他","w:要","w:吃","w:肉"],"unitId":"l1-u18"},{"id":"s:l1:new:024","zh":"我不要吃鸡蛋。","pinyin":"Wǒ bú yào chī jīdàn.","en":"I don't want to eat eggs.","wordIds":["w:我","w:不","w:要","w:吃","w:鸡蛋"],"unitId":"l1-u18"},{"id":"s:l1:new:025","zh":"我想吃米饭。","pinyin":"Wǒ xiǎng chī mǐfàn.","en":"I'd like to eat rice.","wordIds":["w:我","w:想","w:吃","w:米饭"],"unitId":"l1-u18"},{"id":"s:l1:112","zh":"我要一杯水。","pinyin":"Wǒ yào yì bēi shuǐ.","en":"I'd like a cup of water.","wordIds":["w:我","w:要","w:一","w:杯","w:水"],"unitId":"l1-u18"},{"id":"s:l1:114","zh":"给我一杯。","pinyin":"Gěi wǒ yì bēi.","en":"Give me a cup.","wordIds":["w:给","w:我","w:一","w:杯"],"unitId":"l1-u18"},{"id":"s:l1:020","zh":"我给你一个。","pinyin":"Wǒ gěi nǐ yí gè.","en":"I'll give you one.","wordIds":["w:我","w:给","w:你","w:一","w:个"],"unitId":"l1-u18"},{"id":"s:l1:026","zh":"他说什么？","pinyin":"Tā shuō shénme?","en":"What did he say?","wordIds":["w:他","w:说","w:什么"],"unitId":"l1-u18"},{"id":"s:l1:028","zh":"你看什么？","pinyin":"Nǐ kàn shénme?","en":"What are you looking at?","wordIds":["w:你","w:看","w:什么"],"unitId":"l1-u18"},{"id":"s:l1:098","zh":"你要多少？","pinyin":"Nǐ yào duōshao?","en":"How much do you want?","wordIds":["w:你","w:要","w:多少"],"unitId":"l1-u18"},{"id":"s:l1:115","zh":"你要几杯？","pinyin":"Nǐ yào jǐ bēi?","en":"How many cups do you want?","wordIds":["w:你","w:要","w:几","w:杯"],"unitId":"l1-u18"},{"id":"s:l1:025","zh":"你想做什么？","pinyin":"Nǐ xiǎng zuò shénme?","en":"What do you want to do?","wordIds":["w:你","w:想","w:做","w:什么"],"unitId":"l1-u18"},{"id":"s:l1:099","zh":"你想要多少个？","pinyin":"Nǐ xiǎng yào duōshao gè?","en":"How many would you like?","wordIds":["w:你","w:想","w:要","w:多少","w:个"],"unitId":"l1-u18"},{"id":"s:l1:072","zh":"请看这个。","pinyin":"Qǐng kàn zhège.","en":"Please look at this.","wordIds":["w:请","w:看","w:这","w:个"],"unitId":"l1-u18"},{"id":"s:l1:018","zh":"他给我们。","pinyin":"Tā gěi wǒmen.","en":"He gives it to us.","wordIds":["w:他","w:给","w:我们"],"unitId":"l1-u18"},{"id":"s:l1:055","zh":"你跟他说。","pinyin":"Nǐ gēn tā shuō.","en":"Talk to him.","wordIds":["w:你","w:跟","w:他","w:说"],"unitId":"l1-u18"},{"id":"s:l1:022","zh":"他没看。","pinyin":"Tā méi kàn.","en":"He didn't look.","wordIds":["w:他","w:没","w:看"],"unitId":"l1-u18"},{"id":"s:l1:210","zh":"你看一下儿。","pinyin":"Nǐ kàn yíxiàr.","en":"Take a quick look.","wordIds":["w:你","w:看","w:一下儿"],"unitId":"l1-u18"},{"id":"s:l1:211","zh":"我说一下儿。","pinyin":"Wǒ shuō yíxiàr.","en":"Let me say a bit.","wordIds":["w:我","w:说","w:一下儿"],"unitId":"l1-u18"},{"id":"s:l1:023","zh":"我们没做。","pinyin":"Wǒmen méi zuò.","en":"We didn't do it.","wordIds":["w:我们","w:没","w:做"],"unitId":"l1-u18"},{"id":"s:l1:077","zh":"我先看。","pinyin":"Wǒ xiān kàn.","en":"I'll look first.","wordIds":["w:我","w:先","w:看"],"unitId":"l1-u18"},{"id":"s:l1:078","zh":"你先说。","pinyin":"Nǐ xiān shuō.","en":"You go first.","wordIds":["w:你","w:先","w:说"],"unitId":"l1-u18"},{"id":"s:l1:102","zh":"我先看第二个。","pinyin":"Wǒ xiān kàn dì èr gè.","en":"I'll look at the second one first.","wordIds":["w:我","w:先","w:看","w:第二","w:个"],"unitId":"l1-u18"},{"id":"s:l1:133","zh":"他常说。","pinyin":"Tā cháng shuō.","en":"He often says that.","wordIds":["w:他","w:常","w:说"],"unitId":"l1-u18"},{"id":"s:l1:198","zh":"你等一会儿。","pinyin":"Nǐ děng yíhuìr.","en":"Wait a moment.","wordIds":["w:你","w:等","w:一会儿"],"unitId":"l1-u18"},{"id":"s:l1:212","zh":"请等一下儿。","pinyin":"Qǐng děng yíxiàr.","en":"Please wait a moment.","wordIds":["w:请","w:等","w:一下儿"],"unitId":"l1-u18"},{"id":"s:l1:182","zh":"没关系，你先说。","pinyin":"Méi guānxi, nǐ xiān shuō.","en":"It's fine, go ahead and say it.","wordIds":["w:没关系","w:你","w:先","w:说"],"unitId":"l1-u18"},{"id":"s:l1:191","zh":"我要一点儿水。","pinyin":"Wǒ yào yìdiǎnr shuǐ.","en":"I'd like a little water.","wordIds":["w:我","w:要","w:一点儿","w:水"],"unitId":"l1-u18"},{"id":"s:l1:192","zh":"我会一点儿。","pinyin":"Wǒ huì yìdiǎnr.","en":"I know a little of it.","wordIds":["w:我","w:会","w:一点儿"],"unitId":"l1-u18"}]}
