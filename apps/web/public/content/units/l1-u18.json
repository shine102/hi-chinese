{"unit":{"id":"l1-u18","level":1,"order":18,"title":"Muốn & Có Thể","wordIds":["w:看","w:说","w:做","w:想","w:要","w:能","w:给","w:用","w:拿","w:找","w:等"],"grammarIds":["g:gei-recipient","g:le-completed","g:neng-ability","g:qing-please","g:want-verb","g:xiang-want","g:yixiar-brief-verb"],"sentenceIds":["s:l1:013","s:l1:016","s:l1:017","s:l1:018","s:l1:019","s:l1:020","s:l1:022","s:l1:023","s:l1:025","s:l1:026","s:l1:028","s:l1:035","s:l1:044","s:l1:047","s:l1:055","s:l1:065","s:l1:068","s:l1:069","s:l1:071","s:l1:072","s:l1:077","s:l1:078","s:l1:098","s:l1:099","s:l1:102","s:l1:112","s:l1:114","s:l1:115","s:l1:133","s:l1:163","s:l1:182","s:l1:191","s:l1:198","s:l1:210","s:l1:211","s:l1:212","s:l1:216","s:l1:221","s:l1:core:023","s:l1:core:024","s:l1:core:025","s:l1:core:027","s:l1:core:028","s:l1:core:029","s:l1:core:030","s:l1:new:020","s:l1:new:021","s:l1:new:022","s:l1:new:023","s:l1:new:024","s:l1:new:025"]},"grammar":[{"id":"g:gei-recipient","title":"给 dùng để đưa/cho ai đó","pattern":"Subject + 给 + person (+ object)","explanation":"给 (gěi) nghĩa là \"cho, đưa\", hoặc dùng để giới thiệu người mà một việc được làm \"cho/vì\". 给 đứng trước người nhận: 我给你 nghĩa là \"Tôi cho bạn [cái đó]\". Giống như các động từ đơn giản khác, 给 có thể đứng một mình trong một câu ngắn.","level":1,"sentenceIds":["s:l1:017","s:l1:018","s:l1:019","s:l1:020"],"unitId":"l1-u18"},{"id":"g:le-completed","title":"了 sau động từ: hành động đã xong","pattern":"Verb + 了 (+ object); …了吗? / 没 + verb","explanation":"了 (le) đặt ngay sau động từ cho biết hành động đã hoàn thành: 妈妈做了三个菜 (mẹ đã nấu ba món). Khi có tân ngữ, tân ngữ thường kèm số lượng hoặc từ bổ nghĩa, như 三个菜, 一杯水, 我的杯子. Muốn hỏi việc đã làm chưa thì giữ 了 và thêm 吗 hoặc 没有 vào cuối câu: 你拿了我的杯子吗？, 你吃了没有？ Phủ định dùng 没 + động từ và bỏ 了: nói 我没吃早饭, không nói 我没吃了早饭.","level":1,"sentenceIds":["s:l1:core:023","s:l1:core:024","s:l1:core:025","s:l1:core:026"],"unitId":"l1-u18"},{"id":"g:neng-ability","title":"能 nghĩa là \"có thể\" (khả năng hoặc sự cho phép)","pattern":"Subject + 能 + verb","explanation":"能 (néng) nghĩa là \"có thể\" — làm được việc gì đó nhờ khả năng, được cho phép, hoặc do hoàn cảnh cho phép. 能 đứng ngay trước động từ. Phủ định bằng 不能 (bù néng), nghĩa là \"không thể\".","level":1,"sentenceIds":["s:l1:013","s:l1:014","s:l1:015","s:l1:016"],"unitId":"l1-u18"},{"id":"g:qing-please","title":"请 dùng cho lời đề nghị lịch sự","pattern":"请 + (person) + verb","explanation":"请 (qǐng) làm cho một lời đề nghị trở nên lịch sự, giống như \"làm ơn\" trong tiếng Việt. 请 đứng ở đầu câu, trước cả người được nhắc đến nếu có: 请你来 (\"Mời bạn đến\").","level":1,"sentenceIds":["s:l1:069","s:l1:070","s:l1:071","s:l1:072"],"unitId":"l1-u18"},{"id":"g:want-verb","title":"Nói điều mình muốn với 要","pattern":"subject + 要 + verb + object","explanation":"要 (yào) đứng trước động từ nghĩa là \"muốn\": 我要吃饭 (Tôi muốn ăn cơm). 要 cũng có thể mang nghĩa \"cần\" hoặc \"sẽ\".","level":1,"sentenceIds":["s:l1:new:020","s:l1:new:021"],"unitId":"l1-u18"},{"id":"g:xiang-want","title":"想 + động từ: muốn làm gì","pattern":"Subject + 想 + verb","explanation":"想 (xiǎng) đứng trước động từ, nghĩa là \"muốn\" làm gì: 我想喝茶 (tôi muốn uống trà). So với 要, 想 nhẹ nhàng và lịch sự hơn, giống như nói ra mong muốn của mình; 要 thì dứt khoát hơn, gần với \"cần\", \"đòi\". Phủ định là 不想 (bù xiǎng): 我不想吃饭. Còn 不要 nghe như từ chối thẳng, hoặc mang nghĩa \"đừng\".","level":1,"sentenceIds":["s:l1:core:027","s:l1:core:028","s:l1:core:029","s:l1:core:030"],"unitId":"l1-u18"},{"id":"g:yixiar-brief-verb","title":"động từ + 一下儿 để diễn tả một hành động ngắn, nhanh","pattern":"verb + 一下(儿)","explanation":"Thêm 一下儿 (yíxiàr) ngay sau động từ làm cho hành động nghe có vẻ ngắn gọn, thoải mái, nhẹ nhàng — giống như \"một chút\" hay \"một lát\" trong tiếng Việt: 看一下儿 (\"xem một chút\"), 等一下儿 (\"đợi một lát\"). Nó làm cho lời đề nghị nghe lịch sự hơn.","level":1,"sentenceIds":["s:l1:210","s:l1:211","s:l1:212"],"unitId":"l1-u18"}],"sentences":[{"id":"s:l1:013","zh":"我能去。","pinyin":"Wǒ néng qù.","vi":"Tôi có thể đi.","wordIds":["w:我","w:能","w:去"],"unitId":"l1-u18"},{"id":"s:l1:016","zh":"我们都能去。","pinyin":"Wǒmen dōu néng qù.","vi":"Chúng tôi đều có thể đi.","wordIds":["w:我们","w:都","w:能","w:去"],"unitId":"l1-u18"},{"id":"s:l1:017","zh":"我给你。","pinyin":"Wǒ gěi nǐ.","vi":"Tôi cho bạn.","wordIds":["w:我","w:给","w:你"],"unitId":"l1-u18"},{"id":"s:l1:018","zh":"他给我们。","pinyin":"Tā gěi wǒmen.","vi":"Anh ấy cho chúng tôi.","wordIds":["w:他","w:给","w:我们"],"unitId":"l1-u18"},{"id":"s:l1:019","zh":"你给他。","pinyin":"Nǐ gěi tā.","vi":"Bạn đưa cho anh ấy.","wordIds":["w:你","w:给","w:他"],"unitId":"l1-u18"},{"id":"s:l1:020","zh":"我给你一个。","pinyin":"Wǒ gěi nǐ yí gè.","vi":"Tôi cho bạn một cái.","wordIds":["w:我","w:给","w:你","w:一","w:个"],"unitId":"l1-u18"},{"id":"s:l1:022","zh":"他没看。","pinyin":"Tā méi kàn.","vi":"Anh ấy đã không nhìn.","wordIds":["w:他","w:没","w:看"],"unitId":"l1-u18"},{"id":"s:l1:023","zh":"我们没做。","pinyin":"Wǒmen méi zuò.","vi":"Chúng tôi đã không làm.","wordIds":["w:我们","w:没","w:做"],"unitId":"l1-u18"},{"id":"s:l1:025","zh":"你想做什么？","pinyin":"Nǐ xiǎng zuò shénme?","vi":"Bạn muốn làm gì?","wordIds":["w:你","w:想","w:做","w:什么"],"unitId":"l1-u18"},{"id":"s:l1:026","zh":"他说什么？","pinyin":"Tā shuō shénme?","vi":"Anh ấy nói gì?","wordIds":["w:他","w:说","w:什么"],"unitId":"l1-u18"},{"id":"s:l1:028","zh":"你看什么？","pinyin":"Nǐ kàn shénme?","vi":"Bạn nhìn gì?","wordIds":["w:你","w:看","w:什么"],"unitId":"l1-u18"},{"id":"s:l1:035","zh":"你想去吗？","pinyin":"Nǐ xiǎng qù ma?","vi":"Bạn có muốn đi không?","wordIds":["w:你","w:想","w:去","w:吗"],"unitId":"l1-u18"},{"id":"s:l1:044","zh":"我最想去。","pinyin":"Wǒ zuì xiǎng qù.","vi":"Tôi muốn đi nhất.","wordIds":["w:我","w:最","w:想","w:去"],"unitId":"l1-u18"},{"id":"s:l1:047","zh":"我们都想去，他呢？","pinyin":"Wǒmen dōu xiǎng qù, tā ne?","vi":"Chúng tôi đều muốn đi, còn anh ấy thì sao?","wordIds":["w:我们","w:都","w:想","w:去","w:他","w:呢"],"unitId":"l1-u18"},{"id":"s:l1:055","zh":"你跟他说。","pinyin":"Nǐ gēn tā shuō.","vi":"Bạn nói với anh ấy đi.","wordIds":["w:你","w:跟","w:他","w:说"],"unitId":"l1-u18"},{"id":"s:l1:065","zh":"别说了。","pinyin":"Bié shuō le.","vi":"Đừng nói nữa.","wordIds":["w:别","w:说","w:了"],"unitId":"l1-u18"},{"id":"s:l1:068","zh":"你别想了。","pinyin":"Nǐ bié xiǎng le.","vi":"Bạn đừng nghĩ nữa.","wordIds":["w:你","w:别","w:想","w:了"],"unitId":"l1-u18"},{"id":"s:l1:069","zh":"请说。","pinyin":"Qǐng shuō.","vi":"Mời bạn nói.","wordIds":["w:请","w:说"],"unitId":"l1-u18"},{"id":"s:l1:071","zh":"请给我。","pinyin":"Qǐng gěi wǒ.","vi":"Làm ơn cho tôi.","wordIds":["w:请","w:给","w:我"],"unitId":"l1-u18"},{"id":"s:l1:072","zh":"请看这个。","pinyin":"Qǐng kàn zhège.","vi":"Mời bạn xem cái này.","wordIds":["w:请","w:看","w:这","w:个"],"unitId":"l1-u18"},{"id":"s:l1:077","zh":"我先看。","pinyin":"Wǒ xiān kàn.","vi":"Tôi xem trước.","wordIds":["w:我","w:先","w:看"],"unitId":"l1-u18"},{"id":"s:l1:078","zh":"你先说。","pinyin":"Nǐ xiān shuō.","vi":"Bạn nói trước đi.","wordIds":["w:你","w:先","w:说"],"unitId":"l1-u18"},{"id":"s:l1:098","zh":"你要多少？","pinyin":"Nǐ yào duōshao?","vi":"Bạn muốn bao nhiêu?","wordIds":["w:你","w:要","w:多少"],"unitId":"l1-u18"},{"id":"s:l1:099","zh":"你想要多少个？","pinyin":"Nǐ xiǎng yào duōshao gè?","vi":"Bạn muốn mấy cái?","wordIds":["w:你","w:想","w:要","w:多少","w:个"],"unitId":"l1-u18"},{"id":"s:l1:102","zh":"我先看第二个。","pinyin":"Wǒ xiān kàn dì'èr gè.","vi":"Tôi xem cái thứ hai trước.","wordIds":["w:我","w:先","w:看","w:第二","w:个"],"unitId":"l1-u18"},{"id":"s:l1:112","zh":"我要一杯水。","pinyin":"Wǒ yào yì bēi shuǐ.","vi":"Tôi muốn một cốc nước.","wordIds":["w:我","w:要","w:一","w:杯","w:水"],"unitId":"l1-u18"},{"id":"s:l1:114","zh":"给我一杯。","pinyin":"Gěi wǒ yì bēi.","vi":"Cho tôi một cốc.","wordIds":["w:给","w:我","w:一","w:杯"],"unitId":"l1-u18"},{"id":"s:l1:115","zh":"你要几杯？","pinyin":"Nǐ yào jǐ bēi?","vi":"Bạn muốn mấy cốc?","wordIds":["w:你","w:要","w:几","w:杯"],"unitId":"l1-u18"},{"id":"s:l1:133","zh":"他常说。","pinyin":"Tā cháng shuō.","vi":"Anh ấy thường nói vậy.","wordIds":["w:他","w:常","w:说"],"unitId":"l1-u18"},{"id":"s:l1:163","zh":"他要三百块。","pinyin":"Tā yào sānbǎi kuài.","vi":"Anh ấy muốn ba trăm tệ.","wordIds":["w:他","w:要","w:三","w:百","w:块"],"unitId":"l1-u18"},{"id":"s:l1:182","zh":"没关系，你先说。","pinyin":"Méi guānxi, nǐ xiān shuō.","vi":"Không sao, bạn nói trước đi.","wordIds":["w:没关系","w:你","w:先","w:说"],"unitId":"l1-u18"},{"id":"s:l1:191","zh":"我要一点儿水。","pinyin":"Wǒ yào yìdiǎnr shuǐ.","vi":"Tôi muốn một chút nước.","wordIds":["w:我","w:要","w:一点儿","w:水"],"unitId":"l1-u18"},{"id":"s:l1:198","zh":"你等一会儿。","pinyin":"Nǐ děng yíhuìr.","vi":"Bạn đợi một lát.","wordIds":["w:你","w:等","w:一会儿"],"unitId":"l1-u18"},{"id":"s:l1:210","zh":"你看一下儿。","pinyin":"Nǐ kàn yíxiàr.","vi":"Bạn xem qua một chút đi.","wordIds":["w:你","w:看","w:一下儿"],"unitId":"l1-u18"},{"id":"s:l1:211","zh":"我说一下儿。","pinyin":"Wǒ shuō yíxiàr.","vi":"Để tôi nói một chút.","wordIds":["w:我","w:说","w:一下儿"],"unitId":"l1-u18"},{"id":"s:l1:212","zh":"请等一下儿。","pinyin":"Qǐng děng yíxiàr.","vi":"Làm ơn đợi một chút.","wordIds":["w:请","w:等","w:一下儿"],"unitId":"l1-u18"},{"id":"s:l1:216","zh":"我等了半天。","pinyin":"Wǒ děng le bàntiān.","vi":"Tôi đã đợi rất lâu.","wordIds":["w:我","w:等","w:了","w:半天"],"unitId":"l1-u18"},{"id":"s:l1:221","zh":"他不大想去。","pinyin":"Tā bú dà xiǎng qù.","vi":"Anh ấy không muốn đi lắm.","wordIds":["w:他","w:不","w:大","w:想","w:去"],"unitId":"l1-u18"},{"id":"s:l1:core:023","zh":"妈妈做了三个菜。","pinyin":"Māma zuò le sān ge cài.","vi":"Mẹ đã nấu ba món.","wordIds":["w:妈妈","w:做","w:了","w:三","w:个","w:菜"],"unitId":"l1-u18"},{"id":"s:l1:core:024","zh":"我给了他一杯水。","pinyin":"Wǒ gěi le tā yì bēi shuǐ.","vi":"Tôi đã đưa cho anh ấy một cốc nước.","wordIds":["w:我","w:给","w:了","w:他","w:一","w:杯","w:水"],"unitId":"l1-u18"},{"id":"s:l1:core:025","zh":"你拿了我的杯子吗？","pinyin":"Nǐ ná le wǒ de bēizi ma?","vi":"Bạn đã lấy cốc của tôi à?","wordIds":["w:你","w:拿","w:了","w:我","w:的","w:杯子","w:吗"],"unitId":"l1-u18"},{"id":"s:l1:core:027","zh":"我想喝茶。","pinyin":"Wǒ xiǎng hē chá.","vi":"Tôi muốn uống trà.","wordIds":["w:我","w:想","w:喝","w:茶"],"unitId":"l1-u18"},{"id":"s:l1:core:028","zh":"你想吃什么？","pinyin":"Nǐ xiǎng chī shénme?","vi":"Bạn muốn ăn gì?","wordIds":["w:你","w:想","w:吃","w:什么"],"unitId":"l1-u18"},{"id":"s:l1:core:029","zh":"我不想吃饭。","pinyin":"Wǒ bù xiǎng chīfàn.","vi":"Tôi không muốn ăn cơm.","wordIds":["w:我","w:不","w:想","w:吃饭"],"unitId":"l1-u18"},{"id":"s:l1:core:030","zh":"晚上我想吃面条儿。","pinyin":"Wǎnshang wǒ xiǎng chī miàntiáor.","vi":"Tối nay tôi muốn ăn mì.","wordIds":["w:晚上","w:我","w:想","w:吃","w:面条儿"],"unitId":"l1-u18"},{"id":"s:l1:new:020","zh":"我要吃饭。","pinyin":"Wǒ yào chī fàn.","vi":"Tôi muốn ăn cơm.","wordIds":["w:我","w:要","w:吃","w:饭"],"unitId":"l1-u18"},{"id":"s:l1:new:021","zh":"你要喝水。","pinyin":"Nǐ yào hē shuǐ.","vi":"Bạn muốn uống nước.","wordIds":["w:你","w:要","w:喝","w:水"],"unitId":"l1-u18"},{"id":"s:l1:new:022","zh":"我要喝茶。","pinyin":"Wǒ yào hē chá.","vi":"Tôi muốn uống trà.","wordIds":["w:我","w:要","w:喝","w:茶"],"unitId":"l1-u18"},{"id":"s:l1:new:023","zh":"他要吃肉。","pinyin":"Tā yào chī ròu.","vi":"Anh ấy muốn ăn thịt.","wordIds":["w:他","w:要","w:吃","w:肉"],"unitId":"l1-u18"},{"id":"s:l1:new:024","zh":"我不要吃鸡蛋。","pinyin":"Wǒ bú yào chī jīdàn.","vi":"Tôi không muốn ăn trứng.","wordIds":["w:我","w:不","w:要","w:吃","w:鸡蛋"],"unitId":"l1-u18"},{"id":"s:l1:new:025","zh":"我想吃米饭。","pinyin":"Wǒ xiǎng chī mǐfàn.","vi":"Tôi muốn ăn cơm.","wordIds":["w:我","w:想","w:吃","w:米饭"],"unitId":"l1-u18"}]}
