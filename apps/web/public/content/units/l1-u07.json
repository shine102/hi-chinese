{"unit":{"id":"l1-u07","level":1,"order":7,"title":"We & They","wordIds":["w:孩子","w:家人","w:们","w:我们","w:你们","w:他们","w:她们","w:男","w:女","w:男人","w:女人","w:别人"],"grammarIds":["g:men-plural-suffix"],"sentenceIds":["s:l1:010","s:l1:089","s:l1:123"]},"grammar":[{"id":"g:men-plural-suffix","title":"们 làm hậu tố số nhiều","pattern":"person noun + 们","explanation":"们 (men) gắn vào một danh từ chỉ người để tạo số nhiều: 孩子们 (\"những đứa trẻ\"), 朋友们 (\"những người bạn\"). 们 đã có sẵn trong 我们, 你们, và 他们, nhưng cũng có thể gắn vào các danh từ chỉ người khác theo cách tương tự.","level":1,"sentenceIds":["s:l1:089","s:l1:090","s:l1:091"],"unitId":"l1-u07"}],"sentences":[{"id":"s:l1:010","zh":"我们都很好。","pinyin":"Wǒmen dōu hěn hǎo.","vi":"Chúng tôi đều rất tốt.","wordIds":["w:我们","w:都","w:很","w:好"],"unitId":"l1-u07"},{"id":"s:l1:089","zh":"孩子们很好。","pinyin":"Háizimen hěn hǎo.","vi":"Bọn trẻ đều khỏe.","wordIds":["w:孩子","w:们","w:很","w:好"],"unitId":"l1-u07"},{"id":"s:l1:123","zh":"她们的名字很好。","pinyin":"Tāmen de míngzi hěn hǎo.","vi":"Tên của họ rất đẹp.","wordIds":["w:她们","w:的","w:名字","w:很","w:好"],"unitId":"l1-u07"}]}
