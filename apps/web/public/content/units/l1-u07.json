{"unit":{"id":"l1-u07","level":1,"order":7,"title":"Unit 7","wordIds":["w:你们","w:前","w:时间","w:怎么","w:爱","w:地","w:这些","w:跟","w:喜欢","w:吃","w:谁","w:新"],"grammarIds":["g:ne-followup","g:zui-superlative"],"sentenceIds":["s:l1:049","s:l1:050","s:l1:051","s:l1:052","s:l1:053","s:l1:054","s:l1:055","s:l1:056","s:l1:220"]},"grammar":[{"id":"g:ne-followup","title":"呢 for follow-up questions","pattern":"..., + noun + 呢?","explanation":"After stating something, 你呢? asks \"and you?\" without repeating the whole sentence. 呢 (ne) attaches to the topic being asked about and relies on context from what was just said.","level":1,"sentenceIds":["s:l1:045","s:l1:046","s:l1:047","s:l1:048"],"unitId":"l1-u07"},{"id":"g:zui-superlative","title":"最 for superlatives","pattern":"最 + adjective","explanation":"最 (zuì) makes an adjective superlative, like English \"-est\" or \"most\". Place it directly before the adjective: 最好 (best), 最大 (biggest). No extra word for \"the\" is needed.","level":1,"sentenceIds":["s:l1:041","s:l1:042","s:l1:043","s:l1:044"],"unitId":"l1-u07"}],"sentences":[{"id":"s:l1:049","zh":"你怎么知道？","pinyin":"Nǐ zěnme zhīdào?","en":"How do you know?","wordIds":["w:你","w:怎么","w:知道"],"unitId":"l1-u07"},{"id":"s:l1:050","zh":"这个怎么用？","pinyin":"Zhège zěnme yòng?","en":"How do you use this?","wordIds":["w:这","w:个","w:怎么","w:用"],"unitId":"l1-u07"},{"id":"s:l1:051","zh":"他怎么走？","pinyin":"Tā zěnme zǒu?","en":"How does he go?","wordIds":["w:他","w:怎么","w:走"],"unitId":"l1-u07"},{"id":"s:l1:052","zh":"你怎么了？","pinyin":"Nǐ zěnme le?","en":"What's wrong with you?","wordIds":["w:你","w:怎么","w:了"],"unitId":"l1-u07"},{"id":"s:l1:053","zh":"我跟你去。","pinyin":"Wǒ gēn nǐ qù.","en":"I'll go with you.","wordIds":["w:我","w:跟","w:你","w:去"],"unitId":"l1-u07"},{"id":"s:l1:054","zh":"他跟谁去？","pinyin":"Tā gēn shéi qù?","en":"Who is he going with?","wordIds":["w:他","w:跟","w:谁","w:去"],"unitId":"l1-u07"},{"id":"s:l1:055","zh":"你跟他说。","pinyin":"Nǐ gēn tā shuō.","en":"Talk to him.","wordIds":["w:你","w:跟","w:他","w:说"],"unitId":"l1-u07"},{"id":"s:l1:056","zh":"我喜欢跟你说。","pinyin":"Wǒ xǐhuan gēn nǐ shuō.","en":"I like talking with you.","wordIds":["w:我","w:喜欢","w:跟","w:你","w:说"],"unitId":"l1-u07"},{"id":"s:l1:220","zh":"我不大喜欢。","pinyin":"Wǒ bú dà xǐhuan.","en":"I don't like it very much.","wordIds":["w:我","w:不","w:大","w:喜欢"],"unitId":"l1-u07"}]}
