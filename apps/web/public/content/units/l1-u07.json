{"unit":{"id":"l1-u07","level":1,"order":7,"title":"Eating Out","wordIds":["w:饿","w:渴","w:吃饭","w:好吃","w:杯","w:杯子","w:饭店","w:牛奶","w:面条儿","w:早饭","w:午饭","w:晚饭"],"grammarIds":["g:measure-bei"],"sentenceIds":["s:l1:112","s:l1:113","s:l1:114"]},"grammar":[{"id":"g:measure-bei","title":"杯 as a measure word for drinks","pattern":"Number + 杯 + noun","explanation":"杯 (bēi) is the measure word for cups or glasses of a drink: 一杯水 (\"a cup of water\"). Like 个, it goes between the number and the noun and is required — you can't say 一水.","level":1,"sentenceIds":["s:l1:112","s:l1:113","s:l1:114","s:l1:115"],"unitId":"l1-u07"}],"sentences":[{"id":"s:l1:112","zh":"我要一杯水。","pinyin":"Wǒ yào yì bēi shuǐ.","en":"I'd like a cup of water.","wordIds":["w:我","w:要","w:一","w:杯","w:水"],"unitId":"l1-u07"},{"id":"s:l1:113","zh":"他有一杯。","pinyin":"Tā yǒu yì bēi.","en":"He has one cup.","wordIds":["w:他","w:有","w:一","w:杯"],"unitId":"l1-u07"},{"id":"s:l1:114","zh":"给我一杯。","pinyin":"Gěi wǒ yì bēi.","en":"Give me a cup.","wordIds":["w:给","w:我","w:一","w:杯"],"unitId":"l1-u07"}]}
