{"unit":{"id":"l1-u07","level":1,"order":7,"title":"We & They","wordIds":["w:孩子","w:家人","w:们","w:我们","w:你们","w:他们","w:她们","w:男","w:女","w:男人","w:女人","w:别人"],"grammarIds":["g:men-plural-suffix"],"sentenceIds":["s:l1:new:005","s:l1:new:012","s:l1:089","s:l1:010","s:l1:123"]},"grammar":[{"id":"g:men-plural-suffix","title":"们 as a plural suffix","pattern":"person noun + 们","explanation":"们 (men) attaches to a noun referring to people to make it plural: 孩子们 (\"children\"), 朋友们 (\"friends\"). It's already built into 我们, 你们, and 他们, but can attach to other people-nouns the same way.","level":1,"sentenceIds":["s:l1:089","s:l1:090","s:l1:091"],"unitId":"l1-u07"}],"sentences":[{"id":"s:l1:new:005","zh":"我家有孩子。","pinyin":"Wǒ jiā yǒu háizi.","en":"My family has children.","wordIds":["w:我","w:家","w:孩子"],"unitId":"l1-u07"},{"id":"s:l1:new:012","zh":"我家有三个孩子。","pinyin":"Wǒ jiā yǒu sān ge háizi.","en":"My family has three children.","wordIds":["w:我","w:家","w:三","w:孩子"],"unitId":"l1-u07"},{"id":"s:l1:089","zh":"孩子们很好。","pinyin":"Háizimen hěn hǎo.","en":"The children are doing well.","wordIds":["w:孩子","w:们","w:很","w:好"],"unitId":"l1-u07"},{"id":"s:l1:010","zh":"我们都很好。","pinyin":"Wǒmen dōu hěn hǎo.","en":"We are all fine.","wordIds":["w:我们","w:都","w:很","w:好"],"unitId":"l1-u07"},{"id":"s:l1:123","zh":"她们的名字很好。","pinyin":"Tāmen de míngzi hěn hǎo.","en":"Their names are lovely.","wordIds":["w:她们","w:的","w:名字","w:很","w:好"],"unitId":"l1-u07"}]}
