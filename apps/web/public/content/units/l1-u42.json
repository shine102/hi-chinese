{"unit":{"id":"l1-u42","level":1,"order":42,"title":"Past & Change","wordIds":["w:了","w:过","w:着","w:地","w:爸","w:妈","w:奶","w:图书馆","w:试","w:干","w:打球","w:开会","w:开玩笑","w:找到"],"grammarIds":["g:jieguo-complement","g:tai-le"],"sentenceIds":["s:l1:037","s:l1:038","s:l1:039","s:l1:040","s:l1:052","s:l1:065","s:l1:068","s:l1:076","s:l1:079","s:l1:090","s:l1:106","s:l1:124","s:l1:125","s:l1:126","s:l1:127","s:l1:131","s:l1:137","s:l1:148","s:l1:170","s:l1:215","s:l1:216","s:l1:217","s:l1:225","s:l1:227","s:l2:338","s:l2:339","s:l3:135","s:l3:219","s:l3:220","s:l3:222","s:l3:236"]},"grammar":[{"id":"g:jieguo-complement","title":"Bổ ngữ kết quả với 到 và 见","pattern":"verb + 到 / 见","explanation":"Thêm 到 (dào) hoặc 见 (jiàn) ngay sau động từ để thể hiện hành động đã thành công, chứ không chỉ là đã cố gắng thực hiện: 找到 (\"tìm thấy\", chứ không chỉ là \"tìm\"), 看见 (\"nhìn thấy\", chứ không chỉ là \"nhìn\"), 听到 (\"nghe thấy\"), 回到 (\"đã quay về tới\"). Nếu không có bổ ngữ này, 看 và 听 chỉ miêu tả hành động, không nói lên kết quả.","level":1,"sentenceIds":["s:l1:124","s:l1:125","s:l1:126","s:l1:127"],"unitId":"l1-u42"},{"id":"g:tai-le","title":"太...了 nghĩa là \"quá\"","pattern":"太 + adjective + 了","explanation":"太 (tài) nghĩa là \"quá\" hay \"cực kỳ\", và thêm 了 ở cuối câu để nhấn mạnh mức độ. 太好了! là một câu cảm thán thông dụng nghĩa là \"Tuyệt quá!\", chứ không phải một lời phàn nàn theo nghĩa đen.","level":1,"sentenceIds":["s:l1:037","s:l1:038","s:l1:039","s:l1:040"],"unitId":"l1-u42"}],"sentences":[{"id":"s:l1:037","zh":"太好了！","pinyin":"Tài hǎo le!","vi":"Tuyệt quá!","wordIds":["w:太","w:好","w:了"],"unitId":"l1-u42"},{"id":"s:l1:038","zh":"这个太大了。","pinyin":"Zhège tài dà le.","vi":"Cái này to quá.","wordIds":["w:这","w:个","w:太","w:大","w:了"],"unitId":"l1-u42"},{"id":"s:l1:039","zh":"你太好了。","pinyin":"Nǐ tài hǎo le.","vi":"Bạn tốt quá.","wordIds":["w:你","w:太","w:好","w:了"],"unitId":"l1-u42"},{"id":"s:l1:040","zh":"我们太多了。","pinyin":"Wǒmen tài duō le.","vi":"Chúng ta đông quá.","wordIds":["w:我们","w:太","w:多","w:了"],"unitId":"l1-u42"},{"id":"s:l1:052","zh":"你怎么了？","pinyin":"Nǐ zěnme le?","vi":"Bạn sao vậy?","wordIds":["w:你","w:怎么","w:了"],"unitId":"l1-u42"},{"id":"s:l1:065","zh":"别说了。","pinyin":"Bié shuō le.","vi":"Đừng nói nữa.","wordIds":["w:别","w:说","w:了"],"unitId":"l1-u42"},{"id":"s:l1:068","zh":"你别想了。","pinyin":"Nǐ bié xiǎng le.","vi":"Bạn đừng nghĩ nữa.","wordIds":["w:你","w:别","w:想","w:了"],"unitId":"l1-u42"},{"id":"s:l1:076","zh":"她三岁了。","pinyin":"Tā sān suì le.","vi":"Cô bé ba tuổi rồi.","wordIds":["w:她","w:三","w:岁","w:了"],"unitId":"l1-u42"},{"id":"s:l1:079","zh":"他先走了。","pinyin":"Tā xiān zǒu le.","vi":"Anh ấy đã đi trước rồi.","wordIds":["w:他","w:先","w:走","w:了"],"unitId":"l1-u42"},{"id":"s:l1:090","zh":"朋友们都来了。","pinyin":"Péngyoumen dōu lái le.","vi":"Các bạn đều đã đến.","wordIds":["w:朋友","w:们","w:都","w:来","w:了"],"unitId":"l1-u42"},{"id":"s:l1:106","zh":"他真的来了。","pinyin":"Tā zhēnde lái le.","vi":"Anh ấy thật sự đã đến.","wordIds":["w:他","w:真的","w:来","w:了"],"unitId":"l1-u42"},{"id":"s:l1:124","zh":"我看见他了。","pinyin":"Wǒ kànjiàn tā le.","vi":"Tôi đã nhìn thấy anh ấy.","wordIds":["w:我","w:看见","w:他","w:了"],"unitId":"l1-u42"},{"id":"s:l1:125","zh":"你听到了吗？","pinyin":"Nǐ tīngdào le ma?","vi":"Bạn đã nghe thấy chưa?","wordIds":["w:你","w:听到","w:了","w:吗"],"unitId":"l1-u42"},{"id":"s:l1:126","zh":"他回到家里了。","pinyin":"Tā huídào jiālǐ le.","vi":"Anh ấy đã về đến nhà.","wordIds":["w:他","w:回到","w:家里","w:了"],"unitId":"l1-u42"},{"id":"s:l1:127","zh":"我找到了。","pinyin":"Wǒ zhǎodào le.","vi":"Tôi đã tìm thấy rồi.","wordIds":["w:我","w:找到","w:了"],"unitId":"l1-u42"},{"id":"s:l1:131","zh":"不用了，谢谢。","pinyin":"Búyòng le, xièxie.","vi":"Không cần đâu, cảm ơn.","wordIds":["w:不用","w:了","w:谢谢"],"unitId":"l1-u42"},{"id":"s:l1:137","zh":"他给我打电话了。","pinyin":"Tā gěi wǒ dǎ diànhuà le.","vi":"Anh ấy đã gọi điện cho tôi.","wordIds":["w:他","w:给","w:我","w:打电话","w:了"],"unitId":"l1-u42"},{"id":"s:l1:148","zh":"对不起，我来晚了。","pinyin":"Duìbuqǐ, wǒ lái wǎn le.","vi":"Xin lỗi, tôi đến muộn.","wordIds":["w:对不起","w:我","w:来","w:晚","w:了"],"unitId":"l1-u42"},{"id":"s:l1:170","zh":"他干什么了？","pinyin":"Tā gànshénme le?","vi":"Anh ấy đã làm gì vậy?","wordIds":["w:他","w:干什么","w:了"],"unitId":"l1-u42"},{"id":"s:l1:215","zh":"他坐下了。","pinyin":"Tā zuòxia le.","vi":"Anh ấy đã ngồi xuống.","wordIds":["w:他","w:坐下","w:了"],"unitId":"l1-u42"},{"id":"s:l1:216","zh":"我等了半天。","pinyin":"Wǒ děngle bàntiān.","vi":"Tôi đã đợi rất lâu.","wordIds":["w:我","w:等","w:了","w:半天"],"unitId":"l1-u42"},{"id":"s:l1:217","zh":"他学了半年。","pinyin":"Tā xuéle bànnián.","vi":"Anh ấy đã học nửa năm.","wordIds":["w:他","w:学","w:了","w:半年"],"unitId":"l1-u42"},{"id":"s:l1:225","zh":"他在开会。","pinyin":"Tā zài kāihuì.","vi":"Anh ấy đang họp.","wordIds":["w:他","w:在","w:开会"],"unitId":"l1-u42"},{"id":"s:l1:227","zh":"别开玩笑了。","pinyin":"Bié kāiwánxiào le.","vi":"Đừng đùa nữa.","wordIds":["w:别","w:开玩笑","w:了"],"unitId":"l1-u42"},{"id":"s:l2:338","zh":"你去过北京吗？","pinyin":"Nǐ qù guo Běijīng ma?","vi":"Bạn đã từng đến Bắc Kinh chưa?","wordIds":["w:你","w:去","w:过","w:北京","w:吗"],"unitId":"l1-u42"},{"id":"s:l2:339","zh":"我没吃过这个菜。","pinyin":"Wǒ méi chī guo zhège cài.","vi":"Tôi chưa từng ăn món này.","wordIds":["w:我","w:没","w:吃","w:过","w:这","w:个","w:菜"],"unitId":"l1-u42"},{"id":"s:l3:135","zh":"太晚了，我们去不了了。","pinyin":"Tài wǎn le, wǒmen qù bu liǎo le.","vi":"Muộn quá rồi, chúng tôi không thể đi được nữa.","wordIds":["w:太","w:晚","w:了","w:我们","w:去","w:不","w:了","w:了"],"unitId":"l1-u42"},{"id":"s:l3:219","zh":"他站住不动了。","pinyin":"Tā zhàn zhù bù dòng le.","vi":"Anh ấy đứng yên không nhúc nhích.","wordIds":["w:他","w:站","w:住","w:不","w:动","w:了"],"unitId":"l1-u42"},{"id":"s:l3:220","zh":"天气冷起来了。","pinyin":"Tiānqì lěng qǐlái le.","vi":"Thời tiết bắt đầu trở lạnh.","wordIds":["w:天气","w:冷","w:起来","w:了"],"unitId":"l1-u42"},{"id":"s:l3:222","zh":"他忙起来就忘了吃饭。","pinyin":"Tā máng qǐlái jiù wàng le chīfàn.","vi":"Anh ấy hễ bận lên là quên ăn cơm.","wordIds":["w:他","w:忙","w:起来","w:就","w:忘","w:了","w:吃饭"],"unitId":"l1-u42"},{"id":"s:l3:236","zh":"我一看就明白了。","pinyin":"Wǒ yī kàn jiù míngbai le.","vi":"Tôi vừa nhìn là hiểu ngay.","wordIds":["w:我","w:一","w:看","w:就","w:明白","w:了"],"unitId":"l1-u42"}]}
