{"unit":{"id":"l1-u42","level":1,"order":42,"title":"More Actions","wordIds":["w:听见","w:试","w:包","w:差","w:干","w:一点儿","w:一块儿","w:一半","w:有用","w:没事儿","w:图书馆"],"grammarIds":["g:yidianr-quantity"],"sentenceIds":["s:l1:191","s:l1:192","s:l1:194","s:l1:193"]},"grammar":[{"id":"g:yidianr-quantity","title":"一点儿 for \"a little\"","pattern":"verb/adjective + 一点儿","explanation":"一点儿 (yìdiǎnr) means \"a little\" or \"a bit\". After an adjective, it softens a comparison or request: 慢一点儿 (\"a little slower\"), 大一点儿 (\"a bit bigger\"). After a verb like 要 or 会, it just means a small amount.","level":1,"sentenceIds":["s:l1:191","s:l1:192","s:l1:193","s:l1:194"],"unitId":"l1-u42"}],"sentences":[{"id":"s:l1:191","zh":"我要一点儿水。","pinyin":"Wǒ yào yìdiǎnr shuǐ.","en":"I'd like a little water.","wordIds":["w:我","w:要","w:一点儿","w:水"],"unitId":"l1-u42"},{"id":"s:l1:192","zh":"我会一点儿。","pinyin":"Wǒ huì yìdiǎnr.","en":"I know a little of it.","wordIds":["w:我","w:会","w:一点儿"],"unitId":"l1-u42"},{"id":"s:l1:194","zh":"这个大一点儿。","pinyin":"Zhège dà yìdiǎnr.","en":"This one is a bit bigger.","wordIds":["w:这","w:个","w:大","w:一点儿"],"unitId":"l1-u42"},{"id":"s:l1:193","zh":"慢一点儿。","pinyin":"Màn yìdiǎnr.","en":"A little slower.","wordIds":["w:慢","w:一点儿"],"unitId":"l1-u42"}]}
