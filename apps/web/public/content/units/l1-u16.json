{"unit":{"id":"l1-u16","level":1,"order":16,"title":"Ăn & Uống","wordIds":["w:吃","w:喝","w:水","w:茶","w:饭","w:菜","w:肉","w:吃饭","w:饿","w:渴","w:好吃","w:杯","w:了"],"grammarIds":["g:le-change","g:measure-bei","g:tai-le"],"sentenceIds":["s:l1:037","s:l1:038","s:l1:039","s:l1:040","s:l1:076","s:l1:113","s:l1:core:019","s:l1:core:020","s:l1:core:021","s:l1:core:022","s:l1:new:054","s:l3:135"]},"grammar":[{"id":"g:le-change","title":"了 cuối câu: thay đổi trạng thái","pattern":"Sentence + 了","explanation":"了 (le) đặt ở cuối câu cho biết một tình huống mới vừa xuất hiện hoặc trạng thái đã thay đổi, gần giống \"rồi\" trong tiếng Việt: 我饿了 (tôi đói rồi — lúc nãy chưa đói), 他十岁了 (cậu bé mười tuổi rồi). Không có 了 thì câu chỉ mô tả trạng thái như vốn có, không có ý thay đổi: 我很饿 chỉ là \"tôi rất đói\". Sau này bạn sẽ gặp nhiều câu cùng cách dùng, như 下雨了 (trời mưa rồi).","level":1,"sentenceIds":["s:l1:core:019","s:l1:core:020","s:l1:core:021","s:l1:core:022"],"unitId":"l1-u16"},{"id":"g:measure-bei","title":"杯 làm lượng từ cho đồ uống","pattern":"Number + 杯 + noun","explanation":"杯 (bēi) là lượng từ dùng cho cốc/ly đồ uống: 一杯水 (\"một cốc nước\"). Giống như 个, nó đứng giữa số đếm và danh từ, và bắt buộc phải có — không thể nói 一水.","level":1,"sentenceIds":["s:l1:112","s:l1:113","s:l1:114","s:l1:115"],"unitId":"l1-u16"},{"id":"g:tai-le","title":"太...了 nghĩa là \"quá\"","pattern":"太 + adjective + 了","explanation":"太 (tài) nghĩa là \"quá\" hay \"cực kỳ\", và thêm 了 ở cuối câu để nhấn mạnh mức độ. 太好了! là một câu cảm thán thông dụng nghĩa là \"Tuyệt quá!\", chứ không phải một lời phàn nàn theo nghĩa đen.","level":1,"sentenceIds":["s:l1:037","s:l1:038","s:l1:039","s:l1:040"],"unitId":"l1-u16"}],"sentences":[{"id":"s:l1:037","zh":"太好了！","pinyin":"Tài hǎo le!","vi":"Tuyệt quá!","wordIds":["w:太","w:好","w:了"],"unitId":"l1-u16"},{"id":"s:l1:038","zh":"这个太大了。","pinyin":"Zhège tài dà le.","vi":"Cái này to quá.","wordIds":["w:这","w:个","w:太","w:大","w:了"],"unitId":"l1-u16"},{"id":"s:l1:039","zh":"你太好了。","pinyin":"Nǐ tài hǎo le.","vi":"Bạn tốt quá.","wordIds":["w:你","w:太","w:好","w:了"],"unitId":"l1-u16"},{"id":"s:l1:040","zh":"我们太多了。","pinyin":"Wǒmen tài duō le.","vi":"Chúng ta đông quá.","wordIds":["w:我们","w:太","w:多","w:了"],"unitId":"l1-u16"},{"id":"s:l1:076","zh":"她三岁了。","pinyin":"Tā sān suì le.","vi":"Cô bé ba tuổi rồi.","wordIds":["w:她","w:三","w:岁","w:了"],"unitId":"l1-u16"},{"id":"s:l1:113","zh":"他有一杯。","pinyin":"Tā yǒu yì bēi.","vi":"Anh ấy có một cốc.","wordIds":["w:他","w:有","w:一","w:杯"],"unitId":"l1-u16"},{"id":"s:l1:core:019","zh":"我饿了。","pinyin":"Wǒ è le.","vi":"Tôi đói rồi.","wordIds":["w:我","w:饿","w:了"],"unitId":"l1-u16"},{"id":"s:l1:core:020","zh":"他十岁了。","pinyin":"Tā shí suì le.","vi":"Cậu bé mười tuổi rồi.","wordIds":["w:他","w:十","w:岁","w:了"],"unitId":"l1-u16"},{"id":"s:l1:core:021","zh":"我不渴了。","pinyin":"Wǒ bù kě le.","vi":"Tôi hết khát rồi.","wordIds":["w:我","w:不","w:渴","w:了"],"unitId":"l1-u16"},{"id":"s:l1:core:022","zh":"水没有了。","pinyin":"Shuǐ méiyǒu le.","vi":"Hết nước rồi.","wordIds":["w:水","w:没有","w:了"],"unitId":"l1-u16"},{"id":"s:l1:new:054","zh":"中午吃饭。","pinyin":"Zhōngwǔ chī fàn.","vi":"Buổi trưa ăn cơm.","wordIds":["w:中午","w:吃","w:饭"],"unitId":"l1-u16"},{"id":"s:l3:135","zh":"太晚了，我们去不了了。","pinyin":"Tài wǎn le, wǒmen qù bu liǎo le.","vi":"Muộn quá rồi, chúng tôi không thể đi được nữa.","wordIds":["w:太","w:晚","w:了","w:我们","w:去","w:不","w:了","w:了"],"unitId":"l1-u16"}]}
