{"unit":{"id":"l1-u16","level":1,"order":16,"title":"Unit 16","wordIds":["w:学","w:多少","w:第二","w:妈妈","w:错","w:少","w:别的","w:难","w:电影","w:间","w:哪","w:跑"],"grammarIds":["g:di-ordinal","g:duoshao-question"],"sentenceIds":["s:l1:096","s:l1:097","s:l1:098","s:l1:099","s:l1:100","s:l1:101","s:l1:102","s:l1:103","s:l1:111"]},"grammar":[{"id":"g:di-ordinal","title":"第 for ordinal numbers","pattern":"第 + number","explanation":"第 (dì) turns a plain number into an ordinal: 第二 (\"second\"), 第一 (\"first\"). Compare 两个 (\"two [things]\") with 第二个 (\"the second [thing]\") — the meaning changes completely once 第 is added.","level":1,"sentenceIds":["s:l1:100","s:l1:101","s:l1:102","s:l1:103"],"unitId":"l1-u16"},{"id":"g:duoshao-question","title":"多少 for \"how many/how much\"","pattern":"多少 + (measure word) + noun?","explanation":"多少 (duōshao) asks about quantity, especially larger numbers, prices, or amounts: 多少钱? (\"How much money?\"). Unlike 几, 多少 doesn't require a measure word before the noun, though one can still be added.","level":1,"sentenceIds":["s:l1:096","s:l1:097","s:l1:098","s:l1:099"],"unitId":"l1-u16"}],"sentences":[{"id":"s:l1:096","zh":"这个多少钱？","pinyin":"Zhège duōshao qián?","en":"How much is this?","wordIds":["w:这","w:个","w:多少","w:钱"],"unitId":"l1-u16"},{"id":"s:l1:097","zh":"你们有多少人？","pinyin":"Nǐmen yǒu duōshao rén?","en":"How many people do you have?","wordIds":["w:你们","w:有","w:多少","w:人"],"unitId":"l1-u16"},{"id":"s:l1:098","zh":"你要多少？","pinyin":"Nǐ yào duōshao?","en":"How much do you want?","wordIds":["w:你","w:要","w:多少"],"unitId":"l1-u16"},{"id":"s:l1:099","zh":"你想要多少个？","pinyin":"Nǐ xiǎng yào duōshao gè?","en":"How many would you like?","wordIds":["w:你","w:想","w:要","w:多少","w:个"],"unitId":"l1-u16"},{"id":"s:l1:100","zh":"这是第二个。","pinyin":"Zhè shì dì èr gè.","en":"This is the second one.","wordIds":["w:这","w:是","w:第二","w:个"],"unitId":"l1-u16"},{"id":"s:l1:101","zh":"他是第二。","pinyin":"Tā shì dì èr.","en":"He is second.","wordIds":["w:他","w:是","w:第二"],"unitId":"l1-u16"},{"id":"s:l1:102","zh":"我先看第二个。","pinyin":"Wǒ xiān kàn dì èr gè.","en":"I'll look at the second one first.","wordIds":["w:我","w:先","w:看","w:第二","w:个"],"unitId":"l1-u16"},{"id":"s:l1:103","zh":"那个是第二。","pinyin":"Nàge shì dì èr.","en":"That one is second.","wordIds":["w:那","w:个","w:是","w:第二"],"unitId":"l1-u16"},{"id":"s:l1:111","zh":"这是第二个，不是两个。","pinyin":"Zhè shì dì èr gè, bú shì liǎng gè.","en":"This is the second one, not two of them.","wordIds":["w:这","w:是","w:第二","w:个","w:不","w:是","w:两","w:个"],"unitId":"l1-u16"}]}
