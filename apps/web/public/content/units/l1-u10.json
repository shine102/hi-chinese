{"unit":{"id":"l1-u10","level":1,"order":10,"title":"Unit 10","wordIds":["w:孩子","w:这里","w:别","w:请","w:钱","w:本","w:回","w:东西","w:三","w:一样","w:买","w:重要"],"grammarIds":["g:bie-prohibition","g:jiao-naming"],"sentenceIds":["s:l1:065","s:l1:066","s:l1:067","s:l1:068","s:l1:069","s:l1:070","s:l1:071","s:l1:072"]},"grammar":[{"id":"g:bie-prohibition","title":"别 for telling someone not to","pattern":"别 + verb (+ object)","explanation":"别 (bié) means \"don't\" and goes right before the verb, giving a direct instruction. Adding 了 at the end, as in 别说了, softens it to \"stop doing that\" rather than a flat prohibition.","level":1,"sentenceIds":["s:l1:065","s:l1:066","s:l1:067","s:l1:068"],"unitId":"l1-u10"},{"id":"g:jiao-naming","title":"叫 for names and calling out","pattern":"Subject + 叫 + name/word","explanation":"叫 (jiào) means \"to be called\" when introducing a name, and \"to call out to\" when the object is a person. 他叫什么? asks what someone or something is called.","level":1,"sentenceIds":["s:l1:061","s:l1:062","s:l1:063","s:l1:064"],"unitId":"l1-u10"}],"sentences":[{"id":"s:l1:065","zh":"别说了。","pinyin":"Bié shuō le.","en":"Stop talking.","wordIds":["w:别","w:说","w:了"],"unitId":"l1-u10"},{"id":"s:l1:066","zh":"别去。","pinyin":"Bié qù.","en":"Don't go.","wordIds":["w:别","w:去"],"unitId":"l1-u10"},{"id":"s:l1:067","zh":"别买这个。","pinyin":"Bié mǎi zhège.","en":"Don't buy this one.","wordIds":["w:别","w:买","w:这","w:个"],"unitId":"l1-u10"},{"id":"s:l1:068","zh":"你别想了。","pinyin":"Nǐ bié xiǎng le.","en":"Stop thinking about it.","wordIds":["w:你","w:别","w:想","w:了"],"unitId":"l1-u10"},{"id":"s:l1:069","zh":"请说。","pinyin":"Qǐng shuō.","en":"Please speak.","wordIds":["w:请","w:说"],"unitId":"l1-u10"},{"id":"s:l1:070","zh":"请你来。","pinyin":"Qǐng nǐ lái.","en":"Please come.","wordIds":["w:请","w:你","w:来"],"unitId":"l1-u10"},{"id":"s:l1:071","zh":"请给我。","pinyin":"Qǐng gěi wǒ.","en":"Please give it to me.","wordIds":["w:请","w:给","w:我"],"unitId":"l1-u10"},{"id":"s:l1:072","zh":"请看这个。","pinyin":"Qǐng kàn zhège.","en":"Please look at this.","wordIds":["w:请","w:看","w:这","w:个"],"unitId":"l1-u10"}]}
