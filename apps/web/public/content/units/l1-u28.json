{"unit":{"id":"l1-u28","level":1,"order":28,"title":"Coming & Going","wordIds":["w:来","w:去","w:回","w:回来","w:回去","w:回家","w:出","w:出来","w:出去","w:进","w:进来","w:进去"],"grammarIds":["g:neng-ability","g:time-of-day","g:xiangdui-shijian"],"sentenceIds":["s:l1:014","s:l1:221","s:l1:070","s:l1:013","s:l1:015","s:l1:new:042","s:l1:092","s:l1:158","s:l1:new:052","s:l1:new:053","s:l1:new:055","s:l1:199","s:l1:094","s:l1:159","s:l1:044","s:l1:168","s:l1:035","s:l1:204","s:l1:053","s:l1:054","s:l1:016","s:l1:047","s:l1:021","s:l1:024","s:l1:206","s:l1:203","s:l1:150","s:l1:175","s:l1:132","s:l1:134","s:l1:080"]},"grammar":[{"id":"g:neng-ability","title":"能 for ability or permission","pattern":"Subject + 能 + verb","explanation":"能 (néng) means \"can\" — able to do something because of ability, permission, or circumstance. It goes directly before the verb. Negate it with 不能 (bù néng), \"cannot\".","level":1,"sentenceIds":["s:l1:013","s:l1:014","s:l1:015","s:l1:016"],"unitId":"l1-u28"},{"id":"g:time-of-day","title":"Telling time with 点 and 分","pattern":"number + 点 (+ number + 分)","explanation":"点 (diǎn) marks the hour and 分 (fēn) marks minutes: 三点 (3 o'clock), 三点十分 (3:10). Time goes before the verb: 我早上来 (I come in the morning).","level":1,"sentenceIds":["s:l1:new:052","s:l1:new:053"],"unitId":"l1-u28"},{"id":"g:xiangdui-shijian","title":"The five relative day words","pattern":"前天 / 昨天 / 今天 / 明天 / 后天","explanation":"Chinese has a tidy set of words for days relative to today: 前天 (\"the day before yesterday\"), 昨天 (\"yesterday\"), 今天 (\"today\"), 明天 (\"tomorrow\"), 后天 (\"the day after tomorrow\"). Like other time words, they go at the start of the sentence or right after the subject.","level":1,"sentenceIds":["s:l1:203","s:l1:204","s:l1:205","s:l1:206"],"unitId":"l1-u28"}],"sentences":[{"id":"s:l1:014","zh":"他不能来。","pinyin":"Tā bù néng lái.","en":"He can't come.","wordIds":["w:他","w:不","w:能","w:来"],"unitId":"l1-u28"},{"id":"s:l1:221","zh":"他不大想去。","pinyin":"Tā bú dà xiǎng qù.","en":"He doesn't really want to go.","wordIds":["w:他","w:不","w:大","w:想","w:去"],"unitId":"l1-u28"},{"id":"s:l1:070","zh":"请你来。","pinyin":"Qǐng nǐ lái.","en":"Please come.","wordIds":["w:请","w:你","w:来"],"unitId":"l1-u28"},{"id":"s:l1:013","zh":"我能去。","pinyin":"Wǒ néng qù.","en":"I can go.","wordIds":["w:我","w:能","w:去"],"unitId":"l1-u28"},{"id":"s:l1:015","zh":"你能来。","pinyin":"Nǐ néng lái.","en":"You can come.","wordIds":["w:你","w:能","w:来"],"unitId":"l1-u28"},{"id":"s:l1:new:042","zh":"他去医院看病。","pinyin":"Tā qù yīyuàn kàn bìng.","en":"He goes to the hospital to see a doctor.","wordIds":["w:他","w:去","w:医院","w:看病"],"unitId":"l1-u28"},{"id":"s:l1:092","zh":"明天我去。","pinyin":"Míngtiān wǒ qù.","en":"Tomorrow I'll go.","wordIds":["w:明天","w:我","w:去"],"unitId":"l1-u28"},{"id":"s:l1:158","zh":"我星期一去。","pinyin":"Wǒ xīngqī yī qù.","en":"I'm going on Monday.","wordIds":["w:我","w:星期","w:一","w:去"],"unitId":"l1-u28"},{"id":"s:l1:new:052","zh":"我早上来。","pinyin":"Wǒ zǎoshang lái.","en":"I come in the morning.","wordIds":["w:我","w:早上","w:来"],"unitId":"l1-u28"},{"id":"s:l1:new:053","zh":"他下午去。","pinyin":"Tā xiàwǔ qù.","en":"He goes in the afternoon.","wordIds":["w:他","w:下午","w:去"],"unitId":"l1-u28"},{"id":"s:l1:new:055","zh":"白天来，晚上去。","pinyin":"Báitiān lái, wǎnshang qù.","en":"Come during the day, go in the evening.","wordIds":["w:白天","w:来","w:晚上","w:去"],"unitId":"l1-u28"},{"id":"s:l1:199","zh":"你去哪儿？","pinyin":"Nǐ qù nǎr?","en":"Where are you going?","wordIds":["w:你","w:去","w:哪儿"],"unitId":"l1-u28"},{"id":"s:l1:094","zh":"我明天回来。","pinyin":"Wǒ míngtiān huílai.","en":"I'll come back tomorrow.","wordIds":["w:我","w:明天","w:回来"],"unitId":"l1-u28"},{"id":"s:l1:159","zh":"他星期五回来。","pinyin":"Tā xīngqī wǔ huílai.","en":"He's coming back on Friday.","wordIds":["w:他","w:星期","w:五","w:回来"],"unitId":"l1-u28"},{"id":"s:l1:044","zh":"我最想去。","pinyin":"Wǒ zuì xiǎng qù.","en":"I want to go the most.","wordIds":["w:我","w:最","w:想","w:去"],"unitId":"l1-u28"},{"id":"s:l1:168","zh":"你们去哪儿？","pinyin":"Nǐmen qù nǎr?","en":"Where are you all going?","wordIds":["w:你们","w:去","w:哪儿"],"unitId":"l1-u28"},{"id":"s:l1:035","zh":"你想去吗？","pinyin":"Nǐ xiǎng qù ma?","en":"Do you want to go?","wordIds":["w:你","w:想","w:去","w:吗"],"unitId":"l1-u28"},{"id":"s:l1:204","zh":"后天你来吗？","pinyin":"Hòutiān nǐ lái ma?","en":"Are you coming the day after tomorrow?","wordIds":["w:后天","w:你","w:来","w:吗"],"unitId":"l1-u28"},{"id":"s:l1:053","zh":"我跟你去。","pinyin":"Wǒ gēn nǐ qù.","en":"I'll go with you.","wordIds":["w:我","w:跟","w:你","w:去"],"unitId":"l1-u28"},{"id":"s:l1:054","zh":"他跟谁去？","pinyin":"Tā gēn shéi qù?","en":"Who is he going with?","wordIds":["w:他","w:跟","w:谁","w:去"],"unitId":"l1-u28"},{"id":"s:l1:016","zh":"我们都能去。","pinyin":"Wǒmen dōu néng qù.","en":"We can all go.","wordIds":["w:我们","w:都","w:能","w:去"],"unitId":"l1-u28"},{"id":"s:l1:047","zh":"我们都想去，他呢？","pinyin":"Wǒmen dōu xiǎng qù, tā ne?","en":"We all want to go, what about him?","wordIds":["w:我们","w:都","w:想","w:去","w:他","w:呢"],"unitId":"l1-u28"},{"id":"s:l1:021","zh":"我没去。","pinyin":"Wǒ méi qù.","en":"I didn't go.","wordIds":["w:我","w:没","w:去"],"unitId":"l1-u28"},{"id":"s:l1:024","zh":"你没来。","pinyin":"Nǐ méi lái.","en":"You didn't come.","wordIds":["w:你","w:没","w:来"],"unitId":"l1-u28"},{"id":"s:l1:206","zh":"前天他没来，后天他能来。","pinyin":"Qiántiān tā méi lái, hòutiān tā néng lái.","en":"He didn't come the day before yesterday, but he can come the day after tomorrow.","wordIds":["w:前天","w:他","w:没","w:来","w:后天","w:他","w:能","w:来"],"unitId":"l1-u28"},{"id":"s:l1:203","zh":"前天我没去。","pinyin":"Qiántiān wǒ méi qù.","en":"I didn't go the day before yesterday.","wordIds":["w:前天","w:我","w:没","w:去"],"unitId":"l1-u28"},{"id":"s:l1:150","zh":"我们最好去。","pinyin":"Wǒmen zuìhǎo qù.","en":"We'd better go.","wordIds":["w:我们","w:最好","w:去"],"unitId":"l1-u28"},{"id":"s:l1:175","zh":"下次你来。","pinyin":"Xiàcì nǐ lái.","en":"Come next time.","wordIds":["w:下次","w:你","w:来"],"unitId":"l1-u28"},{"id":"s:l1:132","zh":"我常去。","pinyin":"Wǒ cháng qù.","en":"I often go.","wordIds":["w:我","w:常","w:去"],"unitId":"l1-u28"},{"id":"s:l1:134","zh":"你常常来吗？","pinyin":"Nǐ chángcháng lái ma?","en":"Do you often come?","wordIds":["w:你","w:常常","w:来","w:吗"],"unitId":"l1-u28"},{"id":"s:l1:080","zh":"我们先去这里。","pinyin":"Wǒmen xiān qù zhèlǐ.","en":"Let's go here first.","wordIds":["w:我们","w:先","w:去","w:这里"],"unitId":"l1-u28"}]}
