{"unit":{"id":"l1-u28","level":1,"order":28,"title":"Unit 28","wordIds":["w:考试","w:有时候","w:慢","w:旁边","w:同学","w:北","w:帮忙","w:进来","w:见面","w:好看","w:中间","w:女生"],"grammarIds":["g:pangbian-location"],"sentenceIds":["s:l1:142","s:l1:153","s:l1:154","s:l1:155","s:l1:156"]},"grammar":[{"id":"g:pangbian-location","title":"旁边 and 中间 for relative position","pattern":"Noun + 旁边 / 中间","explanation":"旁边 (pángbiān, \"next to/beside\") and 中间 (zhōngjiān, \"in the middle\") describe where something is relative to something else. Combine them with 在: 他在我旁边 (\"He's next to me\").","level":1,"sentenceIds":["s:l1:153","s:l1:154","s:l1:155","s:l1:156"],"unitId":"l1-u28"}],"sentences":[{"id":"s:l1:142","zh":"我们明天见面。","pinyin":"Wǒmen míngtiān jiànmiàn.","en":"Let's meet tomorrow.","wordIds":["w:我们","w:明天","w:见面"],"unitId":"l1-u28"},{"id":"s:l1:153","zh":"他在我旁边。","pinyin":"Tā zài wǒ pángbiān.","en":"He is next to me.","wordIds":["w:他","w:在","w:我","w:旁边"],"unitId":"l1-u28"},{"id":"s:l1:154","zh":"我家旁边有学校。","pinyin":"Wǒ jiā pángbiān yǒu xuéxiào.","en":"There's a school next to my house.","wordIds":["w:我","w:家","w:旁边","w:有","w:学校"],"unitId":"l1-u28"},{"id":"s:l1:155","zh":"你在中间。","pinyin":"Nǐ zài zhōngjiān.","en":"You're in the middle.","wordIds":["w:你","w:在","w:中间"],"unitId":"l1-u28"},{"id":"s:l1:156","zh":"我们的车在中间。","pinyin":"Wǒmen de chē zài zhōngjiān.","en":"Our car is in the middle.","wordIds":["w:我们","w:的","w:车","w:在","w:中间"],"unitId":"l1-u28"}]}
