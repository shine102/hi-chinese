{"unit":{"id":"l1-u28","level":1,"order":28,"title":"Coming & Going","wordIds":["w:来","w:去","w:回","w:回来","w:回去","w:回家","w:出","w:出来","w:出去","w:进","w:进来","w:进去"],"grammarIds":["g:neng-ability","g:time-of-day","g:xiangdui-shijian"],"sentenceIds":["s:l1:013","s:l1:014","s:l1:015","s:l1:016","s:l1:021","s:l1:024","s:l1:035","s:l1:044","s:l1:047","s:l1:053","s:l1:054","s:l1:070","s:l1:080","s:l1:092","s:l1:094","s:l1:132","s:l1:134","s:l1:150","s:l1:158","s:l1:159","s:l1:168","s:l1:175","s:l1:199","s:l1:203","s:l1:204","s:l1:206","s:l1:221","s:l1:new:042","s:l1:new:052","s:l1:new:053","s:l1:new:055"]},"grammar":[{"id":"g:neng-ability","title":"能 nghĩa là \"có thể\" (khả năng hoặc sự cho phép)","pattern":"Subject + 能 + verb","explanation":"能 (néng) nghĩa là \"có thể\" — làm được việc gì đó nhờ khả năng, được cho phép, hoặc do hoàn cảnh cho phép. 能 đứng ngay trước động từ. Phủ định bằng 不能 (bù néng), nghĩa là \"không thể\".","level":1,"sentenceIds":["s:l1:013","s:l1:014","s:l1:015","s:l1:016"],"unitId":"l1-u28"},{"id":"g:time-of-day","title":"Nói giờ với 点 và 分","pattern":"number + 点 (+ number + 分)","explanation":"点 (diǎn) đánh dấu giờ và 分 (fēn) đánh dấu phút: 三点 (3 giờ), 三点十分 (3 giờ 10 phút). Từ chỉ thời gian đứng trước động từ: 我早上来 (Tôi đến vào buổi sáng).","level":1,"sentenceIds":["s:l1:new:052","s:l1:new:053"],"unitId":"l1-u28"},{"id":"g:xiangdui-shijian","title":"Năm từ chỉ ngày tương đối","pattern":"前天 / 昨天 / 今天 / 明天 / 后天","explanation":"Tiếng Trung có một bộ từ gọn gàng để chỉ các ngày so với hôm nay: 前天 (\"hôm kia\"), 昨天 (\"hôm qua\"), 今天 (\"hôm nay\"), 明天 (\"ngày mai\"), 后天 (\"ngày kia\"). Giống như các từ chỉ thời gian khác, chúng đứng ở đầu câu hoặc ngay sau chủ ngữ.","level":1,"sentenceIds":["s:l1:203","s:l1:204","s:l1:205","s:l1:206"],"unitId":"l1-u28"}],"sentences":[{"id":"s:l1:013","zh":"我能去。","pinyin":"Wǒ néng qù.","vi":"Tôi có thể đi.","wordIds":["w:我","w:能","w:去"],"unitId":"l1-u28"},{"id":"s:l1:014","zh":"他不能来。","pinyin":"Tā bù néng lái.","vi":"Anh ấy không thể đến.","wordIds":["w:他","w:不","w:能","w:来"],"unitId":"l1-u28"},{"id":"s:l1:015","zh":"你能来。","pinyin":"Nǐ néng lái.","vi":"Bạn có thể đến.","wordIds":["w:你","w:能","w:来"],"unitId":"l1-u28"},{"id":"s:l1:016","zh":"我们都能去。","pinyin":"Wǒmen dōu néng qù.","vi":"Chúng tôi đều có thể đi.","wordIds":["w:我们","w:都","w:能","w:去"],"unitId":"l1-u28"},{"id":"s:l1:021","zh":"我没去。","pinyin":"Wǒ méi qù.","vi":"Tôi đã không đi.","wordIds":["w:我","w:没","w:去"],"unitId":"l1-u28"},{"id":"s:l1:024","zh":"你没来。","pinyin":"Nǐ méi lái.","vi":"Bạn đã không đến.","wordIds":["w:你","w:没","w:来"],"unitId":"l1-u28"},{"id":"s:l1:035","zh":"你想去吗？","pinyin":"Nǐ xiǎng qù ma?","vi":"Bạn có muốn đi không?","wordIds":["w:你","w:想","w:去","w:吗"],"unitId":"l1-u28"},{"id":"s:l1:044","zh":"我最想去。","pinyin":"Wǒ zuì xiǎng qù.","vi":"Tôi muốn đi nhất.","wordIds":["w:我","w:最","w:想","w:去"],"unitId":"l1-u28"},{"id":"s:l1:047","zh":"我们都想去，他呢？","pinyin":"Wǒmen dōu xiǎng qù, tā ne?","vi":"Chúng tôi đều muốn đi, còn anh ấy thì sao?","wordIds":["w:我们","w:都","w:想","w:去","w:他","w:呢"],"unitId":"l1-u28"},{"id":"s:l1:053","zh":"我跟你去。","pinyin":"Wǒ gēn nǐ qù.","vi":"Tôi đi cùng bạn.","wordIds":["w:我","w:跟","w:你","w:去"],"unitId":"l1-u28"},{"id":"s:l1:054","zh":"他跟谁去？","pinyin":"Tā gēn shéi qù?","vi":"Anh ấy đi cùng ai?","wordIds":["w:他","w:跟","w:谁","w:去"],"unitId":"l1-u28"},{"id":"s:l1:070","zh":"请你来。","pinyin":"Qǐng nǐ lái.","vi":"Mời bạn đến.","wordIds":["w:请","w:你","w:来"],"unitId":"l1-u28"},{"id":"s:l1:080","zh":"我们先去这里。","pinyin":"Wǒmen xiān qù zhèlǐ.","vi":"Chúng ta đến đây trước.","wordIds":["w:我们","w:先","w:去","w:这里"],"unitId":"l1-u28"},{"id":"s:l1:092","zh":"明天我去。","pinyin":"Míngtiān wǒ qù.","vi":"Ngày mai tôi đi.","wordIds":["w:明天","w:我","w:去"],"unitId":"l1-u28"},{"id":"s:l1:094","zh":"我明天回来。","pinyin":"Wǒ míngtiān huílai.","vi":"Ngày mai tôi sẽ quay lại.","wordIds":["w:我","w:明天","w:回来"],"unitId":"l1-u28"},{"id":"s:l1:132","zh":"我常去。","pinyin":"Wǒ cháng qù.","vi":"Tôi thường đi.","wordIds":["w:我","w:常","w:去"],"unitId":"l1-u28"},{"id":"s:l1:134","zh":"你常常来吗？","pinyin":"Nǐ chángcháng lái ma?","vi":"Bạn có thường đến không?","wordIds":["w:你","w:常常","w:来","w:吗"],"unitId":"l1-u28"},{"id":"s:l1:150","zh":"我们最好去。","pinyin":"Wǒmen zuìhǎo qù.","vi":"Tốt nhất là chúng ta nên đi.","wordIds":["w:我们","w:最好","w:去"],"unitId":"l1-u28"},{"id":"s:l1:158","zh":"我星期一去。","pinyin":"Wǒ xīngqī yī qù.","vi":"Tôi đi vào thứ Hai.","wordIds":["w:我","w:星期","w:一","w:去"],"unitId":"l1-u28"},{"id":"s:l1:159","zh":"他星期五回来。","pinyin":"Tā xīngqī wǔ huílai.","vi":"Anh ấy về vào thứ Sáu.","wordIds":["w:他","w:星期","w:五","w:回来"],"unitId":"l1-u28"},{"id":"s:l1:168","zh":"你们去哪儿？","pinyin":"Nǐmen qù nǎr?","vi":"Các bạn đi đâu?","wordIds":["w:你们","w:去","w:哪儿"],"unitId":"l1-u28"},{"id":"s:l1:175","zh":"下次你来。","pinyin":"Xiàcì nǐ lái.","vi":"Lần sau bạn đến nhé.","wordIds":["w:下次","w:你","w:来"],"unitId":"l1-u28"},{"id":"s:l1:199","zh":"你去哪儿？","pinyin":"Nǐ qù nǎr?","vi":"Bạn đi đâu?","wordIds":["w:你","w:去","w:哪儿"],"unitId":"l1-u28"},{"id":"s:l1:203","zh":"前天我没去。","pinyin":"Qiántiān wǒ méi qù.","vi":"Hôm kia tôi đã không đi.","wordIds":["w:前天","w:我","w:没","w:去"],"unitId":"l1-u28"},{"id":"s:l1:204","zh":"后天你来吗？","pinyin":"Hòutiān nǐ lái ma?","vi":"Ngày kia bạn có đến không?","wordIds":["w:后天","w:你","w:来","w:吗"],"unitId":"l1-u28"},{"id":"s:l1:206","zh":"前天他没来，后天他能来。","pinyin":"Qiántiān tā méi lái, hòutiān tā néng lái.","vi":"Hôm kia anh ấy đã không đến, nhưng ngày kia anh ấy có thể đến.","wordIds":["w:前天","w:他","w:没","w:来","w:后天","w:他","w:能","w:来"],"unitId":"l1-u28"},{"id":"s:l1:221","zh":"他不大想去。","pinyin":"Tā bú dà xiǎng qù.","vi":"Anh ấy không muốn đi lắm.","wordIds":["w:他","w:不","w:大","w:想","w:去"],"unitId":"l1-u28"},{"id":"s:l1:new:042","zh":"他去医院看病。","pinyin":"Tā qù yīyuàn kàn bìng.","vi":"Anh ấy đến bệnh viện khám bệnh.","wordIds":["w:他","w:去","w:医院","w:看病"],"unitId":"l1-u28"},{"id":"s:l1:new:052","zh":"我早上来。","pinyin":"Wǒ zǎoshang lái.","vi":"Tôi đến vào buổi sáng.","wordIds":["w:我","w:早上","w:来"],"unitId":"l1-u28"},{"id":"s:l1:new:053","zh":"他下午去。","pinyin":"Tā xiàwǔ qù.","vi":"Anh ấy đi vào buổi chiều.","wordIds":["w:他","w:下午","w:去"],"unitId":"l1-u28"},{"id":"s:l1:new:055","zh":"白天来，晚上去。","pinyin":"Báitiān lái, wǎnshang qù.","vi":"Ban ngày đến, buổi tối đi.","wordIds":["w:白天","w:来","w:晚上","w:去"],"unitId":"l1-u28"}]}
