{"unit":{"id":"l1-u28","level":1,"order":28,"title":"Đi & Về","wordIds":["w:回来","w:回去","w:回家","w:出","w:出来","w:出去","w:进来","w:进去"],"grammarIds":["g:lai-qu-direction"],"sentenceIds":["s:l1:094","s:l1:159","s:l1:core:043","s:l1:core:044","s:l1:core:045","s:l1:core:046","s:l1:fill:153","s:l1:fill:154","s:l1:fill:155"]},"grammar":[{"id":"g:lai-qu-direction","title":"Bổ ngữ xu hướng 来/去","pattern":"verb + 来/去 (回来, 出去, 进来)","explanation":"来 và 去 đặt sau các động từ chỉ hướng như 回, 出, 进 để cho biết hướng di chuyển so với người nói: 来 là về phía người nói, 去 là rời xa người nói. Người đang ở trong nhà nói 进来 (vào đây) và 出去 (ra ngoài), còn người ở bên ngoài thì nói 进去 và 出来. Tương tự, 回来 là về lại chỗ người nói đang ở, còn 回去 là quay về chỗ của mình (nhà, quê…), rời xa chỗ người nói. Trong các cụm này 来/去 thường đọc nhẹ: huílai, chūqu, jìnlai.","level":1,"sentenceIds":["s:l1:core:043","s:l1:core:044","s:l1:core:045","s:l1:core:046"],"unitId":"l1-u28"}],"sentences":[{"id":"s:l1:094","zh":"我明天回来。","pinyin":"Wǒ míngtiān huílai.","vi":"Ngày mai tôi sẽ quay lại.","wordIds":["w:我","w:明天","w:回来"],"unitId":"l1-u28"},{"id":"s:l1:159","zh":"他星期五回来。","pinyin":"Tā xīngqī wǔ huílai.","vi":"Anh ấy về vào thứ Sáu.","wordIds":["w:他","w:星期","w:五","w:回来"],"unitId":"l1-u28"},{"id":"s:l1:core:043","zh":"你什么时候回来？","pinyin":"Nǐ shénme shíhou huílai?","vi":"Khi nào bạn về?","wordIds":["w:你","w:什么","w:时候","w:回来"],"unitId":"l1-u28"},{"id":"s:l1:core:044","zh":"妈妈，我回来了！","pinyin":"Māma, wǒ huílai le!","vi":"Mẹ ơi, con về rồi!","wordIds":["w:妈妈","w:我","w:回来","w:了"],"unitId":"l1-u28"},{"id":"s:l1:core:045","zh":"他出去了。","pinyin":"Tā chūqu le.","vi":"Anh ấy ra ngoài rồi.","wordIds":["w:他","w:出去","w:了"],"unitId":"l1-u28"},{"id":"s:l1:core:046","zh":"请进来坐。","pinyin":"Qǐng jìnlai zuò.","vi":"Mời vào ngồi.","wordIds":["w:请","w:进来","w:坐"],"unitId":"l1-u28"},{"id":"s:l1:fill:153","zh":"我不想回去。","pinyin":"Wǒ bù xiǎng huíqu.","vi":"Tôi không muốn về.","wordIds":["w:我","w:不","w:想","w:回去"],"unitId":"l1-u28"},{"id":"s:l1:fill:154","zh":"你出来一下儿。","pinyin":"Nǐ chūlái yíxiàr.","vi":"Bạn ra đây một chút.","wordIds":["w:你","w:出来","w:一下儿"],"unitId":"l1-u28"},{"id":"s:l1:fill:155","zh":"你们先进去。","pinyin":"Nǐmen xiān jìnqù.","vi":"Các bạn vào trước đi.","wordIds":["w:你们","w:先","w:进去"],"unitId":"l1-u28"}]}
