{"unit":{"id":"l1-u13","level":1,"order":13,"title":"Unit 13","wordIds":["w:电话","w:女","w:送","w:分","w:笑","w:女人","w:小时","w:有些","w:帮","w:日","w:别人","w:站"],"grammarIds":["g:bang-help"],"sentenceIds":["s:l1:081","s:l1:082","s:l1:083","s:l1:084"]},"grammar":[{"id":"g:bang-help","title":"帮 for helping someone","pattern":"Subject + 帮 + person (+ verb)","explanation":"帮 (bāng) means \"to help\". Put it before the person being helped, and optionally follow with a verb to say what the help is for: 他帮我们找 (\"He's helping us look\").","level":1,"sentenceIds":["s:l1:081","s:l1:082","s:l1:083","s:l1:084"],"unitId":"l1-u13"}],"sentences":[{"id":"s:l1:081","zh":"我帮你。","pinyin":"Wǒ bāng nǐ.","en":"I'll help you.","wordIds":["w:我","w:帮","w:你"],"unitId":"l1-u13"},{"id":"s:l1:082","zh":"他帮我们找。","pinyin":"Tā bāng wǒmen zhǎo.","en":"He's helping us look for it.","wordIds":["w:他","w:帮","w:我们","w:找"],"unitId":"l1-u13"},{"id":"s:l1:083","zh":"你能帮我吗？","pinyin":"Nǐ néng bāng wǒ ma?","en":"Can you help me?","wordIds":["w:你","w:能","w:帮","w:我","w:吗"],"unitId":"l1-u13"},{"id":"s:l1:084","zh":"请你帮他。","pinyin":"Qǐng nǐ bāng tā.","en":"Please help him.","wordIds":["w:请","w:你","w:帮","w:他"],"unitId":"l1-u13"}]}
