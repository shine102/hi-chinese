{"unit":{"id":"l1-u13","level":1,"order":13,"title":"Technology","wordIds":["w:电话","w:手机","w:电脑","w:电视","w:电","w:电影","w:电视机","w:电影院","w:打电话","w:上网","w:网上","w:网友"],"grammarIds":["g:gei-dianhua"],"sentenceIds":["s:l1:136","s:l1:138","s:l1:139"]},"grammar":[{"id":"g:gei-dianhua","title":"给...打电话 for calling someone","pattern":"给 + person + 打电话","explanation":"打电话 (dǎ diànhuà) means \"to make a phone call\". To say who you're calling, insert 给 + person right before it: 我给你打电话 (\"I'll call you\"). Don't put the person directly before 打电话 without 给.","level":1,"sentenceIds":["s:l1:136","s:l1:137","s:l1:138","s:l1:139"],"unitId":"l1-u13"}],"sentences":[{"id":"s:l1:136","zh":"我给你打电话。","pinyin":"Wǒ gěi nǐ dǎ diànhuà.","en":"I'll call you.","wordIds":["w:我","w:给","w:你","w:打电话"],"unitId":"l1-u13"},{"id":"s:l1:138","zh":"请给我打电话。","pinyin":"Qǐng gěi wǒ dǎ diànhuà.","en":"Please call me.","wordIds":["w:请","w:给","w:我","w:打电话"],"unitId":"l1-u13"},{"id":"s:l1:139","zh":"你给谁打电话？","pinyin":"Nǐ gěi shéi dǎ diànhuà?","en":"Who are you calling?","wordIds":["w:你","w:给","w:谁","w:打电话"],"unitId":"l1-u13"}]}
