{"unit":{"id":"l2-u14","level":2,"order":56,"title":"Unit 14","wordIds":["w:刚刚","w:正常","w:黑","w:店","w:服务","w:想到","w:行为","w:挺","w:好像","w:克","w:愿意","w:装"],"grammarIds":["g:haoxiang-seems","g:tinghao-pretty-good"],"sentenceIds":["s:l2:097","s:l2:098","s:l2:099","s:l2:100","s:l2:341","s:l2:342","s:l2:343","s:l2:344"]},"grammar":[{"id":"g:haoxiang-seems","title":"Phỏng đoán với 好像","pattern":"好像 + clause","explanation":"好像 (hǎoxiàng) nghĩa là \"hình như, dường như\" — dùng khi bạn không hoàn toàn chắc chắn, dựa trên những gì mình thấy hoặc cảm nhận.","level":2,"sentenceIds":["s:l2:097","s:l2:098","s:l2:099","s:l2:100"],"unitId":"l2-u14"},{"id":"g:tinghao-pretty-good","title":"Khen ngợi thân mật với 挺...的","pattern":"挺 + adjective (+ 的)","explanation":"挺 (tǐng) nghĩa là \"khá, tương đối\" giống 很 nhưng mang tính khẩu ngữ hơn, và thường đi cùng 的 ở cuối câu: 挺好的 (khá tốt).","level":2,"sentenceIds":["s:l2:341","s:l2:342","s:l2:343","s:l2:344"],"unitId":"l2-u14"}],"sentences":[{"id":"s:l2:097","zh":"他好像不高兴。","pinyin":"Tā hǎoxiàng bù gāoxìng.","vi":"Anh ấy hình như không vui.","wordIds":["w:他","w:好像","w:不","w:高兴"],"unitId":"l2-u14"},{"id":"s:l2:098","zh":"外边好像下雨了。","pinyin":"Wàibian hǎoxiàng xiàyǔ le.","vi":"Bên ngoài hình như trời đang mưa.","wordIds":["w:外边","w:好像","w:下雨","w:了"],"unitId":"l2-u14"},{"id":"s:l2:099","zh":"这个人我好像认识。","pinyin":"Zhège rén wǒ hǎoxiàng rènshi.","vi":"Người này tôi hình như có quen.","wordIds":["w:这","w:个","w:人","w:我","w:好像","w:认识"],"unitId":"l2-u14"},{"id":"s:l2:100","zh":"他好像不愿意去。","pinyin":"Tā hǎoxiàng bú yuànyì qù.","vi":"Anh ấy hình như không muốn đi.","wordIds":["w:他","w:好像","w:不","w:愿意","w:去"],"unitId":"l2-u14"},{"id":"s:l2:341","zh":"这个电影挺好的。","pinyin":"Zhège diànyǐng tǐng hǎo de.","vi":"Bộ phim này khá hay.","wordIds":["w:这","w:个","w:电影","w:挺","w:好","w:的"],"unitId":"l2-u14"},{"id":"s:l2:342","zh":"他挺高兴的。","pinyin":"Tā tǐng gāoxìng de.","vi":"Anh ấy khá vui.","wordIds":["w:他","w:挺","w:高兴","w:的"],"unitId":"l2-u14"},{"id":"s:l2:343","zh":"今天天