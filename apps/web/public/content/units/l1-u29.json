{"unit":{"id":"l1-u29","level":1,"order":29,"title":"Unit 29","wordIds":["w:茶","w:地点","w:雨","w:星期","w:车上","w:考","w:九","w:妹妹","w:生气","w:地上","w:上午","w:一会儿"],"grammarIds":["g:xingqi-week"],"sentenceIds":["s:l1:157","s:l1:158","s:l1:159","s:l1:160","s:l1:198","s:l3:231"]},"grammar":[{"id":"g:xingqi-week","title":"星期 + number for days of the week","pattern":"星期 + number (一-六) / 星期 + 几?","explanation":"星期 (xīngqī) means \"week\", and adding a number one through six names that day of the week (星期一 = Monday). Ask which day it is with 星期几?. Sunday uses a different word, covered later.","level":1,"sentenceIds":["s:l1:157","s:l1:158","s:l1:159","s:l1:160"],"unitId":"l1-u29"}],"sentences":[{"id":"s:l1:157","zh":"今天星期几？","pinyin":"Jīntiān xīngqī jǐ?","en":"What day of the week is it today?","wordIds":["w:今天","w:星期","w:几"],"unitId":"l1-u29"},{"id":"s:l1:158","zh":"我星期一去。","pinyin":"Wǒ xīngqī yī qù.","en":"I'm going on Monday.","wordIds":["w:我","w:星期","w:一","w:去"],"unitId":"l1-u29"},{"id":"s:l1:159","zh":"他星期五回来。","pinyin":"Tā xīngqī wǔ huílai.","en":"He's coming back on Friday.","wordIds":["w:他","w:星期","w:五","w:回来"],"unitId":"l1-u29"},{"id":"s:l1:160","zh":"你们星期几见面？","pinyin":"Nǐmen xīngqī jǐ jiànmiàn?","en":"What day are you meeting?","wordIds":["w:你们","w:星期","w:几","w:见面"],"unitId":"l1-u29"},{"id":"s:l1:198","zh":"你等一会儿。","pinyin":"Nǐ děng yíhuìr.","en":"Wait a moment.","wordIds":["w:你","w:等","w:一会儿"],"unitId":"l1-u29"},{"id":"s:l3:231","zh":"我们一边喝茶，一边说话。","pinyin":"Wǒmen yìbiān hē chá, yìbiān shuōhuà.","en":"We drink tea while chatting.","wordIds":["w:我们","w:一边","w:喝","w:茶","w:一边","w:说话"],"unitId":"l1-u29"}]}
