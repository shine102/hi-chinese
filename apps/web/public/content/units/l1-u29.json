{"unit":{"id":"l1-u29","level":1,"order":29,"title":"Trường Học","wordIds":["w:学","w:学校","w:学生","w:老师","w:同学","w:课","w:上课","w:下课","w:上学","w:大学","w:小学","w:中学"],"grammarIds":["g:xuexiao-sheng"],"sentenceIds":["s:l1:118","s:l1:154","s:l1:177","s:l1:190","s:l1:217","s:l1:fill:026","s:l1:fill:027","s:l3:242"]},"grammar":[{"id":"g:xuexiao-sheng","title":"Các cấp học và học sinh tương ứng","pattern":"小学/中学/大学 (+ 生)","explanation":"小学 (\"trường tiểu học\"), 中学 (\"trường trung học\"), và 大学 (\"trường đại học\") mỗi từ đều kết hợp với 生 để gọi tên học sinh/sinh viên ở cấp đó: 小学生, 中学生, 大学生. Riêng 学生 là từ chung để chỉ \"học sinh/sinh viên\".","level":1,"sentenceIds":["s:l1:187","s:l1:188","s:l1:189","s:l1:190"],"unitId":"l1-u29"}],"sentences":[{"id":"s:l1:118","zh":"老师在哪里？","pinyin":"Lǎoshī zài nǎlǐ?","vi":"Giáo viên ở đâu?","wordIds":["w:老师","w:在","w:哪里"],"unitId":"l1-u29"},{"id":"s:l1:154","zh":"我家旁边有学校。","pinyin":"Wǒ jiā pángbiān yǒu xuéxiào.","vi":"Bên cạnh nhà tôi có một trường học.","wordIds":["w:我","w:家","w:旁边","w:有","w:学校"],"unitId":"l1-u29"},{"id":"s:l1:177","zh":"学校在左边。","pinyin":"Xuéxiào zài zuǒbian.","vi":"Trường học ở bên trái.","wordIds":["w:学校","w:在","w:左边"],"unitId":"l1-u29"},{"id":"s:l1:190","zh":"我们都是学生。","pinyin":"Wǒmen dōu shì xuésheng.","vi":"Chúng tôi đều là học sinh.","wordIds":["w:我们","w:都","w:是","w:学生"],"unitId":"l1-u29"},{"id":"s:l1:217","zh":"他学了半年。","pinyin":"Tā xué le bànnián.","vi":"Anh ấy đã học nửa năm.","wordIds":["w:他","w:学","w:了","w:半年"],"unitId":"l1-u29"},{"id":"s:l1:fill:026","zh":"我们几点上课？","pinyin":"Wǒmen jǐ diǎn shàngkè?","vi":"Mấy giờ chúng ta vào học?","wordIds":["w:我们","w:几","w:点","w:上课"],"unitId":"l1-u29"},{"id":"s:l1:fill:027","zh":"我们明天不上学。","pinyin":"Wǒmen míngtiān bú shàngxué.","vi":"Ngày mai chúng tôi không đi học.","wordIds":["w:我们","w:明天","w:不","w:上学"],"unitId":"l1-u29"},{"id":"s:l3:242","zh":"我认识的那个老师很好。","pinyin":"Wǒ rènshi de nàge lǎoshī hěn hǎo.","vi":"Người giáo viên mà tôi quen biết rất tốt.","wordIds":["w:我","w:认识","w:的","w:那","w:个","w:老师","w:很","w:好"],"unitId":"l1-u29"}]}
