{"unit":{"id":"l1-u17","level":1,"order":17,"title":"Meals & Food","wordIds":["w:米饭","w:面包","w:鸡蛋","w:水果","w:包子","w:牛奶","w:面条儿","w:早饭","w:午饭","w:晚饭","w:饭店","w:杯子"],"grammarIds":["g:meal-times"],"sentenceIds":["s:l1:new3:001","s:l1:new3:002","s:l1:new3:003","s:l1:new3:004","s:l1:new3:005","s:l1:new3:006","s:l1:new3:007","s:l1:new3:008"]},"grammar":[{"id":"g:meal-times","title":"Meal words: 早饭, 午饭, 晚饭","pattern":"吃 + 早饭 / 午饭 / 晚饭","explanation":"Chinese names meals by time of day: 早饭 (morning rice = breakfast), 午饭 (noon rice = lunch), 晚饭 (evening rice = dinner). Use 吃 before them: 吃早饭 (eat breakfast).","level":1,"sentenceIds":["s:l1:new3:001","s:l1:new3:002","s:l1:new3:003"],"unitId":"l1-u17"}],"sentences":[{"id":"s:l1:new3:001","zh":"你吃早饭吗？","pinyin":"Nǐ chī zǎofàn ma?","en":"Do you eat breakfast?","wordIds":["w:你","w:吃","w:早饭","w:吗"],"unitId":"l1-u17"},{"id":"s:l1:new3:002","zh":"我吃午饭。","pinyin":"Wǒ chī wǔfàn.","en":"I'm eating lunch.","wordIds":["w:我","w:吃","w:午饭"],"unitId":"l1-u17"},{"id":"s:l1:new3:003","zh":"晚饭吃什么？","pinyin":"Wǎnfàn chī shénme?","en":"What's for dinner?","wordIds":["w:晚饭","w:吃","w:什么"],"unitId":"l1-u17"},{"id":"s:l1:new3:004","zh":"我喝牛奶。","pinyin":"Wǒ hē niúnǎi.","en":"I drink milk.","wordIds":["w:我","w:喝","w:牛奶"],"unitId":"l1-u17"},{"id":"s:l1:new3:005","zh":"面条儿好吃。","pinyin":"Miàntiáor hǎochī.","en":"The noodles are tasty.","wordIds":["w:面条儿","w:好吃"],"unitId":"l1-u17"},{"id":"s:l1:new3:006","zh":"他在饭店吃饭。","pinyin":"Tā zài fàndiàn chīfàn.","en":"He eats at a restaurant.","wordIds":["w:他","w:在","w:饭店","w:吃饭"],"unitId":"l1-u17"},{"id":"s:l1:new3:007","zh":"两个鸡蛋。","pinyin":"Liǎng gè jīdàn.","en":"Two eggs.","wordIds":["w:两","w:个","w:鸡蛋"],"unitId":"l1-u17"},{"id":"s:l1:new3:008","zh":"这个水果好吃。","pinyin":"Zhège shuǐguǒ hǎochī.","en":"This fruit is tasty.","wordIds":["w:这","w:个","w:水果","w:好吃"],"unitId":"l1-u17"}]}
