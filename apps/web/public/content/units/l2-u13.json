{"unit":{"id":"l2-u13","level":2,"order":55,"title":"Unit 13","wordIds":["w:卡","w:带来","w:办","w:过来","w:算","w:辆","w:药","w:留","w:家庭","w:交","w:套","w:全部"],"grammarIds":["g:guolai-direction-complement"],"sentenceIds":["s:l2:093","s:l2:094","s:l2:095","s:l2:096"]},"grammar":[{"id":"g:guolai-direction-complement","title":"Direction complement: V + 过来","pattern":"verb + 过来","explanation":"过来 (guòlái) after a verb shows movement toward the speaker \"over here\". 走过来 means to walk over (toward me/us). Its opposite, 过去, shows movement away from the speaker.","level":2,"sentenceIds":["s:l2:093","s:l2:094","s:l2:095","s:l2:096"],"unitId":"l2-u13"}],"sentences":[{"id":"s:l2:093","zh":"他走过来了。","pinyin":"Tā zǒu guòlái le.","en":"He walked over here.","wordIds":["w:他","w:走","w:过来","w:了"],"unitId":"l2-u13"},{"id":"s:l2:094","zh":"请你过来。","pinyin":"Qǐng nǐ guòlái.","en":"Please come over here.","wordIds":["w:请","w:你","w:过来"],"unitId":"l2-u13"},{"id":"s:l2:095","zh":"你能拿过来吗？","pinyin":"Nǐ néng ná guòlái ma?","en":"Can you bring it over here?","wordIds":["w:你","w:能","w:拿","w:过来","w:吗"],"unitId":"l2-u13"},{"id":"s:l2:096","zh":"他从北京过来了。","pinyin":"Tā cóng Běijīng guòlái le.","en":"He came over from Beijing.","wordIds":["w:他","w:从","w:北京","w:过来","w:了"],"unitId":"l2-u13"}]}
