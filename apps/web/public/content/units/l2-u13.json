{"unit":{"id":"l2-u13","level":2,"order":55,"title":"Unit 13","wordIds":["w:卡","w:带来","w:办","w:过来","w:算","w:辆","w:药","w:留","w:家庭","w:交","w:套","w:全部"],"grammarIds":["g:guolai-direction-complement"],"sentenceIds":["s:l2:093","s:l2:094","s:l2:095","s:l2:096"]},"grammar":[{"id":"g:guolai-direction-complement","title":"Bổ ngữ chỉ hướng: V + 过来","pattern":"verb + 过来","explanation":"过来 (guòlái) đặt sau động từ để chỉ hướng chuyển động về phía người nói — \"lại đây\". 走过来 nghĩa là đi lại đây (về phía tôi/chúng ta). Từ trái nghĩa của nó, 过去, chỉ hướng chuyển động ra xa người nói.","level":2,"sentenceIds":["s:l2:093","s:l2:094","s:l2:095","s:l2:096"],"unitId":"l2-u13"}],"sentences":[{"id":"s:l2:093","zh":"他走过来了。","pinyin":"Tā zǒu guòlái le.","vi":"Anh ấy đã đi lại đây.","wordIds":["w:他","w:走","w:过来","w:了"],"unitId":"l2-u13"},{"id":"s:l2:094","zh":"请你过来。","pinyin":"Qǐng nǐ guòlái.","vi":"Mời bạn lại đây.","wordIds":["w:请","w:你","w:过来"],"unitId":"l2-u13"},{"id":"s:l2:095","zh":"你能拿过来吗？","pinyin":"Nǐ néng ná guòlái ma?","vi":"Bạn có thể mang lại đây không?","wordIds":["w:你","w:能","w:拿","w:过来","w:吗"],"unitId":"l2-u13"},{"id":"s:l2:096","zh":"他从北京过来了。","pinyin":"Tā cóng Běijīng guòlái le.","vi":"Anh ấy đã từ Bắc Kinh đến đây.","wordIds":["w:他","w:从","w:北京","w:过来","w:了"],"unitId":"l2-u13"}]}
