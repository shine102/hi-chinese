{"unit":{"id":"l1-u12","level":1,"order":12,"title":"Unit 12","wordIds":["w:拿","w:高","w:正","w:先","w:得到","w:那些","w:准备","w:水","w:进","w:写","w:国家","w:您"],"grammarIds":["g:xian-first"],"sentenceIds":["s:l1:077","s:l1:078","s:l1:079","s:l1:080","s:l3:226"]},"grammar":[{"id":"g:xian-first","title":"先 for \"first\" in a sequence","pattern":"先 + verb","explanation":"先 (xiān) means to do something first, before something else happens. It goes before the verb: 我先看 (\"I'll look first\"). It's often paired later with 再 (\"then\"), though each word can also stand alone.","level":1,"sentenceIds":["s:l1:077","s:l1:078","s:l1:079","s:l1:080"],"unitId":"l1-u12"}],"sentences":[{"id":"s:l1:077","zh":"我先看。","pinyin":"Wǒ xiān kàn.","en":"I'll look first.","wordIds":["w:我","w:先","w:看"],"unitId":"l1-u12"},{"id":"s:l1:078","zh":"你先说。","pinyin":"Nǐ xiān shuō.","en":"You go first.","wordIds":["w:你","w:先","w:说"],"unitId":"l1-u12"},{"id":"s:l1:079","zh":"他先走了。","pinyin":"Tā xiān zǒu le.","en":"He left first.","wordIds":["w:他","w:先","w:走","w:了"],"unitId":"l1-u12"},{"id":"s:l1:080","zh":"我们先去这里。","pinyin":"Wǒmen xiān qù zhèlǐ.","en":"Let's go here first.","wordIds":["w:我们","w:先","w:去","w:这里"],"unitId":"l1-u12"},{"id":"s:l3:226","zh":"我没有他高。","pinyin":"Wǒ méiyǒu tā gāo.","en":"I'm not as tall as him.","wordIds":["w:我","w:没有","w:他","w:高"],"unitId":"l1-u12"}]}
