{"unit":{"id":"l1-u09","level":1,"order":9,"title":"This & That","wordIds":["w:这","w:那","w:哪","w:这些","w:那些","w:哪些","w:一些","w:有些","w:有一些","w:这里","w:那里","w:哪里"],"grammarIds":["g:buda-notvery","g:nali-where","g:shenme-question"],"sentenceIds":["s:l1:001","s:l1:002","s:l1:006","s:l1:008","s:l1:012","s:l1:027","s:l1:041","s:l1:043","s:l1:048","s:l1:058","s:l1:060","s:l1:064","s:l1:116","s:l1:117","s:l1:185","s:l1:219"]},"grammar":[{"id":"g:buda-notvery","title":"不大 for \"not very\"","pattern":"不大 + verb/adjective","explanation":"不大 (bú dà) means \"not very\" or \"not really\", softening a negative statement: 不大喜欢 (\"doesn't like very much\"), 不大想去 (\"doesn't really want to go\"). It's a gentler alternative to a flat 不喜欢 or 不想去.","level":1,"sentenceIds":["s:l1:219","s:l1:220","s:l1:221"],"unitId":"l1-u09"},{"id":"g:nali-where","title":"哪里/那里 for location","pattern":"在 + 哪里/那里","explanation":"哪里 (nǎlǐ) asks \"where\", and 那里 (nàlǐ) answers \"there\". Both pair naturally with 在: 你在哪里? (\"Where are you?\") and 他在那里 (\"He's over there\").","level":1,"sentenceIds":["s:l1:116","s:l1:117","s:l1:118","s:l1:119"],"unitId":"l1-u09"},{"id":"g:shenme-question","title":"Asking with 什么 (\"what\")","pattern":"... + 什么 (+ object)?","explanation":"什么 (shénme) means \"what\". It stays in the position where the answer would go, rather than moving to the front of the sentence the way English \"what\" does. 你看什么? literally means \"you look-at what?\"","level":1,"sentenceIds":["s:l1:025","s:l1:026","s:l1:027","s:l1:028"],"unitId":"l1-u09"}],"sentences":[{"id":"s:l1:001","zh":"这是我的。","pinyin":"Zhè shì wǒ de.","en":"This is mine.","wordIds":["w:这","w:是","w:我","w:的"],"unitId":"l1-u09"},{"id":"s:l1:002","zh":"我有这个。","pinyin":"Wǒ yǒu zhège.","en":"I have this one.","wordIds":["w:我","w:有","w:这","w:个"],"unitId":"l1-u09"},{"id":"s:l1:006","zh":"你在这。","pinyin":"Nǐ zài zhè.","en":"You are here.","wordIds":["w:你","w:在","w:这"],"unitId":"l1-u09"},{"id":"s:l1:008","zh":"这个是你的。","pinyin":"Zhège shì nǐ de.","en":"This one is yours.","wordIds":["w:这","w:个","w:是","w:你","w:的"],"unitId":"l1-u09"},{"id":"s:l1:012","zh":"这个很好。","pinyin":"Zhège hěn hǎo.","en":"This one is very good.","wordIds":["w:这","w:个","w:很","w:好"],"unitId":"l1-u09"},{"id":"s:l1:027","zh":"这是什么？","pinyin":"Zhè shì shénme?","en":"What is this?","wordIds":["w:这","w:是","w:什么"],"unitId":"l1-u09"},{"id":"s:l1:041","zh":"这个最好。","pinyin":"Zhège zuì hǎo.","en":"This one is the best.","wordIds":["w:这","w:个","w:最","w:好"],"unitId":"l1-u09"},{"id":"s:l1:043","zh":"那个最小。","pinyin":"Nàge zuì xiǎo.","en":"That one is the smallest.","wordIds":["w:那","w:个","w:最","w:小"],"unitId":"l1-u09"},{"id":"s:l1:048","zh":"这个是我的，那个呢？","pinyin":"Zhège shì wǒ de, nàge ne?","en":"This one is mine, what about that one?","wordIds":["w:这","w:个","w:是","w:我","w:的","w:那","w:个","w:呢"],"unitId":"l1-u09"},{"id":"s:l1:058","zh":"这个比那个好。","pinyin":"Zhège bǐ nàge hǎo.","en":"This one is better than that one.","wordIds":["w:这","w:个","w:比","w:那","w:个","w:好"],"unitId":"l1-u09"},{"id":"s:l1:060","zh":"那个比这个小。","pinyin":"Nàge bǐ zhège xiǎo.","en":"That one is smaller than this one.","wordIds":["w:那","w:个","w:比","w:这","w:个","w:小"],"unitId":"l1-u09"},{"id":"s:l1:064","zh":"这个叫什么？","pinyin":"Zhège jiào shénme?","en":"What is this called?","wordIds":["w:这","w:个","w:叫","w:什么"],"unitId":"l1-u09"},{"id":"s:l1:116","zh":"你在哪里？","pinyin":"Nǐ zài nǎlǐ?","en":"Where are you?","wordIds":["w:你","w:在","w:哪里"],"unitId":"l1-u09"},{"id":"s:l1:117","zh":"他在那里。","pinyin":"Tā zài nàlǐ.","en":"He's over there.","wordIds":["w:他","w:在","w:那里"],"unitId":"l1-u09"},{"id":"s:l1:185","zh":"请问，这是谁的？","pinyin":"Qǐngwèn, zhè shì shéi de?","en":"Excuse me, whose is this?","wordIds":["w:请问","w:这","w:是","w:谁","w:的"],"unitId":"l1-u09"},{"id":"s:l1:219","zh":"这个不大。","pinyin":"Zhège bú dà.","en":"This isn't very big.","wordIds":["w:这","w:个","w:不","w:大"],"unitId":"l1-u09"}]}
