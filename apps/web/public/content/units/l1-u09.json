{"unit":{"id":"l1-u09","level":1,"order":9,"title":"Shopping","wordIds":["w:买","w:钱","w:东西","w:贵","w:元","w:块","w:商店","w:商场","w:钱包","w:毛","w:百","w:多"],"grammarIds":["g:bai-hundred"],"sentenceIds":["s:l1:162","s:l1:096","s:l1:161","s:l1:163"]},"grammar":[{"id":"g:bai-hundred","title":"百 for hundred","pattern":"Number + 百 (+ measure word)","explanation":"百 (bǎi) means \"hundred\". Build numbers the same way as with 十: 一百 (100), 两百 (200) — use 两, not 二, before 百 just as with other measure words.","level":1,"sentenceIds":["s:l1:161","s:l1:162","s:l1:163","s:l1:164"],"unitId":"l1-u09"}],"sentences":[{"id":"s:l1:162","zh":"我有两百。","pinyin":"Wǒ yǒu liǎngbǎi.","en":"I have two hundred.","wordIds":["w:我","w:有","w:两","w:百"],"unitId":"l1-u09"},{"id":"s:l1:096","zh":"这个多少钱？","pinyin":"Zhège duōshao qián?","en":"How much is this?","wordIds":["w:这","w:个","w:多少","w:钱"],"unitId":"l1-u09"},{"id":"s:l1:161","zh":"这个一百块。","pinyin":"Zhège yìbǎi kuài.","en":"This one is a hundred kuai.","wordIds":["w:这","w:个","w:一","w:百","w:块"],"unitId":"l1-u09"},{"id":"s:l1:163","zh":"他要三百块。","pinyin":"Tā yào sānbǎi kuài.","en":"He wants three hundred kuai.","wordIds":["w:他","w:要","w:三","w:百","w:块"],"unitId":"l1-u09"}]}
