{"unit":{"id":"l1-u09","level":1,"order":9,"title":"Unit 9","wordIds":["w:一起","w:起","w:几","w:见","w:车","w:一些","w:找到","w:手","w:听","w:非常","w:开","w:叫"],"grammarIds":["g:bi-comparison","g:buda-notvery"],"sentenceIds":["s:l1:061","s:l1:062","s:l1:063","s:l1:064","s:l1:127"]},"grammar":[{"id":"g:bi-comparison","title":"比 for comparisons","pattern":"A + 比 + B + adjective","explanation":"比 (bǐ) compares two things directly: A 比 B + adjective means \"A is more [adjective] than B\". Don't add 很 before the adjective in this pattern — 比 already carries the comparison.","level":1,"sentenceIds":["s:l1:057","s:l1:058","s:l1:059","s:l1:060"],"unitId":"l1-u09"},{"id":"g:buda-notvery","title":"不大 for \"not very\"","pattern":"不大 + verb/adjective","explanation":"不大 (bú dà) means \"not very\" or \"not really\", softening a negative statement: 不大喜欢 (\"doesn't like very much\"), 不大想去 (\"doesn't really want to go\"). It's a gentler alternative to a flat 不喜欢 or 不想去.","level":1,"sentenceIds":["s:l1:219","s:l1:220","s:l1:221"],"unitId":"l1-u09"}],"sentences":[{"id":"s:l1:061","zh":"他叫什么？","pinyin":"Tā jiào shénme?","en":"What's he called?","wordIds":["w:他","w:叫","w:什么"],"unitId":"l1-u09"},{"id":"s:l1:062","zh":"我叫他。","pinyin":"Wǒ jiào tā.","en":"I called him.","wordIds":["w:我","w:叫","w:他"],"unitId":"l1-u09"},{"id":"s:l1:063","zh":"你叫谁？","pinyin":"Nǐ jiào shéi?","en":"Who are you calling?","wordIds":["w:你","w:叫","w:谁"],"unitId":"l1-u09"},{"id":"s:l1:064","zh":"这个叫什么？","pinyin":"Zhège jiào shénme?","en":"What is this called?","wordIds":["w:这","w:个","w:叫","w:什么"],"unitId":"l1-u09"},{"id":"s:l1:127","zh":"我找到了。","pinyin":"Wǒ zhǎodào le.","en":"I found it.","wordIds":["w:我","w:找到","w:了"],"unitId":"l1-u09"}]}
