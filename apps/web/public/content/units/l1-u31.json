{"unit":{"id":"l1-u31","level":1,"order":31,"title":"Work","wordIds":["w:工作","w:上班","w:下班","w:放假","w:放学","w:请假","w:工人","w:事","w:帮","w:帮忙","w:送","w:找"],"grammarIds":["g:bang-help"],"sentenceIds":["s:l1:081","s:l1:084","s:l1:141"]},"grammar":[{"id":"g:bang-help","title":"帮 for helping someone","pattern":"Subject + 帮 + person (+ verb)","explanation":"帮 (bāng) means \"to help\". Put it before the person being helped, and optionally follow with a verb to say what the help is for: 他帮我们找 (\"He's helping us look\").","level":1,"sentenceIds":["s:l1:081","s:l1:082","s:l1:083","s:l1:084"],"unitId":"l1-u31"}],"sentences":[{"id":"s:l1:081","zh":"我帮你。","pinyin":"Wǒ bāng nǐ.","en":"I'll help you.","wordIds":["w:我","w:帮","w:你"],"unitId":"l1-u31"},{"id":"s:l1:084","zh":"请你帮他。","pinyin":"Qǐng nǐ bāng tā.","en":"Please help him.","wordIds":["w:请","w:你","w:帮","w:他"],"unitId":"l1-u31"},{"id":"s:l1:141","zh":"他明天上班。","pinyin":"Tā míngtiān shàngbān.","en":"He goes to work tomorrow.","wordIds":["w:他","w:明天","w:上班"],"unitId":"l1-u31"}]}
