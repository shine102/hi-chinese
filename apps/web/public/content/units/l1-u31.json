{"unit":{"id":"l1-u31","level":1,"order":31,"title":"Unit 31","wordIds":["w:在家","w:百","w:网上","w:好吃","w:明年","w:再见","w:妹","w:这儿","w:哪儿","w:不对","w:中午","w:起床"],"grammarIds":["g:bai-hundred","g:zher-nar-colloquial"],"sentenceIds":["s:l1:143","s:l1:161","s:l1:162","s:l1:163","s:l1:164","s:l1:165","s:l1:166","s:l1:167","s:l1:168","s:l1:172","s:l1:173","s:l1:174","s:l1:197","s:l1:199"]},"grammar":[{"id":"g:bai-hundred","title":"百 for hundred","pattern":"Number + 百 (+ measure word)","explanation":"百 (bǎi) means \"hundred\". Build numbers the same way as with 十: 一百 (100), 两百 (200) — use 两, not 二, before 百 just as with other measure words.","level":1,"sentenceIds":["s:l1:161","s:l1:162","s:l1:163","s:l1:164"],"unitId":"l1-u31"},{"id":"g:zher-nar-colloquial","title":"这儿/哪儿 as spoken alternatives","pattern":"这儿 / 哪儿","explanation":"这儿 (zhèr) and 哪儿 (nǎr) are casual, conversational equivalents of 这里 (\"here\") and 哪里 (\"where\"). They're used exactly the same way, most often right after 在.","level":1,"sentenceIds":["s:l1:165","s:l1:166","s:l1:167","s:l1:168"],"unitId":"l1-u31"}],"sentences":[{"id":"s:l1:143","zh":"你几点起床？","pinyin":"Nǐ jǐ diǎn qǐchuáng?","en":"What time do you get up?","wordIds":["w:你","w:几","w:点","w:起床"],"unitId":"l1-u31"},{"id":"s:l1:161","zh":"这个一百块。","pinyin":"Zhège yìbǎi kuài.","en":"This one is a hundred kuai.","wordIds":["w:这","w:个","w:一","w:百","w:块"],"unitId":"l1-u31"},{"id":"s:l1:162","zh":"我有两百。","pinyin":"Wǒ yǒu liǎngbǎi.","en":"I have two hundred.","wordIds":["w:我","w:有","w:两","w:百"],"unitId":"l1-u31"},{"id":"s:l1:163","zh":"他要三百块。","pinyin":"Tā yào sānbǎi kuài.","en":"He wants three hundred kuai.","wordIds":["w:他","w:要","w:三","w:百","w:块"],"unitId":"l1-u31"},{"id":"s:l1:164","zh":"那本书一百块。","pinyin":"Nà běn shū yìbǎi kuài.","en":"That book is a hundred kuai.","wordIds":["w:那","w:本","w:书","w:一","w:百","w:块"],"unitId":"l1-u31"},{"id":"s:l1:165","zh":"你在哪儿？","pinyin":"Nǐ zài nǎr?","en":"Where are you?","wordIds":["w:你","w:在","w:哪儿"],"unitId":"l1-u31"},{"id":"s:l1:166","zh":"我在这儿。","pinyin":"Wǒ zài zhèr.","en":"I'm here.","wordIds":["w:我","w:在","w:这儿"],"unitId":"l1-u31"},{"id":"s:l1:167","zh":"他不在这儿。","pinyin":"Tā bú zài zhèr.","en":"He's not here.","wordIds":["w:他","w:不","w:在","w:这儿"],"unitId":"l1-u31"},{"id":"s:l1:168","zh":"你们去哪儿？","pinyin":"Nǐmen qù nǎr?","en":"Where are you all going?","wordIds":["w:你们","w:去","w:哪儿"],"unitId":"l1-u31"},{"id":"s:l1:172","zh":"这不对。","pinyin":"Zhè búduì.","en":"This is wrong.","wordIds":["w:这","w:不对"],"unitId":"l1-u31"},{"id":"s:l1:173","zh":"你说的不对。","pinyin":"Nǐ shuō de búduì.","en":"What you said is wrong.","wordIds":["w:你","w:说","w:的","w:不对"],"unitId":"l1-u31"},{"id":"s:l1:174","zh":"不对，不是这个。","pinyin":"Búduì, bú shì zhège.","en":"No, it's not this one.","wordIds":["w:不对","w:不","w:是","w:这","w:个"],"unitId":"l1-u31"},{"id":"s:l1:197","zh":"他也在这儿。","pinyin":"Tā yě zài zhèr.","en":"He's here too.","wordIds":["w:他","w:也","w:在","w:这儿"],"unitId":"l1-u31"},{"id":"s:l1:199","zh":"你去哪儿？","pinyin":"Nǐ qù nǎr?","en":"Where are you going?","wordIds":["w:你","w:去","w:哪儿"],"unitId":"l1-u31"}]}
