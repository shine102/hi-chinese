{"unit":{"id":"l1-u19","level":1,"order":19,"title":"Everyday Actions","wordIds":["w:打","w:开","w:关","w:放","w:送","w:帮","w:住","w:穿","w:洗","w:坐","w:站","w:走"],"grammarIds":["g:bang-help","g:zuihao-suggestion"],"sentenceIds":["s:l1:081","s:l1:084","s:l1:082","s:l1:091","s:l1:083","s:l1:152"]},"grammar":[{"id":"g:bang-help","title":"帮 for helping someone","pattern":"Subject + 帮 + person (+ verb)","explanation":"帮 (bāng) means \"to help\". Put it before the person being helped, and optionally follow with a verb to say what the help is for: 他帮我们找 (\"He's helping us look\").","level":1,"sentenceIds":["s:l1:081","s:l1:082","s:l1:083","s:l1:084"],"unitId":"l1-u19"},{"id":"g:zuihao-suggestion","title":"最好 for \"had better\"","pattern":"(Subject +) 最好 + verb","explanation":"最好 (zuìhǎo) softens advice into \"had better\" or \"(it's) best to\": 你最好休息 (\"You'd better rest\"). It can also open a sentence with no subject, as general advice: 最好现在走 (\"Best to leave now\").","level":1,"sentenceIds":["s:l1:149","s:l1:150","s:l1:151","s:l1:152"],"unitId":"l1-u19"}],"sentences":[{"id":"s:l1:081","zh":"我帮你。","pinyin":"Wǒ bāng nǐ.","en":"I'll help you.","wordIds":["w:我","w:帮","w:你"],"unitId":"l1-u19"},{"id":"s:l1:084","zh":"请你帮他。","pinyin":"Qǐng nǐ bāng tā.","en":"Please help him.","wordIds":["w:请","w:你","w:帮","w:他"],"unitId":"l1-u19"},{"id":"s:l1:082","zh":"他帮我们找。","pinyin":"Tā bāng wǒmen zhǎo.","en":"He's helping us look for it.","wordIds":["w:他","w:帮","w:我们","w:找"],"unitId":"l1-u19"},{"id":"s:l1:091","zh":"我们帮孩子们。","pinyin":"Wǒmen bāng háizimen.","en":"We help the children.","wordIds":["w:我们","w:帮","w:孩子","w:们"],"unitId":"l1-u19"},{"id":"s:l1:083","zh":"你能帮我吗？","pinyin":"Nǐ néng bāng wǒ ma?","en":"Can you help me?","wordIds":["w:你","w:能","w:帮","w:我","w:吗"],"unitId":"l1-u19"},{"id":"s:l1:152","zh":"最好现在走。","pinyin":"Zuìhǎo xiànzài zǒu.","en":"It's best to leave now.","wordIds":["w:最好","w:现在","w:走"],"unitId":"l1-u19"}]}
