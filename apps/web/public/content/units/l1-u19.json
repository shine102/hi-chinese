{"unit":{"id":"l1-u19","level":1,"order":19,"title":"Hoạt Động Hằng Ngày","wordIds":["w:打","w:开","w:放","w:送","w:帮","w:住","w:穿","w:洗","w:站","w:走","w:着"],"grammarIds":["g:bang-help"],"sentenceIds":["s:l1:079","s:l1:081","s:l1:082","s:l1:083","s:l1:084","s:l1:091","s:l1:152"]},"grammar":[{"id":"g:bang-help","title":"帮 dùng để giúp đỡ ai đó","pattern":"Subject + 帮 + person (+ verb)","explanation":"帮 (bāng) nghĩa là \"giúp\". Đặt 帮 trước người được giúp, và có thể thêm động từ phía sau để nói rõ giúp làm việc gì: 他帮我们找 (\"Anh ấy đang giúp chúng tôi tìm\").","level":1,"sentenceIds":["s:l1:081","s:l1:082","s:l1:083","s:l1:084"],"unitId":"l1-u19"}],"sentences":[{"id":"s:l1:079","zh":"他先走了。","pinyin":"Tā xiān zǒu le.","vi":"Anh ấy đã đi trước rồi.","wordIds":["w:他","w:先","w:走","w:了"],"unitId":"l1-u19"},{"id":"s:l1:081","zh":"我帮你。","pinyin":"Wǒ bāng nǐ.","vi":"Tôi giúp bạn.","wordIds":["w:我","w:帮","w:你"],"unitId":"l1-u19"},{"id":"s:l1:082","zh":"他帮我们找。","pinyin":"Tā bāng wǒmen zhǎo.","vi":"Anh ấy giúp chúng tôi tìm.","wordIds":["w:他","w:帮","w:我们","w:找"],"unitId":"l1-u19"},{"id":"s:l1:083","zh":"你能帮我吗？","pinyin":"Nǐ néng bāng wǒ ma?","vi":"Bạn có thể giúp tôi không?","wordIds":["w:你","w:能","w:帮","w:我","w:吗"],"unitId":"l1-u19"},{"id":"s:l1:084","zh":"请你帮他。","pinyin":"Qǐng nǐ bāng tā.","vi":"Làm ơn giúp anh ấy.","wordIds":["w:请","w:你","w:帮","w:他"],"unitId":"l1-u19"},{"id":"s:l1:091","zh":"我们帮孩子们。","pinyin":"Wǒmen bāng háizimen.","vi":"Chúng tôi giúp bọn trẻ.","wordIds":["w:我们","w:帮","w:孩子","w:们"],"unitId":"l1-u19"},{"id":"s:l1:152","zh":"最好现在走。","pinyin":"Zuìhǎo xiànzài zǒu.","vi":"Tốt nhất là đi ngay bây giờ.","wordIds":["w:最好","w:现在","w:走"],"unitId":"l1-u19"}]}
