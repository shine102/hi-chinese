{"unit":{"id":"l1-u19","level":1,"order":19,"title":"Unit 19","wordIds":["w:元","w:哪里","w:包","w:楼","w:那里","w:电视","w:飞","w:介绍","w:下午","w:出去","w:学习","w:老师"],"grammarIds":["g:nali-where"],"sentenceIds":["s:l1:116","s:l1:117","s:l1:118","s:l1:119","s:l3:242"]},"grammar":[{"id":"g:nali-where","title":"哪里/那里 for location","pattern":"在 + 哪里/那里","explanation":"哪里 (nǎlǐ) asks \"where\", and 那里 (nàlǐ) answers \"there\". Both pair naturally with 在: 你在哪里? (\"Where are you?\") and 他在那里 (\"He's over there\").","level":1,"sentenceIds":["s:l1:116","s:l1:117","s:l1:118","s:l1:119"],"unitId":"l1-u19"}],"sentences":[{"id":"s:l1:116","zh":"你在哪里？","pinyin":"Nǐ zài nǎlǐ?","en":"Where are you?","wordIds":["w:你","w:在","w:哪里"],"unitId":"l1-u19"},{"id":"s:l1:117","zh":"他在那里。","pinyin":"Tā zài nàlǐ.","en":"He's over there.","wordIds":["w:他","w:在","w:那里"],"unitId":"l1-u19"},{"id":"s:l1:118","zh":"老师在哪里？","pinyin":"Lǎoshī zài nǎlǐ?","en":"Where is the teacher?","wordIds":["w:老师","w:在","w:哪里"],"unitId":"l1-u19"},{"id":"s:l1:119","zh":"我们去那里吧。","pinyin":"Wǒmen qù nàlǐ ba.","en":"Let's go there.","wordIds":["w:我们","w:去","w:那里","w:吧"],"unitId":"l1-u19"},{"id":"s:l3:242","zh":"我认识的那个老师很好。","pinyin":"Wǒ rènshi de nàge lǎoshī hěn hǎo.","en":"The teacher I know is very nice.","wordIds":["w:我","w:认识","w:的","w:那","w:个","w:老师","w:很","w:好"],"unitId":"l1-u19"}]}
