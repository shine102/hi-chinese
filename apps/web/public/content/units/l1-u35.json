{"unit":{"id":"l1-u35","level":1,"order":35,"title":"Plurals & Groups","wordIds":["w:们","w:我们","w:你们","w:他们","w:她们","w:别人","w:家人","w:老人","w:小朋友","w:女朋友","w:男朋友","w:见面"],"grammarIds":["g:men-plural-suffix"],"sentenceIds":["s:l1:018","s:l1:089","s:l1:082","s:l1:091","s:l1:097","s:l1:142","s:l1:160","s:l1:168","s:l1:195"]},"grammar":[{"id":"g:men-plural-suffix","title":"们 as a plural suffix","pattern":"person noun + 们","explanation":"们 (men) attaches to a noun referring to people to make it plural: 孩子们 (\"children\"), 朋友们 (\"friends\"). It's already built into 我们, 你们, and 他们, but can attach to other people-nouns the same way.","level":1,"sentenceIds":["s:l1:089","s:l1:090","s:l1:091"],"unitId":"l1-u35"}],"sentences":[{"id":"s:l1:018","zh":"他给我们。","pinyin":"Tā gěi wǒmen.","en":"He gives it to us.","wordIds":["w:他","w:给","w:我们"],"unitId":"l1-u35"},{"id":"s:l1:089","zh":"孩子们很好。","pinyin":"Háizimen hěn hǎo.","en":"The children are doing well.","wordIds":["w:孩子","w:们","w:很","w:好"],"unitId":"l1-u35"},{"id":"s:l1:082","zh":"他帮我们找。","pinyin":"Tā bāng wǒmen zhǎo.","en":"He's helping us look for it.","wordIds":["w:他","w:帮","w:我们","w:找"],"unitId":"l1-u35"},{"id":"s:l1:091","zh":"我们帮孩子们。","pinyin":"Wǒmen bāng háizimen.","en":"We help the children.","wordIds":["w:我们","w:帮","w:孩子","w:们"],"unitId":"l1-u35"},{"id":"s:l1:097","zh":"你们有多少人？","pinyin":"Nǐmen yǒu duōshao rén?","en":"How many people do you have?","wordIds":["w:你们","w:有","w:多少","w:人"],"unitId":"l1-u35"},{"id":"s:l1:142","zh":"我们明天见面。","pinyin":"Wǒmen míngtiān jiànmiàn.","en":"Let's meet tomorrow.","wordIds":["w:我们","w:明天","w:见面"],"unitId":"l1-u35"},{"id":"s:l1:160","zh":"你们星期几见面？","pinyin":"Nǐmen xīngqī jǐ jiànmiàn?","en":"What day are you meeting?","wordIds":["w:你们","w:星期","w:几","w:见面"],"unitId":"l1-u35"},{"id":"s:l1:168","zh":"你们去哪儿？","pinyin":"Nǐmen qù nǎr?","en":"Where are you all going?","wordIds":["w:你们","w:去","w:哪儿"],"unitId":"l1-u35"},{"id":"s:l1:195","zh":"我们那儿很好。","pinyin":"Wǒmen nàr hěn hǎo.","en":"Our place is really nice.","wordIds":["w:我们","w:那儿","w:很","w:好"],"unitId":"l1-u35"}]}
