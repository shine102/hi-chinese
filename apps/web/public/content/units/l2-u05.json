{"unit":{"id":"l2-u05","level":2,"order":47,"title":"Tính Cách & Cảm Xúc: Vui Vẻ & Hài Lòng","wordIds":["w:不错","w:快乐","w:开心","w:可爱","w:心情","w:满","w:满意","w:放心","w:感动","w:挺","w:挺好"],"grammarIds":["g:fangxin-rest-assured","g:tinghao-pretty-good"],"sentenceIds":["s:l2:222","s:l2:224","s:l2:341","s:l2:342","s:l2:343","s:l2:352","s:l2:fill:169"]},"grammar":[{"id":"g:fangxin-rest-assured","title":"Cảm thấy yên tâm với 放心","pattern":"你放心, ... / 对...放心","explanation":"放心 (fàngxīn) nghĩa là \"yên tâm, không phải lo lắng\". 你放心 là cách thường dùng để trấn an ai đó; 对...放心 nghĩa là \"yên tâm về điều gì đó\".","level":2,"sentenceIds":["s:l2:221","s:l2:222","s:l2:223","s:l2:224"],"unitId":"l2-u05"},{"id":"g:tinghao-pretty-good","title":"Khen ngợi thân mật với 挺...的","pattern":"挺 + adjective (+ 的)","explanation":"挺 (tǐng) nghĩa là \"khá, tương đối\" giống 很 nhưng mang tính khẩu ngữ hơn, và thường đi cùng 的 ở cuối câu: 挺好的 (khá tốt).","level":2,"sentenceIds":["s:l2:341","s:l2:342","s:l2:343","s:l2:344"],"unitId":"l2-u05"}],"sentences":[{"id":"s:l2:222","zh":"妈妈对我很放心。","pinyin":"Māma duì wǒ hěn fàngxīn.","vi":"Mẹ rất yên tâm về tôi.","wordIds":["w:妈妈","w:对","w:我","w:很","w:放心"],"unitId":"l2-u05"},{"id":"s:l2:224","zh":"我不放心他一个人去。","pinyin":"Wǒ bú fàngxīn tā yí gè rén qù.","vi":"Tôi không yên tâm để anh ấy đi một mình.","wordIds":["w:我","w:不","w:放心","w:他","w:一","w:个","w:人","w:去"],"unitId":"l2-u05"},{"id":"s:l2:341","zh":"这个电影挺好的。","pinyin":"Zhège diànyǐng tǐng hǎo de.","vi":"Bộ phim này khá hay.","wordIds":["w:这","w:个","w:电影","w:挺","w:好","w:的"],"unitId":"l2-u05"},{"id":"s:l2:342","zh":"他挺高兴的。","pinyin":"Tā tǐng gāoxìng de.","vi":"Anh ấy khá vui.","wordIds":["w:他","w:挺","w:高兴","w:的"],"unitId":"l2-u05"},{"id":"s:l2:343","zh":"今天天气挺好。","pinyin":"Jīntiān tiānqì tǐng hǎo.","vi":"Hôm nay thời tiết khá đẹp.","wordIds":["w:今天","w:天气","w:挺","w:好"],"unitId":"l2-u05"},{"id":"s:l2:352","zh":"他很少满意。","pinyin":"Tā hěn shǎo mǎnyì.","vi":"Anh ấy hiếm khi hài lòng.","wordIds":["w:他","w:很","w:少","w:满意"