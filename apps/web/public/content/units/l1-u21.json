{"unit":{"id":"l1-u21","level":1,"order":21,"title":"Going Places","wordIds":["w:走","w:跑","w:站","w:坐","w:进","w:出","w:回","w:开","w:路","w:走路","w:坐下","w:路口"],"grammarIds":["g:zuoxia-settle"],"sentenceIds":["s:l1:051","s:l1:213"]},"grammar":[{"id":"g:zuoxia-settle","title":"坐下 for \"sit down\"","pattern":"坐下","explanation":"坐下 (zuòxia) combines 坐 (\"to sit\") with 下 to describe settling into a seated position — \"to sit down\". Use it for the action of sitting down, as opposed to 坐 alone, which can also mean simply \"to be sitting\".","level":1,"sentenceIds":["s:l1:213","s:l1:214","s:l1:215"],"unitId":"l1-u21"}],"sentences":[{"id":"s:l1:051","zh":"他怎么走？","pinyin":"Tā zěnme zǒu?","en":"How does he go?","wordIds":["w:他","w:怎么","w:走"],"unitId":"l1-u21"},{"id":"s:l1:213","zh":"请坐下。","pinyin":"Qǐng zuòxia.","en":"Please sit down.","wordIds":["w:请","w:坐下"],"unitId":"l1-u21"}]}
