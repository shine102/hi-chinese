{"unit":{"id":"l1-u20","level":1,"order":20,"title":"Buổi Sáng","wordIds":["w:睡","w:睡觉","w:来","w:起来","w:床","w:起床","w:动","w:动作","w:休息","w:手","w:洗手间","w:跑","w:关上","w:打开"],"grammarIds":["g:vo-compounds"],"sentenceIds":["s:l1:014","s:l1:015","s:l1:024","s:l1:070","s:l1:090","s:l1:134","s:l1:143","s:l1:148","s:l1:149","s:l1:175","s:l1:204","s:l1:206","s:l1:core:050","s:l1:fill:022","s:l1:fill:125","s:l1:fill:126","s:l1:fill:127","s:l1:fill:128","s:l1:fill:129","s:l1:new:052","s:l1:new:055","s:l2:core:015","s:l2:core:021","s:l2:core:023","s:l3:219"]},"grammar":[{"id":"g:vo-compounds","title":"Từ ghép động từ-tân ngữ","pattern":"verb + built-in object (吃饭, 上班, 见面, 起床, 唱歌...)","explanation":"Nhiều hành động thông dụng được viết thành một cặp động từ + tân ngữ cố định, hoạt động như một động từ duy nhất: 吃饭 (\"ăn cơm\"), 上班 (\"đi làm\"), 见面 (\"gặp mặt\"), 起床 (\"dậy, thức dậy\"), 唱歌 (\"hát\"). Hãy coi cả cặp từ này như một khối duy nhất — không chèn thêm tân ngữ khác phía sau như với một động từ thông thường.","level":1,"sentenceIds":["s:l1:140","s:l1:141","s:l1:142","s:l1:143","s:l1:144"],"unitId":"l1-u20"}],"sentences":[{"id":"s:l1:014","zh":"他不能来。","pinyin":"Tā bù néng lái.","vi":"Anh ấy không thể đến.","wordIds":["w:他","w:不","w:能","w:来"],"unitId":"l1-u20"},{"id":"s:l1:015","zh":"你能来。","pinyin":"Nǐ néng lái.","vi":"Bạn có thể đến.","wordIds":["w:你","w:能","w:来"],"unitId":"l1-u20"},{"id":"s:l1:024","zh":"你没来。","pinyin":"Nǐ méi lái.","vi":"Bạn đã không đến.","wordIds":["w:你","w:没","w:来"],"unitId":"l1-u20"},{"id":"s:l1:070","zh":"请你来。","pinyin":"Qǐng nǐ lái.","vi":"Mời bạn đến.","wordIds":["w:请","w:你","w:来"],"unitId":"l1-u20"},{"id":"s:l1:090","zh":"朋友们都来了。","pinyin":"Péngyoumen dōu lái le.","vi":"Các bạn đều đã đến.","wordIds":["w:朋友","w:们","w:都","w:来","w:了"],"unitId":"l1-u20"},{"id":"s:l1:134","zh":"你常常来吗？","pinyin":"Nǐ chángcháng lái ma?","vi":"Bạn có thường đến không?","wordIds":["w:你","w:常常","w:来","w:吗"],"unitId":"l1-u20"},{"id":"s:l1:143","zh":"你几点起床？","pinyin":"Nǐ jǐ diǎn qǐchuáng?","vi":"Mấy giờ bạn dậy?","wordIds":["w:你","w:几","w:点","w:起床"],"unitId":"l1-u20"},{"id":"s:l1:148","zh":"对不起，我来晚了。","pinyin":"Duìbuqǐ, wǒ lái wǎn le.","vi":"Xin lỗi, tôi đến muộn.","wordIds":["w:对不起","w:我","w:来","w:晚","w:了"],"unitId":"l1-u20"},{"id":"s:l1:149","zh":"你最好休息。","pinyin":"Nǐ zuìhǎo xiūxi.","vi":"Bạn nên nghỉ ngơi thì hơn.","wordIds":["w:你","w:最好","w:休息"],"unitId":"l1-u20"},{"id":"s:l1:175","zh":"下次你来。","pinyin":"Xiàcì nǐ lái.","vi":"Lần sau bạn đến nhé.","wordIds":["w:下次","w:你","w:来"],"unitId":"l1-u20"},{"id":"s:l1:204","zh":"后天你来吗？","pinyin":"Hòutiān nǐ lái ma?","vi":"Ngày kia bạn có đến không?","wordIds":["w:后天","w:你","w:来","w:吗"],"unitId":"l1-u20"},{"id":"s:l1:206","zh":"前天他没来，后天他能来。","pinyin":"Qiántiān tā méi lái, hòutiān tā néng lái.","vi":"Hôm kia anh ấy đã không đến, nhưng ngày kia anh ấy có thể đến.","wordIds":["w:前天","w:他","w:没","w:来","w:后天","w:他","w:能","w:来"],"unitId":"l1-u20"},{"id":"s:l1:core:050","zh":"他明天会来吗？","pinyin":"Tā míngtiān huì lái ma?","vi":"Ngày mai anh ấy có đến không?","wordIds":["w:他","w:明天","w:会","w:来","w:吗"],"unitId":"l1-u20"},{"id":"s:l1:fill:022","zh":"你打开看一下儿。","pinyin":"Nǐ dǎkāi kàn yíxiàr.","vi":"Bạn mở ra xem thử đi.","wordIds":["w:你","w:打开","w:看","w:一下儿"],"unitId":"l1-u20"},{"id":"s:l1:fill:125","zh":"他还在床上。","pinyin":"Tā hái zài chuáng shàng.","vi":"Anh ấy vẫn còn nằm trên giường.","wordIds":["w:他","w:还","w:在","w:床","w:上"],"unitId":"l1-u20"},{"id":"s:l1:fill:126","zh":"这个动作不对。","pinyin":"Zhège dòngzuò bú duì.","vi":"Động tác này không đúng.","wordIds":["w:这","w:个","w:动作","w:不","w:对"],"unitId":"l1-u20"},{"id":"s:l1:fill:127","zh":"请问，洗手间在哪儿？","pinyin":"Qǐngwèn, xǐshǒujiān zài nǎr?","vi":"Xin hỏi, nhà vệ sinh ở đâu?","wordIds":["w:请问","w:洗手间","w:在","w:哪儿"],"unitId":"l1-u20"},{"id":"s:l1:fill:128","zh":"你先洗手。","pinyin":"Nǐ xiān xǐ shǒu.","vi":"Con rửa tay trước đi.","wordIds":["w:你","w:先","w:洗","w:手"],"unitId":"l1-u20"},{"id":"s:l1:fill:129","zh":"你别关上，我还要用。","pinyin":"Nǐ bié guānshàng, wǒ hái yào yòng.","vi":"Bạn đừng đóng lại, tôi còn phải dùng.","wordIds":["w:你","w:别","w:关上","w:我","w:还","w:要","w:用"],"unitId":"l1-u20"},{"id":"s:l1:new:052","zh":"我早上来。","pinyin":"Wǒ zǎoshang lái.","vi":"Tôi đến vào buổi sáng.","wordIds":["w:我","w:早上","w:来"],"unitId":"l1-u20"},{"id":"s:l1:new:055","zh":"白天来，晚上去。","pinyin":"Báitiān lái, wǎnshang qù.","vi":"Ban ngày đến, buổi tối đi.","wordIds":["w:白天","w:来","w:晚上","w:去"],"unitId":"l1-u20"},{"id":"s:l2:core:015","zh":"你是什么时候来的？","pinyin":"Nǐ shì shénme shíhou lái de?","vi":"Bạn đến lúc nào vậy?","wordIds":["w:你","w:是","w:什么","w:时候","w:来","w:的"],"unitId":"l1-u20"},{"id":"s:l2:core:021","zh":"他八点就来了。","pinyin":"Tā bā diǎn jiù lái le.","vi":"Anh ấy tám giờ đã đến rồi.","wordIds":["w:他","w:八","w:点","w:就","w:来","w:了"],"unitId":"l1-u20"},{"id":"s:l2:core:023","zh":"我早上六点就起床了。","pinyin":"Wǒ zǎoshang liù diǎn jiù qǐchuáng le.","vi":"Tôi sáu giờ sáng đã dậy rồi.","wordIds":["w:我","w:早上","w:六","w:点","w:就","w:起床","w:了"],"unitId":"l1-u20"},{"id":"s:l3:219","zh":"他站住不动了。","pinyin":"Tā zhàn zhù bú dòng le.","vi":"Anh ấy đứng yên không nhúc nhích.","wordIds":["w:他","w:站","w:住","w:不","w:动","w:了"],"unitId":"l1-u20"}]}
