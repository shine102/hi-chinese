{"unit":{"id":"l1-u41","level":1,"order":41,"title":"Con Trai & Con Gái","wordIds":["w:男生","w:女生","w:男孩儿","w:女孩儿","w:小孩儿","w:小朋友","w:男朋友","w:女朋友"],"grammarIds":["g:short-family"],"sentenceIds":["s:l1:fill:201","s:l1:fill:202","s:l1:new3:029","s:l1:new3:030","s:l1:new3:031","s:l1:new3:032","s:l1:new3:033","s:l1:new3:035"]},"grammar":[{"id":"g:short-family","title":"Cách gọi rút gọn trong gia đình: 哥, 姐, 弟, 妹","pattern":"哥 / 姐 / 弟 / 妹","explanation":"Trong lời nói thân mật, các danh xưng gia đình có thể được rút gọn: 哥 (gē, anh trai) thay cho 哥哥, 姐 (jiě, chị gái) thay cho 姐姐, v.v. Các dạng rút gọn này cũng có thể kết hợp với từ khác: 男生 (học sinh nam), 女生 (học sinh nữ).","level":1,"sentenceIds":["s:l1:new3:029","s:l1:new3:030"],"unitId":"l1-u41"}],"sentences":[{"id":"s:l1:fill:201","zh":"那个女孩儿是谁？","pinyin":"Nàge nǚháir shì shéi?","vi":"Cô bé kia là ai?","wordIds":["w:那","w:个","w:女孩儿","w:是","w:谁"],"unitId":"l1-u41"},{"id":"s:l1:fill:202","zh":"她有男朋友吗？","pinyin":"Tā yǒu nánpéngyou ma?","vi":"Cô ấy có bạn trai không?","wordIds":["w:她","w:有","w:男朋友","w:吗"],"unitId":"l1-u41"},{"id":"s:l1:new3:029","zh":"他是男生。","pinyin":"Tā shì nánshēng.","vi":"Anh ấy là học sinh nam.","wordIds":["w:他","w:是","w:男生"],"unitId":"l1-u41"},{"id":"s:l1:new3:030","zh":"她是女生。","pinyin":"Tā shì nǚshēng.","vi":"Cô ấy là học sinh nữ.","wordIds":["w:她","w:是","w:女生"],"unitId":"l1-u41"},{"id":"s:l1:new3:031","zh":"小朋友们好！","pinyin":"Xiǎopéngyǒumen hǎo!","vi":"Chào các bạn nhỏ!","wordIds":["w:小朋友","w:们","w:好"],"unitId":"l1-u41"},{"id":"s:l1:new3:032","zh":"那个男孩儿是我弟。","pinyin":"Nàge nánháir shì wǒ dì.","vi":"Cậu bé đó là em trai tôi.","wordIds":["w:那","w:个","w:男孩儿","w:是","w:我","w:弟"],"unitId":"l1-u41"},{"id":"s:l1:new3:033","zh":"她是我女朋友。","pinyin":"Tā shì wǒ nǚpéngyou.","vi":"Cô ấy là bạn gái tôi.","wordIds":["w:她","w:是","w:我","w:女朋友"],"unitId":"l1-u41"},{"id":"s:l1:new3:035","zh":"小孩儿在哪儿？","pinyin":"Xiǎoháir zài nǎr?","vi":"Đứa trẻ ở đâu?","wordIds":["w:小孩儿","w:在","w:哪儿"],"unitId":"l1-u41"}]}
