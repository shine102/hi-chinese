{"unit":{"id":"l1-u41","level":1,"order":41,"title":"Boys & Girls","wordIds":["w:男生","w:女生","w:男孩儿","w:女孩儿","w:小孩儿","w:小朋友","w:男朋友","w:女朋友","w:哥","w:姐","w:弟","w:妹"],"grammarIds":["g:short-family"],"sentenceIds":["s:l1:new3:029","s:l1:new3:030","s:l1:new3:031","s:l1:new3:032","s:l1:new3:033","s:l1:new3:034","s:l1:new3:035"]},"grammar":[{"id":"g:short-family","title":"Short family forms: 哥, 姐, 弟, 妹","pattern":"哥 / 姐 / 弟 / 妹","explanation":"In casual speech, family titles can be shortened: 哥 (gē, older brother) instead of 哥哥, 姐 (jiě, older sister) instead of 姐姐, etc. These short forms also combine with other words: 男生 (boy student), 女生 (girl student).","level":1,"sentenceIds":["s:l1:new3:029","s:l1:new3:030"],"unitId":"l1-u41"}],"sentences":[{"id":"s:l1:new3:029","zh":"他是男生。","pinyin":"Tā shì nánshēng.","en":"He is a boy (student).","wordIds":["w:他","w:是","w:男生"],"unitId":"l1-u41"},{"id":"s:l1:new3:030","zh":"她是女生。","pinyin":"Tā shì nǚshēng.","en":"She is a girl (student).","wordIds":["w:她","w:是","w:女生"],"unitId":"l1-u41"},{"id":"s:l1:new3:031","zh":"小朋友们好！","pinyin":"Xiǎopéngyoumen hǎo!","en":"Hello, children!","wordIds":["w:小朋友","w:们","w:好"],"unitId":"l1-u41"},{"id":"s:l1:new3:032","zh":"那个男孩儿是我弟。","pinyin":"Nàge nánháir shì wǒ dì.","en":"That boy is my younger brother.","wordIds":["w:那","w:个","w:男孩儿","w:是","w:我","w:弟"],"unitId":"l1-u41"},{"id":"s:l1:new3:033","zh":"她是我女朋友。","pinyin":"Tā shì wǒ nǚpéngyou.","en":"She is my girlfriend.","wordIds":["w:她","w:是","w:我","w:女朋友"],"unitId":"l1-u41"},{"id":"s:l1:new3:034","zh":"姐，你好！","pinyin":"Jiě, nǐ hǎo!","en":"Hey sis, hello!","wordIds":["w:姐","w:你","w:好"],"unitId":"l1-u41"},{"id":"s:l1:new3:035","zh":"小孩儿在哪儿？","pinyin":"Xiǎoháir zài nǎr?","en":"Where is the child?","wordIds":["w:小孩儿","w:在","w:哪儿"],"unitId":"l1-u41"}]}
