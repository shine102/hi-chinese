{"unit":{"id":"l1-u41","level":1,"order":41,"title":"People & Students","wordIds":["w:男生","w:女生","w:男孩儿","w:女孩儿","w:小孩儿","w:岁","w:子","w:哥","w:姐","w:弟","w:妹","w:爸","w:妈","w:奶"],"grammarIds":["g:sui-age"],"sentenceIds":["s:l1:073","s:l1:074","s:l1:075","s:l1:076"]},"grammar":[{"id":"g:sui-age","title":"岁 for stating age","pattern":"Subject + number + 岁","explanation":"To state age, put the number directly before 岁 (suì, \"years old\") with no verb needed — 是 is not used. 我三岁 means \"I am three years old\". 几岁 asks a child's age.","level":1,"sentenceIds":["s:l1:073","s:l1:074","s:l1:075","s:l1:076"],"unitId":"l1-u41"}],"sentences":[{"id":"s:l1:073","zh":"我三岁。","pinyin":"Wǒ sān suì.","en":"I am three years old.","wordIds":["w:我","w:三","w:岁"],"unitId":"l1-u41"},{"id":"s:l1:074","zh":"他两岁。","pinyin":"Tā liǎng suì.","en":"He is two years old.","wordIds":["w:他","w:两","w:岁"],"unitId":"l1-u41"},{"id":"s:l1:075","zh":"你几岁？","pinyin":"Nǐ jǐ suì?","en":"How old are you?","wordIds":["w:你","w:几","w:岁"],"unitId":"l1-u41"},{"id":"s:l1:076","zh":"她三岁了。","pinyin":"Tā sān suì le.","en":"She just turned three.","wordIds":["w:她","w:三","w:岁","w:了"],"unitId":"l1-u41"}]}
