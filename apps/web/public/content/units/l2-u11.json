{"unit":{"id":"l2-u11","level":2,"order":53,"title":"Unit 11","wordIds":["w:句","w:影响","w:永远","w:方面","w:也许","w:面","w:活动","w:份","w:信息","w:最近","w:换","w:狗"],"grammarIds":["g:yexu-perhaps","g:zuijin-recent"],"sentenceIds":["s:l2:081","s:l2:082","s:l2:083","s:l2:084","s:l2:085","s:l2:086","s:l2:087","s:l2:088","s:l2:331"]},"grammar":[{"id":"g:yexu-perhaps","title":"Softening a guess with 也许","pattern":"也许 + clause","explanation":"也许 (yěxǔ) means \"perhaps, maybe\" it usually starts the sentence or comes right before the verb, showing the speaker isn't sure.","level":2,"sentenceIds":["s:l2:081","s:l2:082","s:l2:083","s:l2:084"],"unitId":"l2-u11"},{"id":"g:zuijin-recent","title":"Talking about recent time with 最近","pattern":"最近 + clause","explanation":"最近 (zuìjìn) means \"recently, lately\" a period close to now, from the near past up to the present. It usually goes at the start of the sentence or right before the verb.","level":2,"sentenceIds":["s:l2:085","s:l2:086","s:l2:087","s:l2:088"],"unitId":"l2-u11"}],"sentences":[{"id":"s:l2:081","zh":"也许他不知道。","pinyin":"Yěxǔ tā bù zhīdào.","en":"Maybe he doesn't know.","wordIds":["w:也许","w:他","w:不","w:知道"],"unitId":"l2-u11"},{"id":"s:l2:082","zh":"也许明天会下雨。","pinyin":"Yěxǔ míngtiān huì xiàyǔ.","en":"Maybe it will rain tomorrow.","wordIds":["w:也许","w:明天","w:会","w:下雨"],"unitId":"l2-u11"},{"id":"s:l2:083","zh":"他也许还在公司。","pinyin":"Tā yěxǔ hái zài gōngsī.","en":"He might still be at the company.","wordIds":["w:他","w:也许","w:还","w:在","w:公司"],"unitId":"l2-u11"},{"id":"s:l2:084","zh":"也许这是最好的办法。","pinyin":"Yěxǔ zhè shì zuì hǎo de bànfǎ.","en":"Maybe this is the best method.","wordIds":["w:也许","w:这","w:是","w:最","w:好","w:的","w:办法"],"unitId":"l2-u11"},{"id":"s:l2:085","zh":"最近我很忙。","pinyin":"Zuìjìn wǒ hěn máng.","en":"I've been busy lately.","wordIds":["w:最近","w:我","w:很","w:忙"],"unitId":"l2-u11"},{"id":"s:l2:086","zh":"你最近忙吗？","pinyin":"Nǐ zuìjìn máng ma?","en":"Have you been busy recently?","wordIds":["w:你","w:最近","w:忙","w:吗"],"unitId":"l2-u11"},{"id":"s:l2:087","zh":"最近我换了工作。","pinyin":"Zuìjìn wǒ huàn le gōngzuò.","en":"I changed jobs recently.","wordIds":["w:最近","w:我","w:换","w:了","w:工作"],"unitId":"l2-u11"},{"id":"s:l2:088","zh":"最近天气不太好。","pinyin":"Zuìjìn tiānqì bú tài hǎo.","en":"The weather hasn't been great lately.","wordIds":["w:最近","w:天气","w:不","w:太","w:好"],"unitId":"l2-u11"},{"id":"s:l2:331","zh":"大家都叫它小狗。","pinyin":"Dàjiā dōu jiào tā xiǎo gǒu.","en":"Everyone calls it \"little dog\".","wordIds":["w:大家","w:都","w:叫","w:它","w:小","w:狗"],"unitId":"l2-u11"}]}
