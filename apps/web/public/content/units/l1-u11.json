{"unit":{"id":"l1-u11","level":1,"order":11,"title":"Unit 11","wordIds":["w:问","w:告诉","w:出来","w:地方","w:最后","w:老","w:岁","w:行","w:号","w:放","w:朋友","w:住"],"grammarIds":["g:qing-please","g:sui-age"],"sentenceIds":["s:l1:073","s:l1:074","s:l1:075","s:l1:076"]},"grammar":[{"id":"g:qing-please","title":"请 for polite requests","pattern":"请 + (person) + verb","explanation":"请 (qǐng) makes a request polite, like English \"please\". It comes at the very front of the sentence, before the person being addressed if one is named: 请你来 (\"Please come\").","level":1,"sentenceIds":["s:l1:069","s:l1:070","s:l1:071","s:l1:072"],"unitId":"l1-u11"},{"id":"g:sui-age","title":"岁 for stating age","pattern":"Subject + number + 岁","explanation":"To state age, put the number directly before 岁 (suì, \"years old\") with no verb needed — 是 is not used. 我三岁 means \"I am three years old\". 几岁 asks a child's age.","level":1,"sentenceIds":["s:l1:073","s:l1:074","s:l1:075","s:l1:076"],"unitId":"l1-u11"}],"sentences":[{"id":"s:l1:073","zh":"我三岁。","pinyin":"Wǒ sān suì.","en":"I am three years old.","wordIds":["w:我","w:三","w:岁"],"unitId":"l1-u11"},{"id":"s:l1:074","zh":"他两岁。","pinyin":"Tā liǎng suì.","en":"He is two years old.","wordIds":["w:他","w:两","w:岁"],"unitId":"l1-u11"},{"id":"s:l1:075","zh":"你几岁？","pinyin":"Nǐ jǐ suì?","en":"How old are you?","wordIds":["w:你","w:几","w:岁"],"unitId":"l1-u11"},{"id":"s:l1:076","zh":"她三岁了。","pinyin":"Tā sān suì le.","en":"She just turned three.","wordIds":["w:她","w:三","w:岁","w:了"],"unitId":"l1-u11"}]}
