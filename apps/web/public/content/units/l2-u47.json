{"unit":{"id":"l2-u47","level":2,"order":89,"title":"Thời Gian: Ngày, Tuần & Năm","wordIds":["w:周","w:夜","w:日子","w:周末","w:上周","w:早晨","w:半夜","w:假","w:假期","w:月份","w:夜里","w:全年","w:前年","w:下周","w:到处","w:早就"],"grammarIds":["g:xiazhou-next-week","g:zaojiu-long-ago"],"sentenceIds":["s:l2:209","s:l2:210","s:l2:211","s:l2:212","s:l2:345","s:l2:346","s:l2:347","s:l2:348","s:l2:fill:105","s:l2:fill:106","s:l2:fill:165","s:l2:fill:204"]},"grammar":[{"id":"g:xiazhou-next-week","title":"Nói về tuần sau với 下周","pattern":"下周 + clause","explanation":"下周 (xiàzhōu) nghĩa là \"tuần sau\" — từ chỉ thời gian đặt ở đầu câu hoặc ngay sau chủ ngữ, giống như 明天 hay 今天.","level":2,"sentenceIds":["s:l2:345","s:l2:346","s:l2:347","s:l2:348"],"unitId":"l2-u47"},{"id":"g:zaojiu-long-ago","title":"Từ lâu rồi với 早就","pattern":"(主语) + 早就 + verb phrase (+ 了)","explanation":"早就 (zǎojiù) nghĩa là \"đã...từ lâu, từ lâu rồi\" — nhấn mạnh rằng điều gì đó đã xảy ra từ rất lâu trước hiện tại, mạnh hơn 已经 thông thường.","level":2,"sentenceIds":["s:l2:209","s:l2:210","s:l2:211","s:l2:212"],"unitId":"l2-u47"}],"sentences":[{"id":"s:l2:209","zh":"我早就知道了。","pinyin":"Wǒ zǎojiù zhīdào le.","vi":"Tôi đã biết từ lâu rồi.","wordIds":["w:我","w:早就","w:知道","w:了"],"unitId":"l2-u47"},{"id":"s:l2:210","zh":"他早就走了。","pinyin":"Tā zǎojiù zǒu le.","vi":"Anh ấy đã đi từ lâu rồi.","wordIds":["w:他","w:早就","w:走","w:了"],"unitId":"l2-u47"},{"id":"s:l2:211","zh":"这件事我早就忘了。","pinyin":"Zhè jiàn shì wǒ zǎojiù wàng le.","vi":"Việc này tôi đã quên từ lâu rồi.","wordIds":["w:这","w:件","w:事","w:我","w:早就","w:忘","w:了"],"unitId":"l2-u47"},{"id":"s:l2:212","zh":"她早就不在这儿工作了。","pinyin":"Tā zǎojiù bú zài zhèr gōngzuò le.","vi":"Cô ấy đã nghỉ làm ở đây từ lâu rồi.","wordIds":["w:她","w:早就","w:不","w:在","w:这儿","w:工作","w:了"],"unitId":"l2-u47"},{"id":"s:l2:345","zh":"下周我们有考试。","pinyin":"Xiàzhōu wǒmen yǒu kǎoshì.","vi":"Tuần sau chúng tôi có kỳ thi.","wordIds":["w:下周","w:我们","w:有","w:考试"],"unitId":"l2-u47"},{"id":"s:l2:346","zh":"他下周回国。","pinyin":"Tā xià