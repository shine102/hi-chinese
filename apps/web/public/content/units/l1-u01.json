{"unit":{"id":"l1-u01","level":1,"order":1,"title":"Unit 1","wordIds":["w:的","w:了","w:我","w:是","w:你","w:在","w:不","w:有","w:他","w:这","w:就","w:个"],"grammarIds":["g:bu-negation","g:shi-sentences"],"sentenceIds":["s:l1:001","s:l1:002","s:l1:003","s:l1:004","s:l1:005","s:l1:006","s:l1:007","s:l1:008"]},"grammar":[{"id":"g:bu-negation","title":"Negating with 不","pattern":"不 + verb / adjective","explanation":"不 (bù) goes directly before a verb or adjective to negate it: 不是 (is not), 不在 (is not at/there). Before a 4th-tone syllable such as 是 or 在, 不 is pronounced bú.","level":1,"sentenceIds":["s:l1:003","s:l1:004"],"unitId":"l1-u01"},{"id":"g:shi-sentences","title":"Linking with 是","pattern":"A + 是 + B","explanation":"是 (shì) links a subject to what it is, like English \"to be\". It never changes form: 我是, 你是, 他是 all use the same 是. Negate it with 不是 (bú shì), never with 没.","level":1,"sentenceIds":["s:l1:001","s:l1:004","s:l1:008"],"unitId":"l1-u01"}],"sentences":[{"id":"s:l1:001","zh":"这是我的。","pinyin":"Zhè shì wǒ de.","en":"This is mine.","wordIds":["w:这","w:是","w:我","w:的"],"unitId":"l1-u01"},{"id":"s:l1:002","zh":"我有这个。","pinyin":"Wǒ yǒu zhège.","en":"I have this one.","wordIds":["w:我","w:有","w:这","w:个"],"unitId":"l1-u01"},{"id":"s:l1:003","zh":"他不在。","pinyin":"Tā bú zài.","en":"He is not here.","wordIds":["w:他","w:不","w:在"],"unitId":"l1-u01"},{"id":"s:l1:004","zh":"我不是你。","pinyin":"Wǒ bú shì nǐ.","en":"I am not you.","wordIds":["w:我","w:不","w:是","w:你"],"unitId":"l1-u01"},{"id":"s:l1:005","zh":"你是不是他？","pinyin":"Nǐ shì bu shì tā?","en":"Are you him?","wordIds":["w:你","w:是","w:不","w:是","w:他"],"unitId":"l1-u01"},{"id":"s:l1:006","zh":"你在不在？","pinyin":"Nǐ zài bu zài?","en":"Are you there?","wordIds":["w:你","w:在","w:不","w:在"],"unitId":"l1-u01"},{"id":"s:l1:007","zh":"他有了。","pinyin":"Tā yǒu le.","en":"He has it now.","wordIds":["w:他","w:有","w:了"],"unitId":"l1-u01"},{"id":"s:l1:008","zh":"这个是你的。","pinyin":"Zhège shì nǐ de.","en":"This one is yours.","wordIds":["w:这","w:个","w:是","w:你","w:的"],"unitId":"l1-u01"}]}
