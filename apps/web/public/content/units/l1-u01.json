{"unit":{"id":"l1-u01","level":1,"order":1,"title":"Xin Chào!","wordIds":["w:你","w:好","w:我","w:他","w:她","w:是","w:不","w:对","w:谢谢","w:再","w:见","w:再见","w:您","w:请"],"grammarIds":["g:bu-negation","g:shi-sentences"],"sentenceIds":["s:l1:004","s:l1:005","s:l1:007","s:l1:fill:001","s:l1:fill:002","s:l1:fill:003"]},"grammar":[{"id":"g:bu-negation","title":"Phủ định với 不","pattern":"不 + verb / adjective","explanation":"不 (bù) đứng ngay trước động từ hoặc tính từ để phủ định: 不是 (không phải là), 不在 (không có ở đó). Trước một âm tiết thanh 4 như 是 hay 在, 不 được đọc là bú.","level":1,"sentenceIds":["s:l1:003","s:l1:004","s:l1:005"],"unitId":"l1-u01"},{"id":"g:shi-sentences","title":"Liên kết với 是","pattern":"A + 是 + B","explanation":"是 (shì) liên kết chủ ngữ với những gì nó là, giống động từ \"to be\" trong tiếng Anh. 是 không bao giờ thay đổi hình thức: 我是, 你是, 他是 đều dùng chung một chữ 是. Phủ định bằng 不是 (bú shì), không bao giờ dùng 没.","level":1,"sentenceIds":["s:l1:001","s:l1:004","s:l1:008","s:l1:005","s:l1:007"],"unitId":"l1-u01"}],"sentences":[{"id":"s:l1:004","zh":"我不是你。","pinyin":"Wǒ bú shì nǐ.","vi":"Tôi không phải là bạn.","wordIds":["w:我","w:不","w:是","w:你"],"unitId":"l1-u01"},{"id":"s:l1:005","zh":"他不是我。","pinyin":"Tā bú shì wǒ.","vi":"Anh ấy không phải là tôi.","wordIds":["w:他","w:不","w:是","w:我"],"unitId":"l1-u01"},{"id":"s:l1:007","zh":"我是他。","pinyin":"Wǒ shì tā.","vi":"Tôi là anh ấy.","wordIds":["w:我","w:是","w:他"],"unitId":"l1-u01"},{"id":"s:l1:fill:001","zh":"你好！","pinyin":"Nǐ hǎo!","vi":"Xin chào!","wordIds":["w:你","w:好"],"unitId":"l1-u01"},{"id":"s:l1:fill:002","zh":"谢谢，再见！","pinyin":"Xièxie, zàijiàn!","vi":"Cảm ơn, tạm biệt!","wordIds":["w:谢谢","w:再见"],"unitId":"l1-u01"},{"id":"s:l1:fill:003","zh":"您好！","pinyin":"Nín hǎo!","vi":"Chào ông ạ!","wordIds":["w:您","w:好"],"unitId":"l1-u01"}]}
