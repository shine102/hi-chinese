{"unit":{"id":"l1-u01","level":1,"order":1,"title":"Xin Chào!","wordIds":["w:你","w:好","w:我","w:他","w:她","w:是","w:不","w:对","w:谢谢","w:再","w:见","w:再见","w:您","w:请"],"grammarIds":["g:bu-negation","g:shi-sentences"],"sentenceIds":["s:l1:004","s:l1:005","s:l1:007","s:l1:fill:001","s:l1:fill:002","s:l1:fill:003","s:l1:fill:045","s:l1:fill:046","s:l1:fill:047","s:l1:fill:048","s:l1:fill:049","s:l1:fill:050"]},"grammar":[{"id":"g:bu-negation","title":"Phủ định với 不","pattern":"不 + verb / adjective","explanation":"不 (bù) đứng ngay trước động từ hoặc tính từ để phủ định: 不是 (không phải là), 不在 (không có ở đó). Trước một âm tiết thanh 4 như 是 hay 在, 不 được đọc là bú.","level":1,"sentenceIds":["s:l1:003","s:l1:004","s:l1:005"],"unitId":"l1-u01"},{"id":"g:shi-sentences","title":"Liên kết với 是","pattern":"A + 是 + B","explanation":"是 (shì) liên kết chủ ngữ với những gì nó là, giống động từ \"to be\" trong tiếng Anh. 是 không bao giờ thay đổi hình thức: 我是, 你是, 他是 đều dùng chung một chữ 是. Phủ định bằng 不是 (bú shì), không bao giờ dùng 没.","level":1,"sentenceIds":["s:l1:001","s:l1:004","s:l1:008","s:l1:005","s:l1:007"],"unitId":"l1-u01"}],"sentences":[{"id":"s:l1:004","zh":"我不是你。","pinyin":"Wǒ bú shì nǐ.","vi":"Tôi không phải là bạn.","wordIds":["w:我","w:不","w:是","w:你"],"unitId":"l1-u01"},{"id":"s:l1:005","zh":"他不是我。","pinyin":"Tā bú shì wǒ.","vi":"Anh ấy không phải là tôi.","wordIds":["w:他","w:不","w:是","w:我"],"unitId":"l1-u01"},{"id":"s:l1:007","zh":"我是他。","pinyin":"Wǒ shì tā.","vi":"Tôi là anh ấy.","wordIds":["w:我","w:是","w:他"],"unitId":"l1-u01"},{"id":"s:l1:fill:001","zh":"你好！","pinyin":"Nǐ hǎo!","vi":"Xin chào!","wordIds":["w:你","w:好"],"unitId":"l1-u01"},{"id":"s:l1:fill:002","zh":"谢谢，再见！","pinyin":"Xièxie, zàijiàn!","vi":"Cảm ơn, tạm biệt!","wordIds":["w:谢谢","w:再见"],"unitId":"l1-u01"},{"id":"s:l1:fill:003","zh":"您好！","pinyin":"Nín hǎo!","vi":"Xin chào ạ!","wordIds":["w:您","w:好"],"unitId":"l1-u01"},{"id":"s:l1:fill:045","zh":"你好，你好！","pinyin":"Nǐ hǎo, nǐ hǎo!","vi":"Chào bạn, chào bạn!","wordIds":["w:你","w:好","w:你","w:好"],"unitId":"l1-u01"},{"id":"s:l1:fill:046","zh":"我好，他好。","pinyin":"Wǒ hǎo, tā hǎo.","vi":"Tôi khỏe, anh ấy cũng khỏe.","wordIds":["w:我","w:好","w:他","w:好"],"unitId":"l1-u01"},{"id":"s:l1:fill:047","zh":"对，谢谢你！","pinyin":"Duì, xièxie nǐ!","vi":"Đúng rồi, cảm ơn bạn!","wordIds":["w:对","w:谢谢","w:你"],"unitId":"l1-u01"},{"id":"s:l1:fill:048","zh":"我不再见他。","pinyin":"Wǒ bú zài jiàn tā.","vi":"Tôi sẽ không gặp anh ấy nữa.","wordIds":["w:我","w:不","w:再","w:见","w:他"],"unitId":"l1-u01"},{"id":"s:l1:fill:049","zh":"谢谢您，再见！","pinyin":"Xièxie nín, zàijiàn!","vi":"Cảm ơn ông, tạm biệt!","wordIds":["w:谢谢","w:您","w:再见"],"unitId":"l1-u01"},{"id":"s:l1:fill:050","zh":"您对，我不对。","pinyin":"Nín duì, wǒ bú duì.","vi":"Ông nói đúng, tôi sai.","wordIds":["w:您","w:对","w:我","w:不","w:对"],"unitId":"l1-u01"}]}
