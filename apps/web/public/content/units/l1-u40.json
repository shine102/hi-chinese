{"unit":{"id":"l1-u40","level":1,"order":40,"title":"Daily Phrases","wordIds":["w:请坐","w:请进","w:关上","w:用","w:拿","w:住","w:先","w:常","w:常常","w:一边","w:等","w:看见"],"grammarIds":["g:xian-first","g:changchang-frequency"],"sentenceIds":["s:l1:077","s:l1:078","s:l1:079","s:l1:102","s:l3:219","s:l1:124","s:l1:132","s:l1:133","s:l3:218","s:l1:198","s:l1:134","s:l1:216","s:l1:212","s:l1:050","s:l1:146","s:l1:182","s:l1:080","s:l1:135","s:l3:229","s:l3:230","s:l3:231"]},"grammar":[{"id":"g:xian-first","title":"先 for \"first\" in a sequence","pattern":"先 + verb","explanation":"先 (xiān) means to do something first, before something else happens. It goes before the verb: 我先看 (\"I'll look first\"). It's often paired later with 再 (\"then\"), though each word can also stand alone.","level":1,"sentenceIds":["s:l1:077","s:l1:078","s:l1:079","s:l1:080"],"unitId":"l1-u40"},{"id":"g:changchang-frequency","title":"常/常常 for \"often\"","pattern":"常 / 常常 + verb","explanation":"常 (cháng) means \"often\", and doubling it to 常常 (chángcháng) makes the same meaning a little more emphatic and conversational. Both go directly before the verb, just like other frequency adverbs such as 也 and 都.","level":1,"sentenceIds":["s:l1:132","s:l1:133","s:l1:134","s:l1:135"],"unitId":"l1-u40"}],"sentences":[{"id":"s:l1:077","zh":"我先看。","pinyin":"Wǒ xiān kàn.","en":"I'll look first.","wordIds":["w:我","w:先","w:看"],"unitId":"l1-u40"},{"id":"s:l1:078","zh":"你先说。","pinyin":"Nǐ xiān shuō.","en":"You go first.","wordIds":["w:你","w:先","w:说"],"unitId":"l1-u40"},{"id":"s:l1:079","zh":"他先走了。","pinyin":"Tā xiān zǒu le.","en":"He left first.","wordIds":["w:他","w:先","w:走","w:了"],"unitId":"l1-u40"},{"id":"s:l1:102","zh":"我先看第二个。","pinyin":"Wǒ xiān kàn dì èr gè.","en":"I'll look at the second one first.","wordIds":["w:我","w:先","w:看","w:第二","w:个"],"unitId":"l1-u40"},{"id":"s:l3:219","zh":"他站住不动了。","pinyin":"Tā zhàn zhù bù dòng le.","en":"He stood still, not moving.","wordIds":["w:他","w:站","w:住","w:不","w:动","w:了"],"unitId":"l1-u40"},{"id":"s:l1:124","zh":"我看见他了。","pinyin":"Wǒ kànjiàn tā le.","en":"I saw him.","wordIds":["w:我","w:看见","w:他","w:了"],"unitId":"l1-u40"},{"id":"s:l1:132","zh":"我常去。","pinyin":"Wǒ cháng qù.","en":"I often go.","wordIds":["w:我","w:常","w:去"],"unitId":"l1-u40"},{"id":"s:l1:133","zh":"他常说。","pinyin":"Tā cháng shuō.","en":"He often says that.","wordIds":["w:他","w:常","w:说"],"unitId":"l1-u40"},{"id":"s:l3:218","zh":"请记住我的名字。","pinyin":"Qǐng jì zhù wǒ de míngzi.","en":"Please remember my name.","wordIds":["w:请","w:记","w:住","w:我","w:的","w:名字"],"unitId":"l1-u40"},{"id":"s:l1:198","zh":"你等一会儿。","pinyin":"Nǐ děng yíhuìr.","en":"Wait a moment.","wordIds":["w:你","w:等","w:一会儿"],"unitId":"l1-u40"},{"id":"s:l1:134","zh":"你常常来吗？","pinyin":"Nǐ chángcháng lái ma?","en":"Do you often come?","wordIds":["w:你","w:常常","w:来","w:吗"],"unitId":"l1-u40"},{"id":"s:l1:216","zh":"我等了半天。","pinyin":"Wǒ děngle bàntiān.","en":"I waited a long while.","wordIds":["w:我","w:等","w:了","w:半天"],"unitId":"l1-u40"},{"id":"s:l1:212","zh":"请等一下儿。","pinyin":"Qǐng děng yíxiàr.","en":"Please wait a moment.","wordIds":["w:请","w:等","w:一下儿"],"unitId":"l1-u40"},{"id":"s:l1:050","zh":"这个怎么用？","pinyin":"Zhège zěnme yòng?","en":"How do you use this?","wordIds":["w:这","w:个","w:怎么","w:用"],"unitId":"l1-u40"},{"id":"s:l1:146","zh":"对不起，我没看见。","pinyin":"Duìbuqǐ, wǒ méi kànjiàn.","en":"Sorry, I didn't see it.","wordIds":["w:对不起","w:我","w:没","w:看见"],"unitId":"l1-u40"},{"id":"s:l1:182","zh":"没关系，你先说。","pinyin":"Méi guānxi, nǐ xiān shuō.","en":"It's fine, go ahead and say it.","wordIds":["w:没关系","w:你","w:先","w:说"],"unitId":"l1-u40"},{"id":"s:l1:080","zh":"我们先去这里。","pinyin":"Wǒmen xiān qù zhèlǐ.","en":"Let's go here first.","wordIds":["w:我们","w:先","w:去","w:这里"],"unitId":"l1-u40"},{"id":"s:l1:135","zh":"我们常常在一起。","pinyin":"Wǒmen chángcháng zài yìqǐ.","en":"We're often together.","wordIds":["w:我们","w:常常","w:在","w:一起"],"unitId":"l1-u40"},{"id":"s:l3:229","zh":"他一边吃饭，一边看电视。","pinyin":"Tā yìbiān chīfàn, yìbiān kàn diànshì.","en":"He eats while watching TV.","wordIds":["w:他","w:一边","w:吃饭","w:一边","w:看","w:电视"],"unitId":"l1-u40"},{"id":"s:l3:230","zh":"她一边走，一边打电话。","pinyin":"Tā yìbiān zǒu, yìbiān dǎ diànhuà.","en":"She walks while making a phone call.","wordIds":["w:她","w:一边","w:走","w:一边","w:打电话"],"unitId":"l1-u40"},{"id":"s:l3:231","zh":"我们一边喝茶，一边说话。","pinyin":"Wǒmen yìbiān hē chá, yìbiān shuōhuà.","en":"We drink tea while chatting.","wordIds":["w:我们","w:一边","w:喝","w:茶","w:一边","w:说话"],"unitId":"l1-u40"}]}
