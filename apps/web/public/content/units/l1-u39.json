{"unit":{"id":"l1-u39","level":1,"order":39,"title":"Weather & Nature","wordIds":["w:天气","w:下雨","w:雨","w:风","w:山","w:树","w:见","w:见面","w:看见","w:听见","w:听到","w:看到"],"grammarIds":["g:banian-halfunit","g:weather-desc"],"sentenceIds":["s:l1:142","s:l1:146","s:l1:160","s:l1:209","s:l1:218","s:l1:new:080","s:l1:new:081","s:l1:new:082","s:l1:new:083","s:l1:new:084"]},"grammar":[{"id":"g:banian-halfunit","title":"半天 và 半年 chỉ khoảng thời gian","pattern":"半 + time word (天/年)","explanation":"半 (\"nửa\") kết hợp với từ chỉ thời gian để diễn tả một khoảng thời gian: 半天 (\"nửa ngày\", thường được dùng với nghĩa rộng là \"một khoảng thời gian khá lâu\"), 半年 (\"nửa năm\"). Đặt cụm từ này ở vị trí mà một từ chỉ thời lượng hay thời gian thường đứng.","level":1,"sentenceIds":["s:l1:216","s:l1:217","s:l1:218"],"unitId":"l1-u39"},{"id":"g:weather-desc","title":"Miêu tả thời tiết với 天气","pattern":"天气 + adjective","explanation":"天气 (tiānqì) nghĩa là \"thời tiết\". Miêu tả trực tiếp: 天气好 (Thời tiết đẹp), 天气冷 (Thời tiết lạnh).","level":1,"sentenceIds":["s:l1:new:080","s:l1:new:081"],"unitId":"l1-u39"}],"sentences":[{"id":"s:l1:142","zh":"我们明天见面。","pinyin":"Wǒmen míngtiān jiànmiàn.","vi":"Ngày mai chúng ta gặp nhau.","wordIds":["w:我们","w:明天","w:见面"],"unitId":"l1-u39"},{"id":"s:l1:146","zh":"对不起，我没看见。","pinyin":"Duìbuqǐ, wǒ méi kànjiàn.","vi":"Xin lỗi, tôi không nhìn thấy.","wordIds":["w:对不起","w:我","w:没","w:看见"],"unitId":"l1-u39"},{"id":"s:l1:160","zh":"你们星期几见面？","pinyin":"Nǐmen xīngqī jǐ jiànmiàn?","vi":"Các bạn gặp nhau vào thứ mấy?","wordIds":["w:你们","w:星期","w:几","w:见面"],"unitId":"l1-u39"},{"id":"s:l1:209","zh":"我们星期天见面吧。","pinyin":"Wǒmen xīngqītiān jiànmiàn ba.","vi":"Chúng ta gặp nhau vào Chủ nhật đi.","wordIds":["w:我们","w:星期天","w:见面","w:吧"],"unitId":"l1-u39"},{"id":"s:l1:218","zh":"我们半年见一次。","pinyin":"Wǒmen bànnián jiàn yí cì.","vi":"Chúng tôi nửa năm gặp nhau một lần.","wordIds":["w:我们","w:半年","w:见","w:一","w:次"],"unitId":"l1-u39"},{"id":"s:l1:new:080","zh":"天气好。","pinyin":"Tiānqì hǎo."