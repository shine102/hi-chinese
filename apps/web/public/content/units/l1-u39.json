{"unit":{"id":"l1-u39","level":1,"order":39,"title":"Possession & Measure","wordIds":["w:的","w:地","w:有的","w:有时","w:次","w:第","w:第二","w:最后","w:最好","w:上次","w:下次","w:不大"],"grammarIds":["g:zuihao-suggestion","g:di-ordinal"],"sentenceIds":["s:l1:001","s:l1:101","s:l3:242","s:l1:122","s:l1:149","s:l1:151","s:l1:173","s:l1:008","s:l1:048","s:l1:100","s:l1:103","s:l1:111","s:l3:239","s:l3:241","s:l1:185","s:l1:123","s:l1:150","s:l1:156","s:l1:218","s:l1:152","s:l1:175"]},"grammar":[{"id":"g:zuihao-suggestion","title":"最好 for \"had better\"","pattern":"(Subject +) 最好 + verb","explanation":"最好 (zuìhǎo) softens advice into \"had better\" or \"(it's) best to\": 你最好休息 (\"You'd better rest\"). It can also open a sentence with no subject, as general advice: 最好现在走 (\"Best to leave now\").","level":1,"sentenceIds":["s:l1:149","s:l1:150","s:l1:151","s:l1:152"],"unitId":"l1-u39"},{"id":"g:di-ordinal","title":"第 for ordinal numbers","pattern":"第 + number","explanation":"第 (dì) turns a plain number into an ordinal: 第二 (\"second\"), 第一 (\"first\"). Compare 两个 (\"two [things]\") with 第二个 (\"the second [thing]\") — the meaning changes completely once 第 is added.","level":1,"sentenceIds":["s:l1:100","s:l1:101","s:l1:102","s:l1:103"],"unitId":"l1-u39"}],"sentences":[{"id":"s:l1:001","zh":"这是我的。","pinyin":"Zhè shì wǒ de.","en":"This is mine.","wordIds":["w:这","w:是","w:我","w:的"],"unitId":"l1-u39"},{"id":"s:l1:101","zh":"他是第二。","pinyin":"Tā shì dì èr.","en":"He is second.","wordIds":["w:他","w:是","w:第二"],"unitId":"l1-u39"},{"id":"s:l3:242","zh":"我认识的那个老师很好。","pinyin":"Wǒ rènshi de nàge lǎoshī hěn hǎo.","en":"The teacher I know is very nice.","wordIds":["w:我","w:认识","w:的","w:那","w:个","w:老师","w:很","w:好"],"unitId":"l1-u39"},{"id":"s:l1:122","zh":"我不知道他的名字。","pinyin":"Wǒ bù zhīdào tā de míngzi.","en":"I don't know his name.","wordIds":["w:我","w:不","w:知道","w:他","w:的","w:名字"],"unitId":"l1-u39"},{"id":"s:l1:149","zh":"你最好休息。","pinyin":"Nǐ zuìhǎo xiūxi.","en":"You'd better rest.","wordIds":["w:你","w:最好","w:休息"],"unitId":"l1-u39"},{"id":"s:l1:151","zh":"你最好告诉他。","pinyin":"Nǐ zuìhǎo gàosu tā.","en":"You'd better tell him.","wordIds":["w:你","w:最好","w:告诉","w:他"],"unitId":"l1-u39"},{"id":"s:l1:173","zh":"你说的不对。","pinyin":"Nǐ shuō de búduì.","en":"What you said is wrong.","wordIds":["w:你","w:说","w:的","w:不对"],"unitId":"l1-u39"},{"id":"s:l1:008","zh":"这个是你的。","pinyin":"Zhège shì nǐ de.","en":"This one is yours.","wordIds":["w:这","w:个","w:是","w:你","w:的"],"unitId":"l1-u39"},{"id":"s:l1:048","zh":"这个是我的，那个呢？","pinyin":"Zhège shì wǒ de, nàge ne?","en":"This one is mine, what about that one?","wordIds":["w:这","w:个","w:是","w:我","w:的","w:那","w:个","w:呢"],"unitId":"l1-u39"},{"id":"s:l1:100","zh":"这是第二个。","pinyin":"Zhè shì dì èr gè.","en":"This is the second one.","wordIds":["w:这","w:是","w:第二","w:个"],"unitId":"l1-u39"},{"id":"s:l1:103","zh":"那个是第二。","pinyin":"Nàge shì dì èr.","en":"That one is second.","wordIds":["w:那","w:个","w:是","w:第二"],"unitId":"l1-u39"},{"id":"s:l1:111","zh":"这是第二个，不是两个。","pinyin":"Zhè shì dì èr gè, bú shì liǎng gè.","en":"This is the second one, not two of them.","wordIds":["w:这","w:是","w:第二","w:个","w:不","w:是","w:两","w:个"],"unitId":"l1-u39"},{"id":"s:l3:239","zh":"那个唱歌的人是我朋友。","pinyin":"Nàge chànggē de rén shì wǒ péngyou.","en":"The person singing is my friend.","wordIds":["w:那","w:个","w:唱歌","w:的","w:人","w:是","w:我","w:朋友"],"unitId":"l1-u39"},{"id":"s:l3:241","zh":"开车的那个人是我爸爸。","pinyin":"Kāichē de nàge rén shì wǒ bàba.","en":"The person driving is my dad.","wordIds":["w:开车","w:的","w:那","w:个","w:人","w:是","w:我","w:爸爸"],"unitId":"l1-u39"},{"id":"s:l1:185","zh":"请问，这是谁的？","pinyin":"Qǐngwèn, zhè shì shéi de?","en":"Excuse me, whose is this?","wordIds":["w:请问","w:这","w:是","w:谁","w:的"],"unitId":"l1-u39"},{"id":"s:l1:123","zh":"她们的名字很好。","pinyin":"Tāmen de míngzi hěn hǎo.","en":"Their names are lovely.","wordIds":["w:她们","w:的","w:名字","w:很","w:好"],"unitId":"l1-u39"},{"id":"s:l1:150","zh":"我们最好去。","pinyin":"Wǒmen zuìhǎo qù.","en":"We'd better go.","wordIds":["w:我们","w:最好","w:去"],"unitId":"l1-u39"},{"id":"s:l1:156","zh":"我们的车在中间。","pinyin":"Wǒmen de chē zài zhōngjiān.","en":"Our car is in the middle.","wordIds":["w:我们","w:的","w:车","w:在","w:中间"],"unitId":"l1-u39"},{"id":"s:l1:218","zh":"我们半年见一次。","pinyin":"Wǒmen bànnián jiàn yí cì.","en":"We meet once every half year.","wordIds":["w:我们","w:半年","w:见","w:一","w:次"],"unitId":"l1-u39"},{"id":"s:l1:152","zh":"最好现在走。","pinyin":"Zuìhǎo xiànzài zǒu.","en":"It's best to leave now.","wordIds":["w:最好","w:现在","w:走"],"unitId":"l1-u39"},{"id":"s:l1:175","zh":"下次你来。","pinyin":"Xiàcì nǐ lái.","en":"Come next time.","wordIds":["w:下次","w:你","w:来"],"unitId":"l1-u39"}]}
