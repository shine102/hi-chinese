{"unit":{"id":"l1-u39","level":1,"order":39,"title":"Weather & Nature","wordIds":["w:天气","w:下雨","w:雨","w:风","w:山","w:树","w:见","w:见面","w:看见","w:听见","w:听到","w:看到"],"grammarIds":["g:banian-halfunit","g:weather-desc"],"sentenceIds":["s:l1:142","s:l1:146","s:l1:160","s:l1:209","s:l1:218","s:l1:new:080","s:l1:new:081","s:l1:new:082","s:l1:new:083","s:l1:new:084"]},"grammar":[{"id":"g:banian-halfunit","title":"半天 and 半年 for stretches of time","pattern":"半 + time word (天/年)","explanation":"半 (\"half\") combines with time words to describe a duration: 半天 (\"half a day\", often used loosely to mean \"a long while\"), 半年 (\"half a year\"). Place the resulting phrase where any duration or time word would go.","level":1,"sentenceIds":["s:l1:216","s:l1:217","s:l1:218"],"unitId":"l1-u39"},{"id":"g:weather-desc","title":"Describing weather with 天气","pattern":"天气 + adjective","explanation":"天气 (tiānqì) means 'weather'. Describe it directly: 天气好 (The weather is good), 天气冷 (The weather is cold).","level":1,"sentenceIds":["s:l1:new:080","s:l1:new:081"],"unitId":"l1-u39"}],"sentences":[{"id":"s:l1:142","zh":"我们明天见面。","pinyin":"Wǒmen míngtiān jiànmiàn.","en":"Let's meet tomorrow.","wordIds":["w:我们","w:明天","w:见面"],"unitId":"l1-u39"},{"id":"s:l1:146","zh":"对不起，我没看见。","pinyin":"Duìbuqǐ, wǒ méi kànjiàn.","en":"Sorry, I didn't see it.","wordIds":["w:对不起","w:我","w:没","w:看见"],"unitId":"l1-u39"},{"id":"s:l1:160","zh":"你们星期几见面？","pinyin":"Nǐmen xīngqī jǐ jiànmiàn?","en":"What day are you meeting?","wordIds":["w:你们","w:星期","w:几","w:见面"],"unitId":"l1-u39"},{"id":"s:l1:209","zh":"我们星期天见面吧。","pinyin":"Wǒmen xīngqītiān jiànmiàn ba.","en":"Let's meet on Sunday.","wordIds":["w:我们","w:星期天","w:见面","w:吧"],"unitId":"l1-u39"},{"id":"s:l1:218","zh":"我们半年见一次。","pinyin":"Wǒmen bànnián jiàn yí cì.","en":"We meet once every half year.","wordIds":["w:我们","w:半年","w:见","w:一","w:次"],"unitId":"l1-u39"},{"id":"s:l1:new:080","zh":"天气好。","pinyin":"Tiānqì hǎo.","en":"The weather is good.","wordIds":["w:天气","w:好"],"unitId":"l1-u39"},{"id":"s:l1:new:081","zh":"天气冷。","pinyin":"Tiānqì lěng.","en":"The weather is cold.","wordIds":["w:天气","w:冷"],"unitId":"l1-u39"},{"id":"s:l1:new:082","zh":"下雨。","pinyin":"Xià yǔ.","en":"It's raining.","wordIds":["w:下雨"],"unitId":"l1-u39"},{"id":"s:l1:new:083","zh":"山大。","pinyin":"Shān dà.","en":"The mountain is big.","wordIds":["w:山","w:大"],"unitId":"l1-u39"},{"id":"s:l1:new:084","zh":"风大。","pinyin":"Fēng dà.","en":"The wind is strong.","wordIds":["w:风","w:大"],"unitId":"l1-u39"}]}
