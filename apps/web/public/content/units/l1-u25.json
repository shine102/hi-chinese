{"unit":{"id":"l1-u25","level":1,"order":25,"title":"On the Road","wordIds":["w:路","w:路上","w:路口","w:马路","w:走路","w:远","w:地图","w:有名","w:到","w:从","w:坐下","w:花"],"grammarIds":["g:zuoxia-settle"],"sentenceIds":["s:l1:213","s:l1:new:085"]},"grammar":[{"id":"g:zuoxia-settle","title":"坐下 nghĩa là \"ngồi xuống\"","pattern":"坐下","explanation":"坐下 (zuòxia) kết hợp 坐 (\"ngồi\") với 下 để diễn tả hành động ngồi xuống một tư thế — \"ngồi xuống\". Dùng nó cho hành động ngồi xuống, khác với 坐 đứng một mình, vốn cũng có thể chỉ đơn giản là \"đang ngồi\".","level":1,"sentenceIds":["s:l1:213","s:l1:214","s:l1:215"],"unitId":"l1-u25"}],"sentences":[{"id":"s:l1:213","zh":"请坐下。","pinyin":"Qǐng zuòxia.","vi":"Mời ngồi xuống.","wordIds":["w:请","w:坐下"],"unitId":"l1-u25"},{"id":"s:l1:new:085","zh":"这个地方有名。","pinyin":"Zhège dìfang yǒumíng.","vi":"Nơi này nổi tiếng.","wordIds":["w:这","w:个","w:地方","w:有名"],"unitId":"l1-u25"}]}
