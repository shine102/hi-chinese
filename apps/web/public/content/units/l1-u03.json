{"unit":{"id":"l1-u03","level":1,"order":3,"title":"Unit 3","wordIds":["w:上","w:来","w:很","w:还","w:去","w:她","w:着","w:想","w:给","w:没有","w:能","w:那"],"grammarIds":["g:hen-adjective","g:neng-ability"],"sentenceIds":["s:l1:009","s:l1:010","s:l1:011","s:l1:012","s:l1:013","s:l1:014","s:l1:015","s:l1:016","s:l1:017","s:l1:018","s:l1:019","s:l1:020"]},"grammar":[{"id":"g:hen-adjective","title":"很 + adjective for descriptions","pattern":"Subject + 很 + adjective","explanation":"很 (hěn) goes right before an adjective used as the predicate, since Chinese adjectives don't need a separate \"to be\" verb. Even when it isn't emphasizing \"very\", 很 is often still included just to sound natural — an adjective alone can sound like an unfinished comparison. Never add 是 before the adjective.","level":1,"sentenceIds":["s:l1:009","s:l1:010","s:l1:011","s:l1:012"],"unitId":"l1-u03"},{"id":"g:neng-ability","title":"能 for ability or permission","pattern":"Subject + 能 + verb","explanation":"能 (néng) means \"can\" — able to do something because of ability, permission, or circumstance. It goes directly before the verb. Negate it with 不能 (bù néng), \"cannot\".","level":1,"sentenceIds":["s:l1:013","s:l1:014","s:l1:015","s:l1:016"],"unitId":"l1-u03"}],"sentences":[{"id":"s:l1:009","zh":"她很好。","pinyin":"Tā hěn hǎo.","en":"She is very good.","wordIds":["w:她","w:很","w:好"],"unitId":"l1-u03"},{"id":"s:l1:010","zh":"我们都很好。","pinyin":"Wǒmen dōu hěn hǎo.","en":"We are all fine.","wordIds":["w:我们","w:都","w:很","w:好"],"unitId":"l1-u03"},{"id":"s:l1:011","zh":"你也很好。","pinyin":"Nǐ yě hěn hǎo.","en":"You are great too.","wordIds":["w:你","w:也","w:很","w:好"],"unitId":"l1-u03"},{"id":"s:l1:012","zh":"这个很好。","pinyin":"Zhège hěn hǎo.","en":"This one is very good.","wordIds":["w:这","w:个","w:很","w:好"],"unitId":"l1-u03"},{"id":"s:l1:013","zh":"我能去。","pinyin":"Wǒ néng qù.","en":"I can go.","wordIds":["w:我","w:能","w:去"],"unitId":"l1-u03"},{"id":"s:l1:014","zh":"他不能来。","pinyin":"Tā bù néng lái.","en":"He can't come.","wordIds":["w:他","w:不","w:能","w:来"],"unitId":"l1-u03"},{"id":"s:l1:015","zh":"你能来。","pinyin":"Nǐ néng lái.","en":"You can come.","wordIds":["w:你","w:能","w:来"],"unitId":"l1-u03"},{"id":"s:l1:016","zh":"我们都能去。","pinyin":"Wǒmen dōu néng qù.","en":"We can all go.","wordIds":["w:我们","w:都","w:能","w:去"],"unitId":"l1-u03"},{"id":"s:l1:017","zh":"我给你。","pinyin":"Wǒ gěi nǐ.","en":"I'll give it to you.","wordIds":["w:我","w:给","w:你"],"unitId":"l1-u03"},{"id":"s:l1:018","zh":"他给我们。","pinyin":"Tā gěi wǒmen.","en":"He gives it to us.","wordIds":["w:他","w:给","w:我们"],"unitId":"l1-u03"},{"id":"s:l1:019","zh":"你给他。","pinyin":"Nǐ gěi tā.","en":"Give it to him.","wordIds":["w:你","w:给","w:他"],"unitId":"l1-u03"},{"id":"s:l1:020","zh":"我给你一个。","pinyin":"Wǒ gěi nǐ yí gè.","en":"I'll give you one.","wordIds":["w:我","w:给","w:你","w:一","w:个"],"unitId":"l1-u03"}]}
