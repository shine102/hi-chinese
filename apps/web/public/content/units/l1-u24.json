{"unit":{"id":"l1-u24","level":1,"order":24,"title":"Directions","wordIds":["w:左边","w:右边","w:上边","w:下边","w:前边","w:后边","w:东边","w:西边","w:南边","w:北边","w:地点","w:地上"],"grammarIds":["g:direction-bian"],"sentenceIds":["s:l1:new3:009","s:l1:new3:010","s:l1:new3:011","s:l1:new3:012","s:l1:new3:013","s:l1:new3:014"]},"grammar":[{"id":"g:direction-bian","title":"Direction + 边","pattern":"方位词 + 边","explanation":"Add 边 (biān, side) to a direction word to say 'on the left/right/east/etc. side': 左边 (left side), 右边 (right side), 前边 (front), 后边 (back). These follow 在 to say where something is: 在左边 (on the left).","level":1,"sentenceIds":["s:l1:new3:009","s:l1:new3:010","s:l1:new3:011"],"unitId":"l1-u24"}],"sentences":[{"id":"s:l1:new3:009","zh":"在左边。","pinyin":"Zài zuǒbian.","en":"It's on the left.","wordIds":["w:在","w:左边"],"unitId":"l1-u24"},{"id":"s:l1:new3:010","zh":"门在右边。","pinyin":"Mén zài yòubian.","en":"The door is on the right.","wordIds":["w:门","w:在","w:右边"],"unitId":"l1-u24"},{"id":"s:l1:new3:011","zh":"他在前边。","pinyin":"Tā zài qiánbian.","en":"He is in front.","wordIds":["w:他","w:在","w:前边"],"unitId":"l1-u24"},{"id":"s:l1:new3:012","zh":"楼在后边。","pinyin":"Lóu zài hòubian.","en":"The building is in the back.","wordIds":["w:楼","w:在","w:后边"],"unitId":"l1-u24"},{"id":"s:l1:new3:013","zh":"东边有人。","pinyin":"Dōngbian yǒu rén.","en":"There's someone to the east.","wordIds":["w:东边","w:有","w:人"],"unitId":"l1-u24"},{"id":"s:l1:new3:014","zh":"在地上。","pinyin":"Zài dìshang.","en":"It's on the ground.","wordIds":["w:在","w:地上"],"unitId":"l1-u24"}]}
