{"unit":{"id":"l1-u24","level":1,"order":24,"title":"Unit 24","wordIds":["w:关","w:哥","w:爸","w:风","w:回去","w:累","w:打开","w:病人","w:肉","w:打电话","w:休息","w:班"],"grammarIds":["g:gei-dianhua"],"sentenceIds":["s:l1:136","s:l1:137","s:l1:138","s:l1:139","s:l3:235"]},"grammar":[{"id":"g:gei-dianhua","title":"给...打电话 for calling someone","pattern":"给 + person + 打电话","explanation":"打电话 (dǎ diànhuà) means \"to make a phone call\". To say who you're calling, insert 给 + person right before it: 我给你打电话 (\"I'll call you\"). Don't put the person directly before 打电话 without 给.","level":1,"sentenceIds":["s:l1:136","s:l1:137","s:l1:138","s:l1:139"],"unitId":"l1-u24"}],"sentences":[{"id":"s:l1:136","zh":"我给你打电话。","pinyin":"Wǒ gěi nǐ dǎ diànhuà.","en":"I'll call you.","wordIds":["w:我","w:给","w:你","w:打电话"],"unitId":"l1-u24"},{"id":"s:l1:137","zh":"他给我打电话了。","pinyin":"Tā gěi wǒ dǎ diànhuà le.","en":"He called me.","wordIds":["w:他","w:给","w:我","w:打电话","w:了"],"unitId":"l1-u24"},{"id":"s:l1:138","zh":"请给我打电话。","pinyin":"Qǐng gěi wǒ dǎ diànhuà.","en":"Please call me.","wordIds":["w:请","w:给","w:我","w:打电话"],"unitId":"l1-u24"},{"id":"s:l1:139","zh":"你给谁打电话？","pinyin":"Nǐ gěi shéi dǎ diànhuà?","en":"Who are you calling?","wordIds":["w:你","w:给","w:谁","w:打电话"],"unitId":"l1-u24"},{"id":"s:l3:235","zh":"他一到家就打电话给我。","pinyin":"Tā yī dào jiā jiù dǎ diànhuà gěi wǒ.","en":"As soon as he got home, he called me.","wordIds":["w:他","w:一","w:到","w:家","w:就","w:打电话","w:给","w:我"],"unitId":"l1-u24"}]}
