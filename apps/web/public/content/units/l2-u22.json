{"unit":{"id":"l2-u22","level":2,"order":64,"title":"Unit 22","wordIds":["w:样子","w:实现","w:刚才","w:猫","w:通","w:办公室","w:正确","w:爱情","w:收到","w:够","w:正是","w:方向"],"grammarIds":["g:gangcai-just-now"],"sentenceIds":["s:l2:141","s:l2:142","s:l2:143","s:l2:144"]},"grammar":[{"id":"g:gangcai-just-now","title":"A moment ago with 刚才","pattern":"刚才 + clause","explanation":"刚才 (gāngcái) means \"just now, a moment ago\" it refers to a point in the very recent past, within the same conversation or day. Compare with 刚 (right before the verb, \"just did\").","level":2,"sentenceIds":["s:l2:141","s:l2:142","s:l2:143","s:l2:144"],"unitId":"l2-u22"}],"sentences":[{"id":"s:l2:141","zh":"刚才谁来了？","pinyin":"Gāngcái shéi lái le?","en":"Who came just now?","wordIds":["w:刚才","w:谁","w:来","w:了"],"unitId":"l2-u22"},{"id":"s:l2:142","zh":"我刚才在看电视。","pinyin":"Wǒ gāngcái zài kàn diànshì.","en":"I was watching TV just now.","wordIds":["w:我","w:刚才","w:在","w:看","w:电视"],"unitId":"l2-u22"},{"id":"s:l2:143","zh":"他刚才说了什么？","pinyin":"Tā gāngcái shuō le shénme?","en":"What did he say just now?","wordIds":["w:他","w:刚才","w:说","w:了","w:什么"],"unitId":"l2-u22"},{"id":"s:l2:144","zh":"刚才的问题很难。","pinyin":"Gāngcái de wèntí hěn nán.","en":"The question from just now was hard.","wordIds":["w:刚才","w:的","w:问题","w:很","w:难"],"unitId":"l2-u22"}]}
