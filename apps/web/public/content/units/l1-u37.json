{"unit":{"id":"l1-u37","level":1,"order":37,"title":"Also & All","wordIds":["w:也","w:都","w:和","w:跟","w:还","w:还有","w:见","w:再","w:就","w:马上","w:一起","w:一会儿"],"grammarIds":["g:gen-with"],"sentenceIds":["s:l1:011","s:l1:053","s:l1:054","s:l1:055","s:l1:056","s:l3:235","s:l1:197","s:l1:016","s:l1:047","s:l1:205","s:l1:010","s:l1:190","s:l1:214"]},"grammar":[{"id":"g:gen-with","title":"跟 for \"with someone\"","pattern":"Subject + 跟 + person + verb","explanation":"跟 (gēn) introduces a companion — \"with\" someone. It comes before the verb, not after: 我跟你去 (\"I'll go with you\"), not 我去跟你.","level":1,"sentenceIds":["s:l1:053","s:l1:054","s:l1:055","s:l1:056"],"unitId":"l1-u37"}],"sentences":[{"id":"s:l1:011","zh":"你也很好。","pinyin":"Nǐ yě hěn hǎo.","en":"You are great too.","wordIds":["w:你","w:也","w:很","w:好"],"unitId":"l1-u37"},{"id":"s:l1:053","zh":"我跟你去。","pinyin":"Wǒ gēn nǐ qù.","en":"I'll go with you.","wordIds":["w:我","w:跟","w:你","w:去"],"unitId":"l1-u37"},{"id":"s:l1:054","zh":"他跟谁去？","pinyin":"Tā gēn shéi qù?","en":"Who is he going with?","wordIds":["w:他","w:跟","w:谁","w:去"],"unitId":"l1-u37"},{"id":"s:l1:055","zh":"你跟他说。","pinyin":"Nǐ gēn tā shuō.","en":"Talk to him.","wordIds":["w:你","w:跟","w:他","w:说"],"unitId":"l1-u37"},{"id":"s:l1:056","zh":"我喜欢跟你说。","pinyin":"Wǒ xǐhuan gēn nǐ shuō.","en":"I like talking with you.","wordIds":["w:我","w:喜欢","w:跟","w:你","w:说"],"unitId":"l1-u37"},{"id":"s:l3:235","zh":"他一到家就打电话给我。","pinyin":"Tā yī dào jiā jiù dǎ diànhuà gěi wǒ.","en":"As soon as he got home, he called me.","wordIds":["w:他","w:一","w:到","w:家","w:就","w:打电话","w:给","w:我"],"unitId":"l1-u37"},{"id":"s:l1:197","zh":"他也在这儿。","pinyin":"Tā yě zài zhèr.","en":"He's here too.","wordIds":["w:他","w:也","w:在","w:这儿"],"unitId":"l1-u37"},{"id":"s:l1:016","zh":"我们都能去。","pinyin":"Wǒmen dōu néng qù.","en":"We can all go.","wordIds":["w:我们","w:都","w:能","w:去"],"unitId":"l1-u37"},{"id":"s:l1:047","zh":"我们都想去，他呢？","pinyin":"Wǒmen dōu xiǎng qù, tā ne?","en":"We all want to go, what about him?","wordIds":["w:我们","w:都","w:想","w:去","w:他","w:呢"],"unitId":"l1-u37"},{"id":"s:l1:205","zh":"昨天，今天，明天都很忙。","pinyin":"Zuótiān, jīntiān, míngtiān dōu hěn máng.","en":"Yesterday, today, tomorrow — all busy.","wordIds":["w:昨天","w:今天","w:明天","w:都","w:很","w:忙"],"unitId":"l1-u37"},{"id":"s:l1:010","zh":"我们都很好。","pinyin":"Wǒmen dōu hěn hǎo.","en":"We are all fine.","wordIds":["w:我们","w:都","w:很","w:好"],"unitId":"l1-u37"},{"id":"s:l1:190","zh":"我们都是学生。","pinyin":"Wǒmen dōu shì xuésheng.","en":"We are all students.","wordIds":["w:我们","w:都","w:是","w:学生"],"unitId":"l1-u37"},{"id":"s:l1:214","zh":"你们都坐下吧。","pinyin":"Nǐmen dōu zuòxia ba.","en":"Everyone please sit down.","wordIds":["w:你们","w:都","w:坐下","w:吧"],"unitId":"l1-u37"}]}
