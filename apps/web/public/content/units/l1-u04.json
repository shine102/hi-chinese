{"unit":{"id":"l1-u04","level":1,"order":4,"title":"Unit 4","wordIds":["w:他们","w:看","w:做","w:什么","w:吧","w:点","w:过","w:没","w:大","w:从","w:下","w:中"],"grammarIds":["g:gei-recipient","g:meiyou-negation"],"sentenceIds":["s:l1:021","s:l1:022","s:l1:023","s:l1:024","s:l1:025","s:l1:026","s:l1:027","s:l1:028","s:l1:029","s:l1:030","s:l1:031","s:l1:032","s:l1:147","s:l1:219","s:l1:221"]},"grammar":[{"id":"g:gei-recipient","title":"给 for giving to someone","pattern":"Subject + 给 + person (+ object)","explanation":"给 (gěi) means \"to give\" or introduces the person something is done \"for/to\". It comes before the recipient: 我给你 means \"I give it to you\". Like other simple verbs, it can stand alone in a short sentence.","level":1,"sentenceIds":["s:l1:017","s:l1:018","s:l1:019","s:l1:020"],"unitId":"l1-u04"},{"id":"g:meiyou-negation","title":"没 for negating past actions","pattern":"没 + verb","explanation":"没 (méi) says an action didn't happen, which is different from 不, which negates general facts or habits. 我没去 means \"I didn't go\", not \"I don't go\". 没 is a short form of 没有 in this use.","level":1,"sentenceIds":["s:l1:021","s:l1:022","s:l1:023","s:l1:024"],"unitId":"l1-u04"}],"sentences":[{"id":"s:l1:021","zh":"我没去。","pinyin":"Wǒ méi qù.","en":"I didn't go.","wordIds":["w:我","w:没","w:去"],"unitId":"l1-u04"},{"id":"s:l1:022","zh":"他没看。","pinyin":"Tā méi kàn.","en":"He didn't look.","wordIds":["w:他","w:没","w:看"],"unitId":"l1-u04"},{"id":"s:l1:023","zh":"我们没做。","pinyin":"Wǒmen méi zuò.","en":"We didn't do it.","wordIds":["w:我们","w:没","w:做"],"unitId":"l1-u04"},{"id":"s:l1:024","zh":"你没来。","pinyin":"Nǐ méi lái.","en":"You didn't come.","wordIds":["w:你","w:没","w:来"],"unitId":"l1-u04"},{"id":"s:l1:025","zh":"你想做什么？","pinyin":"Nǐ xiǎng zuò shénme?","en":"What do you want to do?","wordIds":["w:你","w:想","w:做","w:什么"],"unitId":"l1-u04"},{"id":"s:l1:026","zh":"他说什么？","pinyin":"Tā shuō shénme?","en":"What did he say?","wordIds":["w:他","w:说","w:什么"],"unitId":"l1-u04"},{"id":"s:l1:027","zh":"这是什么？","pinyin":"Zhè shì shénme?","en":"What is this?","wordIds":["w:这","w:是","w:什么"],"unitId":"l1-u04"},{"id":"s:l1:028","zh":"你看什么？","pinyin":"Nǐ kàn shénme?","en":"What are you looking at?","wordIds":["w:你","w:看","w:什么"],"unitId":"l1-u04"},{"id":"s:l1:029","zh":"我们去吧。","pinyin":"Wǒmen qù ba.","en":"Let's go.","wordIds":["w:我们","w:去","w:吧"],"unitId":"l1-u04"},{"id":"s:l1:030","zh":"你说吧。","pinyin":"Nǐ shuō ba.","en":"Go ahead, say it.","wordIds":["w:你","w:说","w:吧"],"unitId":"l1-u04"},{"id":"s:l1:031","zh":"我们看吧。","pinyin":"Wǒmen kàn ba.","en":"Let's take a look.","wordIds":["w:我们","w:看","w:吧"],"unitId":"l1-u04"},{"id":"s:l1:032","zh":"你来吧。","pinyin":"Nǐ lái ba.","en":"Come on then.","wordIds":["w:你","w:来","w:吧"],"unitId":"l1-u04"},{"id":"s:l1:147","zh":"没什么。","pinyin":"Méi shénme.","en":"It's nothing.","wordIds":["w:没","w:什么"],"unitId":"l1-u04"},{"id":"s:l1:219","zh":"这个不大。","pinyin":"Zhège bú dà.","en":"This isn't very big.","wordIds":["w:这","w:个","w:不","w:大"],"unitId":"l1-u04"},{"id":"s:l1:221","zh":"他不大想去。","pinyin":"Tā bú dà xiǎng qù.","en":"He doesn't really want to go.","wordIds":["w:他","w:不","w:大","w:想","w:去"],"unitId":"l1-u04"}]}
