{"unit":{"id":"l1-u04","level":1,"order":4,"title":"My Family","wordIds":["w:家","w:的","w:爸爸","w:妈妈","w:哥哥","w:姐姐","w:弟弟","w:妹妹","w:爷爷","w:奶奶","w:儿子","w:女儿"],"grammarIds":["g:shi-family"],"sentenceIds":["s:l1:new:001","s:l1:new:002","s:l1:new:003","s:l1:new:004","s:l1:new:006","s:l1:new:007"]},"grammar":[{"id":"g:shi-family","title":"Introducing family with 是","pattern":"person + 是 + 我 + family member","explanation":"Use 是 (shì) to identify a family member: 他是我爸爸 (He is my dad). The pattern works for any family role.","level":1,"sentenceIds":["s:l1:new:001","s:l1:new:002","s:l1:new:003"],"unitId":"l1-u04"}],"sentences":[{"id":"s:l1:new:001","zh":"他是我爸爸。","pinyin":"Tā shì wǒ bàba.","en":"He is my dad.","wordIds":["w:他","w:是","w:我","w:爸爸"],"unitId":"l1-u04"},{"id":"s:l1:new:002","zh":"她是我妈妈。","pinyin":"Tā shì wǒ māma.","en":"She is my mom.","wordIds":["w:她","w:是","w:我","w:妈妈"],"unitId":"l1-u04"},{"id":"s:l1:new:003","zh":"他不是我哥哥。","pinyin":"Tā bú shì wǒ gēge.","en":"He is not my older brother.","wordIds":["w:他","w:不","w:是","w:我","w:哥哥"],"unitId":"l1-u04"},{"id":"s:l1:new:004","zh":"她是姐姐。","pinyin":"Tā shì jiějie.","en":"She is the older sister.","wordIds":["w:她","w:是","w:姐姐"],"unitId":"l1-u04"},{"id":"s:l1:new:006","zh":"爷爷好！","pinyin":"Yéye hǎo!","en":"Hi Grandpa!","wordIds":["w:爷爷","w:好"],"unitId":"l1-u04"},{"id":"s:l1:new:007","zh":"奶奶好！","pinyin":"Nǎinai hǎo!","en":"Hi Grandma!","wordIds":["w:奶奶","w:好"],"unitId":"l1-u04"}]}
