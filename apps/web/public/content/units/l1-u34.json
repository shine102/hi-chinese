{"unit":{"id":"l1-u34","level":1,"order":34,"title":"Unit 34","wordIds":["w:那儿","w:商店","w:鸡蛋","w:没关系","w:地图","w:姐","w:坐下","w:零","w:桌子","w:白天","w:请问","w:哪些"],"grammarIds":["g:meiguanxi-itsok","g:qingwen-excuseme"],"sentenceIds":["s:l1:176","s:l1:181","s:l1:182","s:l1:183","s:l1:184","s:l1:185","s:l1:186","s:l1:195","s:l1:213","s:l1:214","s:l1:215"]},"grammar":[{"id":"g:meiguanxi-itsok","title":"没关系 for \"it's OK\"","pattern":"没关系","explanation":"没关系 (méi guānxi) means \"it doesn't matter\" or \"no worries\" — a common reply when someone apologizes or worries about causing trouble. It pairs naturally with 对不起.","level":1,"sentenceIds":["s:l1:181","s:l1:182","s:l1:183"],"unitId":"l1-u34"},{"id":"g:qingwen-excuseme","title":"请问 for \"excuse me, may I ask\"","pattern":"请问, + question","explanation":"请问 (qǐngwèn) politely opens a question, similar to \"Excuse me, ...\" or \"May I ask...\". It always comes first, before the actual question.","level":1,"sentenceIds":["s:l1:184","s:l1:185","s:l1:186"],"unitId":"l1-u34"}],"sentences":[{"id":"s:l1:176","zh":"商店在右边。","pinyin":"Shāngdiàn zài yòubian.","en":"The store is on the right.","wordIds":["w:商店","w:在","w:右边"],"unitId":"l1-u34"},{"id":"s:l1:181","zh":"没关系。","pinyin":"Méi guānxi.","en":"It's OK.","wordIds":["w:没关系"],"unitId":"l1-u34"},{"id":"s:l1:182","zh":"没关系，你先说。","pinyin":"Méi guānxi, nǐ xiān shuō.","en":"It's fine, go ahead and say it.","wordIds":["w:没关系","w:你","w:先","w:说"],"unitId":"l1-u34"},{"id":"s:l1:183","zh":"没关系，我不忙。","pinyin":"Méi guānxi, wǒ bù máng.","en":"It's OK, I'm not busy.","wordIds":["w:没关系","w:我","w:不","w:忙"],"unitId":"l1-u34"},{"id":"s:l1:184","zh":"请问，你叫什么名字？","pinyin":"Qǐngwèn, nǐ jiào shénme míngzi?","en":"Excuse me, what's your name?","wordIds":["w:请问","w:你","w:叫","w:什么","w:名字"],"unitId":"l1-u34"},{"id":"s:l1:185","zh":"请问，这是谁的？","pinyin":"Qǐngwèn, zhè shì shéi de?","en":"Excuse me, whose is this?","wordIds":["w:请问","w:这","w:是","w:谁","w:的"],"unitId":"l1-u34"},{"id":"s:l1:186","zh":"请问，商店在哪里？","pinyin":"Qǐngwèn, shāngdiàn zài nǎlǐ?","en":"Excuse me, where's the store?","wordIds":["w:请问","w:商店","w:在","w:哪里"],"unitId":"l1-u34"},{"id":"s:l1:195","zh":"我们那儿很好。","pinyin":"Wǒmen nàr hěn hǎo.","en":"Our place is really nice.","wordIds":["w:我们","w:那儿","w:很","w:好"],"unitId":"l1-u34"},{"id":"s:l1:213","zh":"请坐下。","pinyin":"Qǐng zuòxia.","en":"Please sit down.","wordIds":["w:请","w:坐下"],"unitId":"l1-u34"},{"id":"s:l1:214","zh":"你们都坐下吧。","pinyin":"Nǐmen dōu zuòxia ba.","en":"Everyone please sit down.","wordIds":["w:你们","w:都","w:坐下","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:215","zh":"他坐下了。","pinyin":"Tā zuòxia le.","en":"He sat down.","wordIds":["w:他","w:坐下","w:了"],"unitId":"l1-u34"}]}
