{"unit":{"id":"l1-u34","level":1,"order":34,"title":"Descriptions","wordIds":["w:很","w:真","w:太","w:最","w:非常","w:比","w:少","w:一样","w:间","w:坏","w:重","w:重要"],"grammarIds":["g:hen-adjective","g:bi-comparison","g:zui-superlative"],"sentenceIds":["s:l1:009","s:l1:042","s:l1:057","s:l1:059","s:l1:093","s:l1:044","s:l1:012","s:l1:041","s:l1:043","s:l1:058","s:l1:060","s:l1:224"]},"grammar":[{"id":"g:hen-adjective","title":"很 + adjective for descriptions","pattern":"Subject + 很 + adjective","explanation":"很 (hěn) goes right before an adjective used as the predicate, since Chinese adjectives don't need a separate \"to be\" verb. Even when it isn't emphasizing \"very\", 很 is often still included just to sound natural — an adjective alone can sound like an unfinished comparison. Never add 是 before the adjective.","level":1,"sentenceIds":["s:l1:009","s:l1:010","s:l1:011","s:l1:012"],"unitId":"l1-u34"},{"id":"g:bi-comparison","title":"比 for comparisons","pattern":"A + 比 + B + adjective","explanation":"比 (bǐ) compares two things directly: A 比 B + adjective means \"A is more [adjective] than B\". Don't add 很 before the adjective in this pattern — 比 already carries the comparison.","level":1,"sentenceIds":["s:l1:057","s:l1:058","s:l1:059","s:l1:060"],"unitId":"l1-u34"},{"id":"g:zui-superlative","title":"最 for superlatives","pattern":"最 + adjective","explanation":"最 (zuì) makes an adjective superlative, like English \"-est\" or \"most\". Place it directly before the adjective: 最好 (best), 最大 (biggest). No extra word for \"the\" is needed.","level":1,"sentenceIds":["s:l1:041","s:l1:042","s:l1:043","s:l1:044"],"unitId":"l1-u34"}],"sentences":[{"id":"s:l1:009","zh":"她很好。","pinyin":"Tā hěn hǎo.","en":"She is very good.","wordIds":["w:她","w:很","w:好"],"unitId":"l1-u34"},{"id":"s:l1:042","zh":"他最大。","pinyin":"Tā zuì dà.","en":"He is the oldest.","wordIds":["w:他","w:最","w:大"],"unitId":"l1-u34"},{"id":"s:l1:057","zh":"他比我快。","pinyin":"Tā bǐ wǒ kuài.","en":"He is faster than me.","wordIds":["w:他","w:比","w:我","w:快"],"unitId":"l1-u34"},{"id":"s:l1:059","zh":"我比他大。","pinyin":"Wǒ bǐ tā dà.","en":"I am older than him.","wordIds":["w:我","w:比","w:他","w:大"],"unitId":"l1-u34"},{"id":"s:l1:093","zh":"今天我很好。","pinyin":"Jīntiān wǒ hěn hǎo.","en":"Today I'm doing well.","wordIds":["w:今天","w:我","w:很","w:好"],"unitId":"l1-u34"},{"id":"s:l1:044","zh":"我最想去。","pinyin":"Wǒ zuì xiǎng qù.","en":"I want to go the most.","wordIds":["w:我","w:最","w:想","w:去"],"unitId":"l1-u34"},{"id":"s:l1:012","zh":"这个很好。","pinyin":"Zhège hěn hǎo.","en":"This one is very good.","wordIds":["w:这","w:个","w:很","w:好"],"unitId":"l1-u34"},{"id":"s:l1:041","zh":"这个最好。","pinyin":"Zhège zuì hǎo.","en":"This one is the best.","wordIds":["w:这","w:个","w:最","w:好"],"unitId":"l1-u34"},{"id":"s:l1:043","zh":"那个最小。","pinyin":"Nàge zuì xiǎo.","en":"That one is the smallest.","wordIds":["w:那","w:个","w:最","w:小"],"unitId":"l1-u34"},{"id":"s:l1:058","zh":"这个比那个好。","pinyin":"Zhège bǐ nàge hǎo.","en":"This one is better than that one.","wordIds":["w:这","w:个","w:比","w:那","w:个","w:好"],"unitId":"l1-u34"},{"id":"s:l1:060","zh":"那个比这个小。","pinyin":"Nàge bǐ zhège xiǎo.","en":"That one is smaller than this one.","wordIds":["w:那","w:个","w:比","w:这","w:个","w:小"],"unitId":"l1-u34"},{"id":"s:l1:224","zh":"汉字很难。","pinyin":"Hànzì hěn nán.","en":"Chinese characters are difficult.","wordIds":["w:汉字","w:很","w:难"],"unitId":"l1-u34"}]}
