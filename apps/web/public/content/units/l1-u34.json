{"unit":{"id":"l1-u34","level":1,"order":34,"title":"Trò Chuyện","wordIds":["w:话","w:说话","w:回答","w:告诉","w:知道","w:怎么","w:行","w:吧","w:别的","w:没事儿"],"grammarIds":["g:ba-suggestion","g:zenme-how"],"sentenceIds":["s:l1:029","s:l1:030","s:l1:031","s:l1:032","s:l1:049","s:l1:050","s:l1:051","s:l1:119","s:l1:122","s:l1:140","s:l1:151","s:l1:214","s:l3:231"]},"grammar":[{"id":"g:ba-suggestion","title":"吧 dùng để gợi ý và đề nghị","pattern":"Sentence + 吧","explanation":"吧 (ba) làm câu nói trở nên nhẹ nhàng hơn, mang tính gợi ý, đề nghị hoặc phỏng đoán. 我们去吧 nghe giống như \"Đi thôi nào\", thân thiện hơn một câu khẳng định bình thường. 吧 luôn đứng ở cuối câu.","level":1,"sentenceIds":["s:l1:029","s:l1:030","s:l1:031","s:l1:032"],"unitId":"l1-u34"},{"id":"g:zenme-how","title":"怎么 dùng để hỏi \"như thế nào\"","pattern":"怎么 + verb","explanation":"怎么 (zěnme) dùng để hỏi về cách thức hay phương pháp — \"như thế nào\". Nó đứng ngay trước động từ: 这个怎么用? (\"Cái này dùng thế nào?\"). 你怎么了? là cách hỏi cố định nghĩa là \"Bạn làm sao vậy?\"","level":1,"sentenceIds":["s:l1:049","s:l1:050","s:l1:051","s:l1:052"],"unitId":"l1-u34"}],"sentences":[{"id":"s:l1:029","zh":"我们去吧。","pinyin":"Wǒmen qù ba.","vi":"Chúng ta đi thôi.","wordIds":["w:我们","w:去","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:030","zh":"你说吧。","pinyin":"Nǐ shuō ba.","vi":"Bạn nói đi.","wordIds":["w:你","w:说","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:031","zh":"我们看吧。","pinyin":"Wǒmen kàn ba.","vi":"Chúng ta xem đi.","wordIds":["w:我们","w:看","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:032","zh":"你来吧。","pinyin":"Nǐ lái ba.","vi":"Bạn đến đi.","wordIds":["w:你","w:来","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:049","zh":"你怎么知道？","pinyin":"Nǐ zěnme zhīdào?","vi":"Làm sao bạn biết được?","wordIds":["w:你","w:怎么","w:知道"],"unitId":"l1-u34"},{"id":"s:l1:050","zh":"这个怎么用？","pinyin":"Zhège zěnme yòng?","vi":"Cái này dùng thế nào?","wordIds":["w:这","w:个","w:怎么","w:用"],"unitId":"l1-u34"},{"id":"s:l1:051","zh":"他怎么走？","pinyin":"Tā zěnme zǒu?","vi":"Anh ấy đi như thế nào?","wordIds":["w:他","w:怎么","w:走"],"unitId":"l1-u34"},{"id":"s:l1:119","zh":"我们去那里吧。","pinyin":"Wǒmen qù nàlǐ ba.","vi":"Chúng ta đến đó đi.","wordIds":["w:我们","w:去","w:那里","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:122","zh":"我不知道他的名字。","pinyin":"Wǒ bù zhīdào tā de míngzi.","vi":"Tôi không biết tên anh ấy.","wordIds":["w:我","w:不","w:知道","w:他","w:的","w:名字"],"unitId":"l1-u34"},{"id":"s:l1:140","zh":"我们去吃饭吧。","pinyin":"Wǒmen qù chīfàn ba.","vi":"Chúng ta đi ăn cơm đi.","wordIds":["w:我们","w:去","w:吃饭","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:151","zh":"你最好告诉他。","pinyin":"Nǐ zuìhǎo gàosu tā.","vi":"Tốt nhất bạn nên nói cho anh ấy biết.","wordIds":["w:你","w:最好","w:告诉","w:他"],"unitId":"l1-u34"},{"id":"s:l1:214","zh":"你们都坐下吧。","pinyin":"Nǐmen dōu zuòxia ba.","vi":"Mọi người ngồi xuống đi.","wordIds":["w:你们","w:都","w:坐下","w:吧"],"unitId":"l1-u34"},{"id":"s:l3:231","zh":"我们一边喝茶，一边说话。","pinyin":"Wǒmen yìbiān hē chá, yìbiān shuōhuà.","vi":"Chúng tôi vừa uống trà vừa trò chuyện.","wordIds":["w:我们","w:一边","w:喝","w:茶","w:一边","w:说话"],"unitId":"l1-u34"}]}
