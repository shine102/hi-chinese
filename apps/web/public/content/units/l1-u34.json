{"unit":{"id":"l1-u34","level":1,"order":34,"title":"Talking","wordIds":["w:话","w:说话","w:问","w:回答","w:告诉","w:知道","w:怎么","w:行","w:吧","w:别","w:别的","w:没事儿"],"grammarIds":["g:ba-suggestion","g:bie-prohibition","g:zenme-how"],"sentenceIds":["s:l1:029","s:l1:030","s:l1:031","s:l1:032","s:l1:049","s:l1:050","s:l1:051","s:l1:066","s:l1:119","s:l1:122","s:l1:140","s:l1:151","s:l1:214","s:l3:231"]},"grammar":[{"id":"g:ba-suggestion","title":"吧 for suggestions and requests","pattern":"Sentence + 吧","explanation":"吧 (ba) softens a sentence into a suggestion, request, or guess. 我们去吧 sounds like \"Let's go\", friendlier than a plain statement. It always comes at the very end of the sentence.","level":1,"sentenceIds":["s:l1:029","s:l1:030","s:l1:031","s:l1:032"],"unitId":"l1-u34"},{"id":"g:bie-prohibition","title":"别 for telling someone not to","pattern":"别 + verb (+ object)","explanation":"别 (bié) means \"don't\" and goes right before the verb, giving a direct instruction. Adding 了 at the end, as in 别说了, softens it to \"stop doing that\" rather than a flat prohibition.","level":1,"sentenceIds":["s:l1:065","s:l1:066","s:l1:067","s:l1:068"],"unitId":"l1-u34"},{"id":"g:zenme-how","title":"怎么 for asking \"how\"","pattern":"怎么 + verb","explanation":"怎么 (zěnme) asks about manner or method — \"how\". It goes right before the verb: 这个怎么用? (\"How do you use this?\"). 你怎么了? is a fixed way of asking \"What's wrong (with you)?\"","level":1,"sentenceIds":["s:l1:049","s:l1:050","s:l1:051","s:l1:052"],"unitId":"l1-u34"}],"sentences":[{"id":"s:l1:029","zh":"我们去吧。","pinyin":"Wǒmen qù ba.","en":"Let's go.","wordIds":["w:我们","w:去","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:030","zh":"你说吧。","pinyin":"Nǐ shuō ba.","en":"Go ahead, say it.","wordIds":["w:你","w:说","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:031","zh":"我们看吧。","pinyin":"Wǒmen kàn ba.","en":"Let's take a look.","wordIds":["w:我们","w:看","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:032","zh":"你来吧。","pinyin":"Nǐ lái ba.","en":"Come on then.","wordIds":["w:你","w:来","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:049","zh":"你怎么知道？","pinyin":"Nǐ zěnme zhīdào?","en":"How do you know?","wordIds":["w:你","w:怎么","w:知道"],"unitId":"l1-u34"},{"id":"s:l1:050","zh":"这个怎么用？","pinyin":"Zhège zěnme yòng?","en":"How do you use this?","wordIds":["w:这","w:个","w:怎么","w:用"],"unitId":"l1-u34"},{"id":"s:l1:051","zh":"他怎么走？","pinyin":"Tā zěnme zǒu?","en":"How does he go?","wordIds":["w:他","w:怎么","w:走"],"unitId":"l1-u34"},{"id":"s:l1:066","zh":"别去。","pinyin":"Bié qù.","en":"Don't go.","wordIds":["w:别","w:去"],"unitId":"l1-u34"},{"id":"s:l1:119","zh":"我们去那里吧。","pinyin":"Wǒmen qù nàlǐ ba.","en":"Let's go there.","wordIds":["w:我们","w:去","w:那里","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:122","zh":"我不知道他的名字。","pinyin":"Wǒ bù zhīdào tā de míngzi.","en":"I don't know his name.","wordIds":["w:我","w:不","w:知道","w:他","w:的","w:名字"],"unitId":"l1-u34"},{"id":"s:l1:140","zh":"我们去吃饭吧。","pinyin":"Wǒmen qù chīfàn ba.","en":"Let's go eat.","wordIds":["w:我们","w:去","w:吃饭","w:吧"],"unitId":"l1-u34"},{"id":"s:l1:151","zh":"你最好告诉他。","pinyin":"Nǐ zuìhǎo gàosu tā.","en":"You'd better tell him.","wordIds":["w:你","w:最好","w:告诉","w:他"],"unitId":"l1-u34"},{"id":"s:l1:214","zh":"你们都坐下吧。","pinyin":"Nǐmen dōu zuòxia ba.","en":"Everyone please sit down.","wordIds":["w:你们","w:都","w:坐下","w:吧"],"unitId":"l1-u34"},{"id":"s:l3:231","zh":"我们一边喝茶，一边说话。","pinyin":"Wǒmen yìbiān hē chá, yìbiān shuōhuà.","en":"We drink tea while chatting.","wordIds":["w:我们","w:一边","w:喝","w:茶","w:一边","w:说话"],"unitId":"l1-u34"}]}
